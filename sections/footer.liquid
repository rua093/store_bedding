          </div>
        </a>
        <div class="footer-social__divider"></div>
        <a href="{{ youtube_url }}" class="footer-social__item" target="_blank" rel="noopener noreferrer" title="YouTube">
          <div class="footer-social__icon">
            <img
              src="{{ 'ytb.svg' | asset_url }}"
              alt="YouTube"
