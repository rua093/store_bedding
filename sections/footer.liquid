      </div>

      <!-- 5. Copyright row -->
      <div class="footer-copyright">
        <div class="footer-copyright__rule-wrap">
          <span class="footer-copyright__line"></span>
          <div class="footer-copyright__decor" aria-hidden="true">
            <img
              src="{{ 'clover.svg' | asset_url }}"
              alt=""
              class="footer-copyright__clover"
              loading="lazy">
          </div>
          <span class="footer-copyright__line"></span>
        </div>
        <p class="footer-copyright__text">&copy; {{ 'now' | date: '%Y' }} JEMINISE. All rights reserved.</p>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Section settings override */
  .section:has(.footer-wrapper) {
    padding: 0 !important;
    border-top: none !important;
    background-color: transparent !important;
    max-width: none !important;
    width: 100% !important;
  }
  .section-background:has( + .section:has(.footer-wrapper)) {
    display: none !important;
  }

  .footer-wrapper {
    color: #2f261f;
    font-family: var(--font-primary--family), sans-serif;
    position: relative;
    margin-top: 24px;
  }

  /* Top Section (Brand + Newsletter) */
  .footer-top-section {
    background-color: #f2e5db;
    background-image: linear-gradient(180deg, #f5eae1 0%, #f2e5db 100%);
    padding: 28px 20px 32px;
    position: relative;
    overflow: hidden;
    container-type: inline-size;
  }

  .footer-top-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 0%, rgba(201, 133, 90, 0.08), transparent 38%);
    pointer-events: none;
    z-index: 1;
  }

  @media screen and (min-width: 990px) {
    .footer-top-section {
      padding: 36px 48px 40px;
    }
  }

  /* 1. Brand intro */
  .footer-brand {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 24px;
    position: relative;
    z-index: 2;
  }

  .footer-brand__decor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: fit-content;
    margin: 0 auto 12px;
    transform: none;
    position: relative;
  }
  .footer-brand__decor .decor-dot {
    width: 6px;
    height: 6px;
    background-color: #c9855a;
    border-radius: 50%;
    opacity: 0.8;
    flex: 0 0 auto;
  }
  .footer-brand__leaf {
    display: block;
    width: 40px;
    height: auto;
    object-fit: contain;
    opacity: 1;
  }

  .decor-leaf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #c9855a;
  }

  .footer-brand__logo {
    margin: 0 auto 12px;
    display: flex;
    justify-content: center;
    max-width: 195px;
    transform: translateX(7px);
  }
  @media screen and (min-width: 990px) {
    .footer-brand__logo {
      max-width: 270px;
    }
  }
  .footer-brand__logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .footer-brand__tagline {
    font-family: var(--font-primary--family), serif;
    font-size: clamp(1.05rem, 1.5vw, 1.1rem);
    line-height: 1.5;
    color: #8a7566;
    margin: 0;
    max-width: 600px;
    margin-inline: auto;
  }

  @media screen and (max-width: 749px) {
    .footer-brand__decor {
      gap: 10px;
    }

    .footer-brand__leaf {
      width: 32px;
    }
  }

  /* 2. Newsletter card */
  .footer-newsletter {
    --footer-newsletter-content-width: 720px;
    background-color: #ffffff;
    border: 1px solid rgba(201, 133, 90, 0.12);
    border-radius: 30px;
    box-shadow: 0 18px 50px rgba(47, 38, 31, 0.07);
    max-width: 940px;
    margin: 0 auto;
    padding: 20px 22px;
    display: grid;
    grid-template-columns: minmax(0, min(100%, var(--footer-newsletter-content-width)));
    justify-content: center;
    justify-items: stretch;
    gap: 16px;
    position: relative;
    z-index: 3;
  }

  @media screen and (min-width: 990px) {
    .footer-newsletter {
      --footer-newsletter-content-width: 100%;
      padding: 24px 36px;
      border-radius: 34px;
      grid-template-columns: max-content minmax(360px, 440px);
      align-items: center;
      justify-content: center;
      gap: 28px;
    }
  }

  .footer-newsletter__left {
    display: flex;
    align-items: center;
    gap: 16px;
    text-align: left;
    grid-column: 1;
    min-width: 0;
  }

  .footer-icon {
    display: block;
    object-fit: contain;
  }

  .footer-icon--newsletter {
    width: 60px;
    height: 60px;
  }

  .footer-newsletter__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background-color: #f4eae1;
    border: 1px solid rgba(201, 133, 90, 0.1);
    border-radius: 50%;
    flex-shrink: 0;
    color: #8a7566;
  }
  .footer-newsletter__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-newsletter__title {
    font-family: var(--font-primary--family), serif;
    font-size: clamp(1.2rem, 2vw, 1.35rem);
    font-weight: 500;
    margin: 0;
    color: #2f261f;
    line-height: 1.25;
  }
  .footer-newsletter__subtitle {
    font-size: 0.92rem;
    color: #8a7566;
    margin: 0;
    line-height: 1.4;
  }

  .footer-newsletter__right {
    flex: 1;
    grid-column: 1;
    justify-self: stretch;
    max-width: 100%;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .footer-newsletter__left {
      grid-column: 1;
    }

    .footer-newsletter__right {
      grid-column: 2;
      justify-self: stretch;
      max-width: 440px;
    }
  }

  .footer-newsletter__form {
    width: 100%;
    margin: 0;
  }

  .footer-newsletter__input-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    background-color: #fffaf4;
    border: 1px solid #e4d3c4;
    border-radius: 50px;
    padding: 4px 4px 4px 18px;
    transition: border-color 0.3s, box-shadow 0.3s;
    width: 100%;
    box-sizing: border-box;
  }
  .footer-newsletter__input-group:focus-within {
    border-color: #c9855a;
    box-shadow: 0 0 0 2px rgba(201, 133, 90, 0.1);
  }

  .footer-newsletter__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 0.95rem;
    color: #2f261f;
    outline: none;
    min-width: 0;
    padding: 8px 0;
  }
  .footer-newsletter__input::placeholder {
    color: #8a7566;
    opacity: 0.7;
  }

  .footer-newsletter__submit {
    background-color: #c9855a;
    color: #fffaf4;
    border: none;
    border-radius: 50px;
    padding: 10px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s;
    min-width: max-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .footer-newsletter__submit:hover {
    background-color: #b3734a;
  }

  @container (max-width: 560px) {
    .footer-newsletter__left {
      align-items: flex-start;
    }

    .footer-newsletter__right {
      grid-column: 1;
    }

    .footer-newsletter__input-group {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 8px;
      border-radius: 22px;
    }

    .footer-newsletter__input {
      width: 100%;
      min-height: 42px;
      padding: 0 12px;
      text-align: left;
    }

    .footer-newsletter__submit {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      padding: 10px 16px;
    }
  }

  @container (max-width: 400px) {
    .footer-newsletter {
      padding: 18px 16px;
      border-radius: 24px;
    }

    .footer-newsletter__left {
      gap: 12px;
    }

    .footer-newsletter__icon,
    .footer-icon--newsletter {
      width: 52px;
      height: 52px;
    }
  }

  /* 3. Navigation/contact band */
  .footer-info-wrapper {
    background-color: #faf6f2;
    border-top: 1px solid #e4d3c4;
    padding: 36px 20px;
    position: relative;
    z-index: 2;
  }

  @media screen and (min-width: 990px) {
    .footer-info-wrapper {
      padding: 48px 48px 46px;
    }
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1360px;
    margin: 0 auto;
  }

  @media screen and (min-width: 768px) {
    .footer-info {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
    }
    .footer-info__col {
      flex: 1 1 calc(50% - 24px);
      max-width: calc(50% - 24px);
    }
  }

  @media screen and (min-width: 990px) {
    .footer-info {
      display: grid;
      grid-template-columns: 1.18fr auto 1fr auto 0.9fr auto 1.2fr;
      align-items: start;
      gap: 0;
    }
    .footer-info__col {
      flex: none;
      max-width: none;
    }
    .footer-info__divider {
      display: block;
      width: 1px;
      background-color: rgba(201, 133, 90, 0.22);
      height: 96px;
      margin: 0 24px;
      align-self: center;
      position: relative;
    }
    .footer-info__divider::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 6px;
      height: 6px;
      background-color: #c9855a;
      border-radius: 50%;
    }
  }

  @media screen and (max-width: 989px) {
    .footer-info__divider {
      display: none;
    }
  }

  .footer-info__col {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    text-align: left;
  }

  .footer-info__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #f4eae1;
    border: 1px solid rgba(201, 133, 90, 0.12);
    box-shadow: 0 4px 10px rgba(47, 38, 31, 0.02);
    color: #6f5f52;
    flex-shrink: 0;
  }
  .footer-info__badge .footer-icon {
    width: 60px;
    height: 60px;
  }

  .footer-info__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .footer-info__title {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #2f261f;
    margin: 0;
  }

  .footer-info__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-info__list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    row-gap: 6px;
    column-gap: 8px;
  }

  .footer-info__list li {
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #6f5f52;
  }

  .footer-info__list a {
    color: #6f5f52;
    text-decoration: none;
    transition: color 0.25s;
  }

  .footer-info__list a:hover {
    color: #c9855a;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 6px;
    color: #8a7566;
    flex-shrink: 0;
  }

  .footer-amazon-contact-item {
    margin-top: 2px;
  }

  .footer-amazon-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #6f5f52;
    text-decoration: none;
    transition: color 0.25s;
  }

  .footer-amazon-contact-link:hover {
    color: #c9855a;
  }

  .footer-amazon-contact-arrow {
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .footer-amazon-contact-link:hover .footer-amazon-contact-arrow {
    transform: translate(2px, -2px);
  }

  .footer-info__dot {
    color: #c9855a;
    margin: 0 4px;
    opacity: 0.8;
  }

  .footer-divider-line {
    width: 100%;
    height: 1px;
    background: rgb(214 188 170 / 0.72);
  }

  @media screen and (max-width: 749px) {
    .footer-copyright__clover {
      width: 18px;
    }
  }

  /* Bottom Section (Socials, Copyright) */
  .footer-bottom-group {
    background: linear-gradient(180deg, #fbf8f4 0%, #f8f1ea 100%);
    padding: 20px 20px 22px;
    position: relative;
    z-index: 2;
  }

  @media screen and (min-width: 990px) {
    .footer-bottom-group {
      padding: 24px 48px 26px;
    }
  }

  /* 4. Social row */
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    max-width: 960px;
    margin-inline: auto;
  }

  @media screen and (min-width: 768px) {
    .footer-social {
      gap: 24px;
    }
  }

  .footer-social__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #6f5f52;
    transition: transform 0.3s, color 0.3s;
    min-width: 44px;
  }

  .footer-social__item:hover {
    color: #c9855a;
    transform: translateY(-2px);
  }
  .footer-social__item:hover .footer-social__icon {
    border-color: #c9855a;
    color: #c9855a;
    background-color: #fff;
  }

  .footer-social__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #e4d3c4;
    background-color: #ffffff;
    color: #6f5f52;
    transition: all 0.3s;
  }
  .footer-social__icon .footer-icon {
    width: 28px;
    height: 28px;
  }

  .footer-social__divider {
    width: 1px;
    height: 26px;
    background-color: #e4d3c4;
  }
  @media screen and (max-width: 767px) {
    .footer-social__divider {
      display: none;
    }
    .footer-social {
      gap: 16px 20px;
    }
  }

  /* 5. Copyright */
  .footer-copyright {
    text-align: center;
    max-width: 1060px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .footer-copyright__rule-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    width: 100%;
    margin-bottom: 11px;
  }

  .footer-copyright__line {
    flex: 1;
    height: 1px;
    background-color: rgba(201, 133, 90, 0.25);
  }

  .footer-copyright__decor {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-copyright__clover {
    display: block;
    width: 22px;
    height: auto;
    object-fit: contain;
  }

  .footer-copyright__text {
    font-size: 0.9rem;
    color: #8a7566;
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* Halloween footer skin
   * The body attribute is resolved once by the seasonal theme logic, keeping
   * this visual layer isolated from every non-Halloween storefront page.
   */
  body[data-seasonal-theme='halloween'] .footer-wrapper {
    --footer-halloween-night: #1d121b;
    --footer-halloween-surface: #2a1923;
    --footer-halloween-surface-soft: #35202a;
    --footer-halloween-ink: #f8ead4;
    --footer-halloween-muted: #c9b69c;
    --footer-halloween-ember: #f28a2a;
    --footer-halloween-ember-deep: #b93d12;
    --footer-halloween-bg-desktop: none;
    --footer-halloween-bg-mobile: var(--footer-halloween-bg-desktop);

    margin-top: 0;
    color: var(--footer-halloween-ink);
    background: var(--footer-halloween-night);
    isolation: isolate;
  }

  body[data-seasonal-theme='halloween'] .footer-top-section {
    color: var(--footer-halloween-ink);
    background-color: var(--footer-halloween-night);
    background-image:
      linear-gradient(90deg, rgb(29 18 27 / 0.38), rgb(42 22 31 / 0.22) 48%, rgb(29 18 27 / 0.34)),
      radial-gradient(circle at 7% 74%, rgb(242 138 42 / 0.2), transparent 18%),
      radial-gradient(circle at 94% 70%, rgb(242 138 42 / 0.16), transparent 19%),
      var(--footer-halloween-bg-desktop),
      linear-gradient(155deg, #321f29 0%, #1d121b 58%, #29171f 100%);
    background-position: center, center, center, center, center;
    background-repeat: no-repeat;
    background-size: cover, auto, auto, cover, cover;
    border-top: 1px solid rgb(242 138 42 / 0.5);
    padding-block: 30px;
  }

  body[data-seasonal-theme='halloween'] .footer-top-section::before {
    background:
      radial-gradient(circle at 24% 10%, rgb(242 138 42 / 0.09), transparent 24%),
      linear-gradient(90deg, transparent, rgb(242 138 42 / 0.08), transparent);
    opacity: 1;
  }

  body[data-seasonal-theme='halloween'] .footer-brand__decor .decor-dot {
    background-color: var(--footer-halloween-ember);
    box-shadow: 0 0 10px rgb(242 138 42 / 0.7);
  }

  body[data-seasonal-theme='halloween'] .footer-brand__decor {
    display: none;
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-brand__leaf, .footer-copyright__clover) {
    filter: brightness(0) saturate(100%) invert(62%) sepia(83%) saturate(1790%) hue-rotate(338deg) brightness(101%);
  }

  body[data-seasonal-theme='halloween'] .footer-brand__logo img {
    filter:
      brightness(0) saturate(100%) invert(92%) sepia(15%) saturate(623%) hue-rotate(345deg) brightness(105%)
      drop-shadow(0 5px 12px rgb(0 0 0 / 0.34));
  }

  body[data-seasonal-theme='halloween'] .footer-brand__logo {
    width: min(100%, 210px);
    max-width: 210px;
    margin: 0 auto;
    transform: rotate(-1.15deg);
    transform-origin: 50% 70%;
    animation: halloween-footer-logo-breathe 8s ease-in-out infinite;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter {
    color: var(--footer-halloween-ink);
    background:
      radial-gradient(circle at 100% 0, rgb(242 138 42 / 0.17), transparent 28%),
      linear-gradient(145deg, rgb(53 31 42 / 0.97), rgb(31 19 29 / 0.97));
    border: 1px solid rgb(242 138 42 / 0.38);
    border-radius: 26px 18px 29px 20px / 19px 28px 18px 27px;
    box-shadow:
      0 16px 36px rgb(0 0 0 / 0.24),
      0 0 22px rgb(185 61 18 / 0.06);
    padding: 18px 22px;
    transform: rotate(0.18deg);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter::before {
    content: '';
    position: absolute;
    inset: -5px -4px -4px -6px;
    z-index: -1;
    border: 1px solid rgb(242 138 42 / 0.3);
    border-radius: 29px 21px 25px 24px / 24px 23px 28px 20px;
    box-shadow:
      13px -6px 24px rgb(242 138 42 / 0.04),
      -9px 10px 22px rgb(78 24 45 / 0.12);
    transform: rotate(-0.38deg);
    pointer-events: none;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: 5%;
    bottom: -13px;
    width: 46%;
    height: 20px;
    background:
      radial-gradient(ellipse at 12% 0, rgb(24 15 28 / 0.9) 0 25%, transparent 28%),
      radial-gradient(ellipse at 39% 0, rgb(24 15 28 / 0.76) 0 34%, transparent 37%),
      radial-gradient(ellipse at 68% 0, rgb(24 15 28 / 0.82) 0 22%, transparent 25%),
      radial-gradient(ellipse at 91% 0, rgb(24 15 28 / 0.7) 0 30%, transparent 33%);
    filter: blur(0.4px);
    opacity: 0.75;
    pointer-events: none;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__icon {
    color: var(--footer-halloween-ember);
    background: #120d18;
    border-color: rgb(242 138 42 / 0.46);
    box-shadow:
      0 0 0 3px rgb(242 138 42 / 0.08),
      0 0 18px rgb(242 138 42 / 0.12);
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-newsletter__icon, .footer-icon--newsletter) {
    width: 52px;
    height: 52px;
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-icon--newsletter, .footer-info__badge .footer-icon) {
    filter: brightness(0) saturate(100%) invert(62%) sepia(83%) saturate(1790%) hue-rotate(338deg) brightness(101%);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__title,
  body[data-seasonal-theme='halloween'] .footer-info__title {
    color: var(--footer-halloween-ink);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__title {
    text-shadow: 0 0 18px rgb(242 138 42 / 0.16);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__subtitle {
    color: var(--footer-halloween-muted);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__input-group {
    background: rgb(8 7 13 / 0.88);
    border-color: rgb(242 138 42 / 0.36);
    box-shadow:
      0 8px 22px rgb(0 0 0 / 0.18) inset,
      0 1px 0 rgb(255 255 255 / 0.03);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__input-group:focus-within {
    border-color: var(--footer-halloween-ember);
    box-shadow:
      0 0 0 2px rgb(242 138 42 / 0.15),
      0 0 20px rgb(242 138 42 / 0.12);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__input {
    color: var(--footer-halloween-ink);
    background: transparent !important;
    color-scheme: dark;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__input::placeholder {
    color: var(--footer-halloween-muted);
    opacity: 0.72;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__submit {
    color: #fff3df;
    background: linear-gradient(180deg, #f49a32, #c64a12);
    border: 1px solid rgb(255 211 137 / 0.32);
    box-shadow:
      0 7px 18px rgb(105 30 7 / 0.34),
      0 1px 0 rgb(255 255 255 / 0.26) inset;
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__submit:hover {
    background: linear-gradient(180deg, #ffad45, #d75a18);
    box-shadow:
      0 9px 24px rgb(105 30 7 / 0.42),
      0 0 16px rgb(242 138 42 / 0.2);
  }

  body[data-seasonal-theme='halloween'] .footer-newsletter__input:-webkit-autofill,
  body[data-seasonal-theme='halloween'] .footer-newsletter__input:-webkit-autofill:hover,
  body[data-seasonal-theme='halloween'] .footer-newsletter__input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--footer-halloween-ink);
    -webkit-box-shadow: 0 0 0 1000px #0b0912 inset;
    transition: background-color 9999s ease-out;
  }

  @media screen and (min-width: 990px) {
    body[data-seasonal-theme='halloween'] .footer-top-section {
      display: grid;
      grid-template-columns: minmax(190px, 250px) minmax(540px, 860px);
      align-items: center;
      justify-content: center;
      column-gap: clamp(36px, 5vw, 84px);
      padding: 34px 48px;
    }

    body[data-seasonal-theme='halloween'] .footer-brand {
      width: 100%;
      max-width: 250px;
      margin: 0;
      justify-self: center;
    }

    body[data-seasonal-theme='halloween'] .footer-newsletter {
      width: 100%;
      max-width: 860px;
      margin: 0;
      grid-template-columns: minmax(235px, max-content) minmax(280px, 1fr);
      justify-content: stretch;
      gap: 22px;
    }

    body[data-seasonal-theme='halloween'] .footer-newsletter__right {
      max-width: none;
    }
  }

  @media screen and (max-width: 749px) {
    body[data-seasonal-theme='halloween'] .footer-top-section {
      background-image:
        linear-gradient(180deg, rgb(11 9 18 / 0.72), rgb(17 10 20 / 0.6) 48%, rgb(11 9 18 / 0.78)),
        radial-gradient(circle at 30% 16%, rgb(242 138 42 / 0.13), transparent 25%),
        radial-gradient(circle at 84% 88%, rgb(86 32 44 / 0.17), transparent 28%),
        var(--footer-halloween-bg-mobile),
        linear-gradient(155deg, #15101c 0%, #0b0912 58%, #120b12 100%);
      background-position: center, center, center, center, center;
    }
  }

  @keyframes halloween-footer-logo-breathe {
    0%,
    100% {
      filter: drop-shadow(0 0 0 rgb(242 138 42 / 0));
      transform: rotate(-1.15deg) translateY(0);
    }

    50% {
      filter: drop-shadow(0 0 18px rgb(242 138 42 / 0.16));
      transform: rotate(-0.72deg) translateY(-2px);
    }
  }

  @keyframes halloween-footer-fog-drift {
    0%,
    100% {
      opacity: 0.34;
      transform: translate3d(-2%, 0, 0) scale(1);
    }

    50% {
      opacity: 0.5;
      transform: translate3d(3%, -5px, 0) scale(1.06);
    }
  }

  body[data-seasonal-theme='halloween'] .footer-info-wrapper {
    color: var(--footer-halloween-ink);
    background:
      radial-gradient(circle at 12% 20%, rgb(242 138 42 / 0.07), transparent 26%),
      radial-gradient(circle at 88% 78%, rgb(88 34 55 / 0.14), transparent 28%),
      linear-gradient(180deg, #120d18, #0c0912);
    border-top-color: rgb(242 138 42 / 0.26);
  }

  body[data-seasonal-theme='halloween'] .footer-info-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: min(86%, 1360px);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, var(--footer-halloween-ember), transparent);
    box-shadow: 0 0 12px rgb(242 138 42 / 0.28);
  }

  body[data-seasonal-theme='halloween'] .footer-info-wrapper::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 8% -8% 0;
    background:
      radial-gradient(ellipse at 12% 70%, rgb(123 60 82 / 0.2), transparent 24%),
      radial-gradient(ellipse at 38% 20%, rgb(242 138 42 / 0.09), transparent 19%),
      radial-gradient(ellipse at 68% 76%, rgb(102 49 76 / 0.2), transparent 25%),
      radial-gradient(ellipse at 94% 24%, rgb(242 138 42 / 0.07), transparent 18%);
    filter: blur(25px);
    animation: halloween-footer-fog-drift 15s ease-in-out infinite;
    pointer-events: none;
  }

  body[data-seasonal-theme='halloween'] .footer-info {
    position: relative;
    z-index: 1;
  }

  @media screen and (min-width: 990px) {
    body[data-seasonal-theme='halloween'] .footer-info {
      align-items: stretch;
    }

    body[data-seasonal-theme='halloween'] .footer-info__col {
      position: relative;
      min-height: 145px;
      height: 100%;
      padding: 20px 18px;
      background:
        radial-gradient(circle at 100% 0, rgb(242 138 42 / 0.07), transparent 28%),
        linear-gradient(145deg, rgb(35 21 35 / 0.58), rgb(10 8 14 / 0.34));
      border: 1px solid rgb(242 138 42 / 0.13);
      border-radius: 22px 14px 25px 17px / 16px 25px 15px 23px;
      box-shadow:
        0 14px 30px rgb(0 0 0 / 0.12),
        0 0 24px rgb(86 30 55 / 0.05) inset;
    }

    body[data-seasonal-theme='halloween'] .footer-info__col::before {
      content: '';
      position: absolute;
      top: -2px;
      right: -2px;
      width: 44px;
      height: 44px;
      border-top: 1px solid rgb(242 138 42 / 0.38);
      border-right: 1px solid rgb(242 138 42 / 0.38);
      border-start-end-radius: 20px;
      box-shadow: 7px -7px 18px rgb(242 138 42 / 0.06);
      transform: rotate(2deg);
      pointer-events: none;
    }

    body[data-seasonal-theme='halloween'] .footer-info__divider {
      height: 100%;
      min-height: 124px;
      transform: none;
    }
  }

  body[data-seasonal-theme='halloween'] .footer-info__badge {
    color: var(--footer-halloween-ember);
    background: linear-gradient(145deg, #211522, #0d0a12);
    border-color: rgb(242 138 42 / 0.38);
    box-shadow:
      0 0 0 3px rgb(242 138 42 / 0.05),
      0 9px 22px rgb(0 0 0 / 0.22);
  }

  body[data-seasonal-theme='halloween'] .footer-info__title {
    color: var(--footer-halloween-ember);
    text-shadow: 0 0 12px rgb(242 138 42 / 0.15);
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-info__list li, .footer-info__list a, .footer-amazon-contact-link) {
    color: var(--footer-halloween-muted);
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-info__list a, .footer-amazon-contact-link):hover {
    color: var(--footer-halloween-ember);
    text-shadow: 0 0 12px rgb(242 138 42 / 0.18);
  }

  body[data-seasonal-theme='halloween']
    :is(.contact-icon, .footer-info__dot) {
    color: var(--footer-halloween-ember);
  }

  body[data-seasonal-theme='halloween'] .footer-info__divider {
    background: linear-gradient(180deg, transparent, rgb(242 138 42 / 0.42), transparent);
  }

  body[data-seasonal-theme='halloween'] .footer-info__divider::after {
    background-color: var(--footer-halloween-ember);
    box-shadow: 0 0 10px rgb(242 138 42 / 0.6);
  }

  body[data-seasonal-theme='halloween'] .footer-divider-line {
    background: linear-gradient(90deg, transparent, rgb(242 138 42 / 0.48), transparent);
  }

  body[data-seasonal-theme='halloween'] .footer-bottom-group {
    color: var(--footer-halloween-ink);
    background:
      radial-gradient(circle at 50% 0, rgb(242 138 42 / 0.08), transparent 34%),
      linear-gradient(180deg, #0c0912, #08070d);
    overflow: hidden;
  }

  body[data-seasonal-theme='halloween'] .footer-bottom-group::before {
    content: '';
    position: absolute;
    z-index: 0;
    left: -8%;
    bottom: -55%;
    width: 58%;
    height: 150%;
    border: 1px solid rgb(248 234 212 / 0.045);
    border-radius: 50%;
    box-shadow:
      42px -20px 0 rgb(248 234 212 / 0.028),
      84px -38px 0 rgb(248 234 212 / 0.02);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  body[data-seasonal-theme='halloween']
    :is(.footer-social, .footer-copyright) {
    position: relative;
    z-index: 1;
  }

  body[data-seasonal-theme='halloween'] .footer-social__item {
    color: var(--footer-halloween-muted);
  }

  body[data-seasonal-theme='halloween'] .footer-social__icon {
    color: var(--footer-halloween-ember);
    background: linear-gradient(145deg, #211522, #0c0911);
    border-color: rgb(242 138 42 / 0.36);
    box-shadow: 0 7px 16px rgb(0 0 0 / 0.2);
  }

  body[data-seasonal-theme='halloween'] .footer-social__icon .footer-icon {
    filter: brightness(0) saturate(100%) invert(62%) sepia(83%) saturate(1790%) hue-rotate(338deg) brightness(101%);
  }

  body[data-seasonal-theme='halloween'] .footer-social__item:hover .footer-social__icon {
    color: #ffd391;
    background: #25151e;
    border-color: var(--footer-halloween-ember);
    box-shadow:
      0 8px 20px rgb(0 0 0 / 0.28),
      0 0 18px rgb(242 138 42 / 0.3);
  }

  body[data-seasonal-theme='halloween'] .footer-social__item:nth-of-type(4n + 1) {
    transform: rotate(-2deg) translateY(1px);
  }

  body[data-seasonal-theme='halloween'] .footer-social__item:nth-of-type(4n + 3) {
    transform: rotate(2deg) translateY(-2px);
  }

  body[data-seasonal-theme='halloween'] .footer-social__item:nth-of-type(4n + 1):hover,
  body[data-seasonal-theme='halloween'] .footer-social__item:nth-of-type(4n + 3):hover {
    transform: rotate(0) translateY(-4px);
  }

  body[data-seasonal-theme='halloween'] .footer-social__divider {
    background: linear-gradient(180deg, transparent, rgb(242 138 42 / 0.42), transparent);
  }

  body[data-seasonal-theme='halloween'] .footer-copyright__line {
    background: linear-gradient(90deg, transparent, rgb(242 138 42 / 0.38));
  }

  body[data-seasonal-theme='halloween'] .footer-copyright__line:last-child {
    background: linear-gradient(90deg, rgb(242 138 42 / 0.38), transparent);
  }

  body[data-seasonal-theme='halloween'] .footer-copyright__text {
    color: var(--footer-halloween-muted);
  }

  @media screen and (max-width: 767px) {
    body[data-seasonal-theme='halloween'] .footer-info__col {
      padding: 16px;
      background: rgb(30 19 31 / 0.54);
      border: 1px solid rgb(242 138 42 / 0.14);
      border-radius: 18px 13px 20px 15px / 14px 20px 15px 19px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    body[data-seasonal-theme='halloween'] .footer-brand__logo,
    body[data-seasonal-theme='halloween'] .footer-info-wrapper::after {
      animation: none;
    }

    body[data-seasonal-theme='halloween']
      :is(.footer-newsletter__submit, .footer-social__item, .footer-social__icon, .footer-info__list a) {
      transition: none;
    }
  }
{% endstylesheet %}

