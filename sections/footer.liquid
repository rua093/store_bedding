        <a href="{{ facebook_url }}" class="footer-social__item" target="_blank" rel="noopener noreferrer" title="Facebook">
          <div class="footer-social__icon">
            <img
              src="{{ 'fb.svg' | asset_url }}"
              alt="Facebook"
              class="footer-icon footer-icon--social"
              loading="lazy">
          </div>
        </a>
        <div class="footer-social__divider"></div>
        <a href="{{ pinterest_url }}" class="footer-social__item" target="_blank" rel="noopener noreferrer" title="Pinterest">
          <div class="footer-social__icon">
            <img
              src="{{ 'pinterest.svg' | asset_url }}"
              alt="Pinterest"
              class="footer-icon footer-icon--social"
              loading="lazy">
          </div>
        </a>
        <div class="footer-social__divider"></div>
        <a href="{{ tiktok_url }}" class="footer-social__item" target="_blank" rel="noopener noreferrer" title="TikTok">
          <div class="footer-social__icon">
            <img
              src="{{ 'tiktok.svg' | asset_url }}"
              alt="TikTok"
