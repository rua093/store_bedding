{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign instagram_url = 'https://www.instagram.com/jeminisebedding/'
  assign facebook_url = 'https://www.facebook.com/profile.php?id=61591443914131'
  assign pinterest_url = 'https://www.pinterest.com/bedding779/'
  assign tiktok_url = 'https://www.tiktok.com/@jeminisebedding'
  assign youtube_url = 'https://www.youtube.com/@Jeminise'
  assign footer_logo = settings.logo | default: settings.logo_inverse

  comment
    Seasonal footer artwork is owned by the collection. On product pages,
    inherit it from the first Halloween collection so the seasonal experience
    remains consistent when a customer opens a product from that collection.
  endcomment
  assign footer_artwork_collection = collection
  if footer_artwork_collection == blank and product != blank
    for product_collection in product.collections
      assign product_collection_theme = product_collection.metafields.custom.seasonal_theme.value | downcase | strip
      if product_collection_theme == 'halloween' or product_collection.handle contains 'halloween'
        assign footer_artwork_collection = product_collection
        break
      endif
    endfor
  endif

  assign footer_bg_desktop = footer_artwork_collection.metafields.custom.footer_bg_desktop.value
  assign footer_bg_mobile = footer_artwork_collection.metafields.custom.footer_bg_mobile.value

  comment
    Either artwork can act as the fallback for the other breakpoint. When both
    are empty, the CSS-only Halloween background remains in place.
  endcomment
  if footer_bg_desktop == blank
    assign footer_bg_desktop = footer_bg_mobile
  endif
  if footer_bg_mobile == blank
    assign footer_bg_mobile = footer_bg_desktop
  endif

  assign has_instagram_url = false
  if instagram_url != blank and instagram_url != '#' and instagram_url contains 'instagram.com'
    assign has_instagram_url = true
  endif
%}

{% if footer_bg_desktop != blank %}
  {% style %}
    #shopify-section-{{ section.id }} .footer-wrapper {
      --footer-halloween-bg-desktop: url('{{ footer_bg_desktop | image_url: width: 3840 }}');
      --footer-halloween-bg-mobile: url('{{ footer_bg_mobile | image_url: width: 1600 }}');
    }
  {% endstyle %}
{% endif %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section section--{{ section.settings.section_width | default: 'page-width' }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div class="footer-wrapper">
    <!-- Top Group: Brand Hero & Newsletter Card -->
    <div class="footer-top-section">
      <!-- Seasonal Halloween Footer Ornaments -->
      <style>
        .footer-top-section {
          position: relative !important;
        }
        .footer-halloween-decorations {
          display: none !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decorations {
          display: block !important;
          position: absolute !important;
          inset: 0 !important;
          pointer-events: none !important;
          overflow: hidden !important;
          z-index: 5 !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor {
          position: absolute !important;
          pointer-events: none !important;
          user-select: none !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor img {
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
          height: auto !important;
          object-fit: contain !important;
          filter: brightness(1.16) saturate(1.08) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--web-topleft {
          top: 0 !important;
          left: 0 !important;
          width: clamp(75px, 7vw, 110px) !important;
          opacity: 0.75 !important;
          filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.25)) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--web-topleft img {
          width: clamp(75px, 7vw, 110px) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--witch {
          top: 10px !important;
          right: 20px !important;
          width: clamp(60px, 6vw, 90px) !important;
          opacity: 0.88 !important;
          filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.35)) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--witch img {
          width: clamp(60px, 6vw, 90px) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--cat {
          bottom: 8px !important;
          left: 18px !important;
          width: clamp(80px, 8vw, 120px) !important;
          opacity: 0.95 !important;
          isolation: isolate !important;
          filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45)) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--cat::before {
          content: '' !important;
          position: absolute !important;
          inset: -24% -34% -18% !important;
          z-index: -1 !important;
          border-radius: 50% !important;
          background: radial-gradient(
            circle,
            rgba(255, 202, 117, 0.34) 0%,
            rgba(242, 138, 42, 0.2) 38%,
            rgba(242, 138, 42, 0.07) 58%,
            transparent 74%
          ) !important;
          filter: blur(5px) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--cat img {
          width: clamp(80px, 8vw, 120px) !important;
          filter:
            brightness(1.34)
            contrast(1.06)
            saturate(1.12)
            drop-shadow(0 0 7px rgba(255, 183, 84, 0.24)) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--lantern {
          bottom: 8px !important;
          right: 18px !important;
          width: clamp(70px, 7vw, 105px) !important;
          opacity: 0.95 !important;
          filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.45)) !important;
        }
        body[data-seasonal-theme='halloween'] .footer-halloween-decor--lantern img {
          width: clamp(70px, 7vw, 105px) !important;
        }
        @media screen and (max-width: 749px) {
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--web-topleft,
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--witch {
            display: none !important;
          }
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--cat,
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--cat img {
            bottom: 6px !important;
            left: 8px !important;
            width: 62px !important;
            opacity: 0.85 !important;
          }
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--lantern,
          body[data-seasonal-theme='halloween'] .footer-halloween-decor--lantern img {
            bottom: 6px !important;
            right: 8px !important;
            width: 58px !important;
            opacity: 0.85 !important;
          }
        }
      </style>
      <div class="footer-halloween-decorations" aria-hidden="true">
        <div class="footer-halloween-decor footer-halloween-decor--web-topleft">
          <img
            src="{{ '02_spiderweb_corner.svg' | asset_url }}"
            alt=""
            width="122"
            height="125"
            loading="lazy"
          >
        </div>
        <div class="footer-halloween-decor footer-halloween-decor--witch">
          <img
            src="{{ '06_witch_hat_and_broom.svg' | asset_url }}"
            alt=""
            width="121"
            height="124"
            loading="lazy"
          >
        </div>
        <div class="footer-halloween-decor footer-halloween-decor--cat">
          <img
            src="{{ '04_black_cat_and_pumpkin.svg' | asset_url }}"
            alt=""
            width="110"
            height="119"
            loading="lazy"
          >
        </div>
        <div class="footer-halloween-decor footer-halloween-decor--lantern">
          <img
            src="{{ '05_candlelit_lantern.svg' | asset_url }}"
            alt=""
            width="116"
            height="125"
            loading="lazy"
          >
        </div>
      </div>
      <!-- 1. Brand intro center -->
      <div class="footer-brand">
        <div class="footer-brand__decor">
          <span class="decor-dot"></span>
          <span class="decor-leaf">
            <img
              src="{{ 'leaf.svg' | asset_url }}"
              alt=""
              class="footer-brand__leaf"
              loading="lazy">
          </span>
          <span class="decor-dot"></span>
        </div>
        <div class="footer-brand__logo">
          {% if footer_logo != blank %}
            {{
              footer_logo
              | image_url: width: 560
              | image_tag:
                alt: shop.name,
                widths: '280, 420, 560',
                sizes: '280px',
                loading: 'lazy'
            }}
          {% else %}
            <img
              src="{{ 'logo_inverse.webp' | asset_url }}"
              alt="JEMINISE"
              width="280"
              height="auto"
              loading="lazy">
          {% endif %}
        </div>
      </div>

      <!-- 2. Newsletter card center -->
      <div class="footer-newsletter">
        <div class="footer-newsletter__left">
          <div class="footer-newsletter__icon">
            <img
              src="{{ 'mail.svg' | asset_url }}"
              alt=""
              class="footer-icon footer-icon--newsletter"
              loading="lazy">
          </div>
          <div class="footer-newsletter__text">
            <h3 class="footer-newsletter__title">Stay in the loop</h3>
            <p class="footer-newsletter__subtitle">New arrivals, cozy ideas, and exclusive offers.</p>
          </div>
        </div>
        <div class="footer-newsletter__right">
          {% form 'customer', class: 'footer-newsletter__form' %}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter">
            <div class="footer-newsletter__input-group">
              <input
                type="email"
                name="contact[email]"
                class="footer-newsletter__input"
                placeholder="Email address"
                autocorrect="off"
                autocapitalize="off"
                required>
              <button type="submit" class="footer-newsletter__submit">Subscribe &rarr;</button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>

    <!-- Tầng 3: Main info band -->
    <div class="footer-info-wrapper">
      <div class="footer-info">
        <!-- Column 1: Contact -->
        <div class="footer-info__col">
          <div class="footer-info__badge">
            <img
              src="{{ 'mail.svg' | asset_url }}"
