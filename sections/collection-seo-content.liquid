{% liquid
  assign seo_meta_sections = collection.metafields.custom.seo_content.value
  assign has_meta_content = false
  if seo_meta_sections != blank and seo_meta_sections.count > 0
    assign has_meta_content = true
  elsif seo_meta_sections != blank and seo_meta_sections.size > 0
    assign has_meta_content = true
  endif

  assign has_block_content = false
  if section.blocks.size > 0
    assign has_block_content = true
  endif

  assign has_content = false
  if has_meta_content or has_block_content
    assign has_content = true
  endif
%}

{% if has_content %}
  {{ 'collection-seo.css' | asset_url | stylesheet_tag }}

  <section
    id="CollectionSeoContent-{{ section.id }}"
    class="collection-seo-content"
    aria-label="{{ section.settings.section_title | default: 'Collection Guide & Information' | escape }}"
  >
    <div class="collection-seo-content__inner">
      {% if section.settings.show_section_header and section.settings.section_title != blank %}
        <div class="collection-seo-content__header">
          <h2 class="collection-seo-content__main-title">{{ section.settings.section_title | escape }}</h2>
        </div>
      {% endif %}

      <div class="collection-seo-content__items">
        {% if has_meta_content %}
          {% for item in seo_meta_sections %}
            {% liquid
              assign item_heading = item.heading.value | default: item.heading
              assign item_body = item.body
              assign item_image = item.image.value | default: item.image
              assign item_image_alt = item.image_alt.value | default: item.image_alt | default: item_heading
              assign item_kind = item.kind.value | default: item.kind
            %}
            {% if item_heading != blank or item_body != blank %}
              <article class="collection-seo-item{% if item_kind != blank %} collection-seo-item--{{ item_kind | handle }}{% endif %}">
                <div class="collection-seo-item__layout{% if item_image != blank %} collection-seo-item__layout--with-image{% endif %}">
                  <div class="collection-seo-item__content">
                    {% if item_heading != blank %}
                      <h2 class="collection-seo-item__heading">{{ item_heading | escape }}</h2>
                    {% endif %}
                    {% if item_body != blank %}
                      <div class="collection-seo-item__body rte">
                        {{ item_body | metafield_tag }}
                      </div>
                    {% endif %}
                  </div>
                  {% if item_image != blank %}
                    <div class="collection-seo-item__media">
                      {{
                        item_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          decoding: 'async',
                          alt: item_image_alt,
                          class: 'collection-seo-item__image'
                      }}
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% elsif has_block_content %}
          {% for block in section.blocks %}
            {% if block.settings.heading != blank or block.settings.body != blank %}
              <article class="collection-seo-item" {{ block.shopify_attributes }}>
                <div class="collection-seo-item__layout{% if block.settings.image != blank %} collection-seo-item__layout--with-image{% endif %}">
                  <div class="collection-seo-item__content">
                    {% if block.settings.heading != blank %}
                      <h2 class="collection-seo-item__heading">{{ block.settings.heading | escape }}</h2>
                    {% endif %}
                    {% if block.settings.body != blank %}
                      <div class="collection-seo-item__body rte">
                        {{ block.settings.body }}
                      </div>
                    {% endif %}
                  </div>
                  {% if block.settings.image != blank %}
                    <div class="collection-seo-item__media">
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          decoding: 'async',
                          alt: block.settings.heading,
                          class: 'collection-seo-item__image'
                      }}
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="collection-seo-content collection-seo-content--placeholder" style="padding: 24px; text-align: center; background: #FAF8F5; border: 1px dashed #C9855A; margin: 16px;">
    <p style="font-family: 'Work Sans', sans-serif; color: #71655E; margin: 0;">
      <strong>Collection SEO Content:</strong> Chưa có dữ liệu metafield hoặc block cho collection này. Thêm blocks bên dưới hoặc gán metafield <code>custom.seo_content</code> để hiển thị.
    </p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Collection SEO Content",
  "tag": "section",
  "class": "section-collection-seo-content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section_header",
      "label": "Show Section Header",
      "default": false
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title (Optional)"
    }
  ],
  "blocks": [
    {
      "type": "seo_section",
      "name": "SEO Content Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (H2)",
          "default": "About This Collection"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Content Body",
          "default": "<p>Add in-depth details about materials, sizing, personalization options, and care instructions to help shoppers make an informed choice.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Section Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection SEO Content"
    }
  ]
}
{% endschema %}
