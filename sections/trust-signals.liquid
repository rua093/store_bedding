{{ 'trust-signals.css' | asset_url | stylesheet_tag }}

{% liquid
  assign is_trust_signals_hero = false
  assign first_trust_text = section.blocks.first.settings.text | default: ''
  if section.id == 'trust_signals_P6hero' or section.id contains 'trust_signals_P6hero' or first_trust_text contains 'Soft Comfort'
    assign is_trust_signals_hero = true
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<section
  class="trust-signals section-wrapper{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if is_trust_signals_hero %} trust-signals--hero{% endif %}"
  style="
    --trust-signals-padding-top: {{ section.settings.padding-block-start }}px;
    --trust-signals-padding-bottom: {{ section.settings.padding-block-end }}px;
    --trust-signals-gap: {{ section.settings.gap_between_items }}px;
    {%- if section.settings.background_color != blank -%}--trust-signals-background: {{ section.settings.background_color }};{%- endif -%}
  "
>
  <div class="trust-signals__page-width{% if is_trust_signals_hero %} section section--page-width{% endif %}">
    {% if is_trust_signals_hero %}
      <div class="trust-signals__hero-panel">
    {% endif %}
    <div
      class="trust-signals__inner"
      data-homepage-reveal-children="{% if is_trust_signals_hero %}.trust-signals__hero-grid{% else %}:scope > *{% endif %}"
      {% unless is_trust_signals_hero %}
        data-homepage-reveal-preset="card-cascade-reveal"
        data-homepage-reveal-base-delay="100"
        data-homepage-reveal-stagger="100"
      {% else %}
        data-homepage-reveal-preset="section-soft-reveal"
      {% endunless %}
    >
      {% if is_trust_signals_hero %}
        <h2 class="visually-hidden">Why shop with us</h2>
        <div
          class="trust-signals__hero-grid"
          data-homepage-reveal-children=":scope > *"
          data-homepage-reveal-preset="card-cascade-reveal"
          data-homepage-reveal-base-delay="100"
          data-homepage-reveal-stagger="120"
        >
          {% for block in section.blocks limit: 4 %}
            {% liquid
              assign block_html = block.settings.text | default: ''
              assign trust_title = block_html | split: '<strong>' | last | split: '</strong>' | first | strip_html | strip
              assign trust_body = block_html | split: '</strong>' | last | strip_html | strip

              if trust_title == blank
                case forloop.index
                  when 1
                    assign trust_title = 'Soft Comfort'
                  when 2
                    assign trust_title = 'Custom Care'
                  when 3
                    assign trust_title = 'Lasting Quality'
                  when 4
                    assign trust_title = 'Free Shipping'
                endcase
              endif

              if trust_body == blank
                case forloop.index
                  when 1
                    assign trust_body = 'Thoughtfully made for cozy, everyday comfort.'
                  when 2
                    assign trust_body = 'Each design is crafted to match your idea with attention to detail.'
                  when 3
                    assign trust_body = 'Carefully created to feel beautiful, durable, and gift-worthy.'
                  when 4
                    assign trust_body = 'Free shipping on every bedding order, delivered to your door.'
                endcase
              endif

              assign trust_icon_asset = ''
              case forloop.index
                when 1
                  assign trust_icon_asset = 'premium_material.webp'
                when 2
                  assign trust_icon_asset = 'breathable_coldzy.webp'
                when 3
                  assign trust_icon_asset = 'shiled.webp'
                when 4
                  assign trust_icon_asset = 'ready_shipping.webp'
              endcase
            %}
            <div class="trust-signals__hero-item trust-signals__hero-item--{{ forloop.index }}" {{ block.shopify_attributes }}>
              <div class="trust-signals__hero-icon trust-signals__hero-icon--{{ forloop.index }}" aria-hidden="true">
                <img
                  class="trust-signals__hero-icon-image"
                  src="{{ trust_icon_asset | asset_url }}"
                  alt=""
                  width="512"
                  height="512"
                  loading="lazy"
                >
              </div>
              <div class="trust-signals__hero-copy">
                <h3 class="trust-signals__hero-title">{{ trust_title }}</h3>
                <span class="trust-signals__hero-divider" aria-hidden="true"></span>
                <p class="trust-signals__hero-body">{{ trust_body }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        {% content_for 'blocks' %}
      {% endif %}
    </div>
    {% if is_trust_signals_hero %}
      <div
        class="trust-signals__hero-signoff homepage-reveal"
        data-reveal-preset="section-soft-reveal"
        style="--reveal-delay: 350ms;"
        aria-hidden="true"
      >
        <span>Jeminise — quality you can feel, comfort you can trust.</span>
      </div>
      </div>
    {% endif %}
  </div>
</section>



{% schema %}
{
  "name": "Trust signals",
  "tag": "section",
  "class": "trust-signals-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF8F5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "gap_between_items",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Trust signals",
      "category": "Text"
    }
  ]
}
{% endschema %}

