{{ 'hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign desktop_media = 'none'
  assign mobile_media = 'none'
  assign use_mobile_media = false
  assign fetch_priority = 'auto'
  assign hero_has_visual_preview = request.visual_preview_mode
  assign hero_is_auto_height = false
  assign hero_text_align = 'left'
  assign desktop_widths = '768, 1024, 1280, 1600, 1920, 2560'
  assign mobile_widths = '360, 480, 640, 800, 960'
  assign mobile_widths_array = mobile_widths | split: ', '
  assign hero_eyebrow = section.settings.eyebrow | strip
  assign hero_heading = section.settings.heading | strip
  assign hero_description = section.settings.description | strip
  assign hero_primary_label = section.settings.primary_label | strip
  assign hero_primary_link = section.settings.primary_link
  assign hero_secondary_label = section.settings.secondary_label | strip
  assign hero_secondary_link = section.settings.secondary_link
  assign hero_heading_is_editorial_default = false
  assign hero_heading_normalized = hero_heading | newline_to_br | strip_newlines | replace: '<br />', '' | replace: '<br/>', '' | replace: '<br>', '' | replace: ' ', '' | downcase
  assign hero_heading_is_custom_split = false

  if hero_heading == 'Sleep Better Every Night'
    assign hero_heading_is_editorial_default = true
  endif

  if hero_heading_normalized == 'yourideas,madecozy'
    assign hero_heading_is_custom_split = true
  endif

  if section.settings.image_1 != blank and section.settings.media_type_1 == 'image'
    assign desktop_media = 'image'
  elsif section.settings.video_1 != blank and section.settings.media_type_1 == 'video'
    assign desktop_media = 'video'
  endif

  if section.settings.custom_mobile_media
    if section.settings.image_1_mobile != blank and section.settings.media_type_1_mobile == 'image'
      assign mobile_media = 'image'
    elsif section.settings.video_1_mobile != blank and section.settings.media_type_1_mobile == 'video'
      assign mobile_media = 'video'
    endif
  endif

  if mobile_media != 'none'
    assign use_mobile_media = true
  endif

  if section.index == 1
    if desktop_media != 'none' or mobile_media != 'none'
      assign fetch_priority = 'high'
    endif
  endif

  if section.settings.section_height == 'auto'
    assign hero_is_auto_height = true
  endif

  assign primary_image = section.settings.image_1
  if primary_image == blank and section.settings.image_1_mobile != blank
    assign primary_image = section.settings.image_1_mobile
  endif

  case section.settings.horizontal_alignment_flex_direction_column
    when 'center'
      assign hero_text_align = 'center'
    when 'flex-end'
      assign hero_text_align = 'right'
  endcase

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

{% capture hero_media %}
  {% if request.page_type == 'index' and section.index == 1 %}
    {% if desktop_media == 'image' %}
      <link
        rel="preload"
        as="image"
        href="{{ section.settings.image_1 | image_url: width: 1920 }}"
        imagesrcset="
          {{ section.settings.image_1 | image_url: width: 768 }} 768w,
          {{ section.settings.image_1 | image_url: width: 1024 }} 1024w,
          {{ section.settings.image_1 | image_url: width: 1280 }} 1280w,
          {{ section.settings.image_1 | image_url: width: 1600 }} 1600w,
          {{ section.settings.image_1 | image_url: width: 1920 }} 1920w,
          {{ section.settings.image_1 | image_url: width: 2560 }} 2560w
        "
        imagesizes="100vw"
        fetchpriority="high"
      >
    {% endif %}
    {% if use_mobile_media and mobile_media == 'image' %}
      <link
        rel="preload"
        as="image"
        media="(max-width: 749px)"
        href="{{ section.settings.image_1_mobile | image_url: width: 960 }}"
        imagesrcset="
          {{ section.settings.image_1_mobile | image_url: width: 360 }} 360w,
          {{ section.settings.image_1_mobile | image_url: width: 480 }} 480w,
          {{ section.settings.image_1_mobile | image_url: width: 640 }} 640w,
          {{ section.settings.image_1_mobile | image_url: width: 800 }} 800w,
          {{ section.settings.image_1_mobile | image_url: width: 960 }} 960w
        "
        imagesizes="100vw"
        fetchpriority="high"
      >
    {% endif %}
  {% endif %}

  {% if desktop_media == 'image' and use_mobile_media and mobile_media == 'image' %}
    <picture
      class="hero__media hero__media-item hero__media-item--all"
      data-testid="hero-picture-1"
    >
      <source
        media="(max-width: 749px)"
        srcset="
          {%- for mobile_width in mobile_widths_array -%}
            {{ section.settings.image_1_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        "
        sizes="100vw"
        width="{{ section.settings.image_1_mobile.width }}"
        height="{{ section.settings.image_1_mobile.height }}"
      >
      {{
        section.settings.image_1
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_1.width,
          widths: desktop_widths,
          height: section.settings.image_1.height,
          alt: section.settings.image_1.alt,
          class: 'hero__media',
          sizes: '100vw',
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-1'
      }}
    </picture>
  {% elsif desktop_media == 'image' %}
    <div class="hero__media-item hero__media-item--desktop{% unless use_mobile_media %} hero__media-item--mobile{% endunless %}">
      {{
        section.settings.image_1
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_1.width,
          widths: desktop_widths,
          height: section.settings.image_1.height,
          alt: section.settings.image_1.alt,
          class: 'hero__media',
          sizes: '100vw',
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-1'
      }}
    </div>
  {% elsif desktop_media == 'video' %}
    <div class="hero__media-item hero__media-item--desktop{% unless use_mobile_media %} hero__media-item--mobile{% endunless %}">
      {{
        section.settings.video_1
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'hero__media',
          data-testid: 'hero-desktop-video-1'
      }}
    </div>
  {% endif %}

  {% if use_mobile_media and mobile_media == 'video' %}
    <div class="hero__media-item hero__media-item--mobile">
      {{
        section.settings.video_1_mobile
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'hero__media',
          data-testid: 'hero-mobile-video-1'
      }}
    </div>
  {% elsif use_mobile_media and desktop_media != 'image' and mobile_media == 'image' %}
    <div class="hero__media-item hero__media-item--mobile">
      {{
        section.settings.image_1_mobile
        | image_url: width: 1600
        | image_tag:
          width: section.settings.image_1_mobile.width,
          widths: mobile_widths,
          height: section.settings.image_1_mobile.height,
          alt: section.settings.image_1_mobile.alt,
          class: 'hero__media',
          sizes: '100vw',
          fetchpriority: fetch_priority,
          data-testid: 'hero-mobile-image-1'
      }}
    </div>
  {% endif %}

  {% if desktop_media == 'none' and use_mobile_media == false %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
  {% endif %}
{% endcapture %}

<div
  id="Hero-{{ section.id }}"
  class="hero{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if hero_is_auto_height %} hero--height-auto{% endif %}{% unless section.settings.toggle_overlay %} hero--readability-scrim{% endunless %}"
  style="
    --hero-content-x: {{ section.settings.horizontal_alignment_flex_direction_column }};
    --hero-content-y: {{ section.settings.vertical_alignment_flex_direction_column }};
    --hero-content-y-mobile: {{ section.settings.vertical_alignment_flex_direction_column }};
    --hero-content-width: min(100%, 38rem);
    --hero-copy-max-width: 31rem;
    --hero-text-align: {{ hero_text_align }};
    --hero-eyebrow-color: rgb(240 199 161 / 0.96);
    --hero-heading-color: #ffffff;
    --hero-description-color: #ffffff;
    --hero-secondary-cta-color: #ffffff;
    --hero-secondary-cta-hover: #ffffff;
    --hero-text-shadow: 0 1px 2px rgb(31 22 16 / 0.2), 0 10px 30px rgb(31 22 16 / 0.16);
    --hero-eyebrow-shadow: 0 1px 2px rgb(31 22 16 / 0.26), 0 8px 24px rgb(31 22 16 / 0.18);
    {% if primary_image != blank %}--hero-media-aspect-ratio: {{ primary_image.aspect_ratio }};{% endif %}
    {% if section.settings.section_height == 'custom' %}
      --hero-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --hero-min-height: 100svh;
    {% elsif section.settings.section_height != 'auto' %}
      --hero-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
  "
  {% if hero_has_visual_preview %}
  data-shopify-visual-preview
  {% endif %}>
  <div class="hero__section spacing-style section section--full-width" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="hero__background" data-testid="hero-media-wrapper">
      <div class="hero__media-grid">
        {{ hero_media }}
      </div>
      {% if section.settings.toggle_overlay %}
        <div class="hero__overlay">
          {% render 'overlay'
            , settings: section.settings
            , layer: '0' %}
        </div>
      {% endif %}
    </div>

    <div class="hero__content-shell hero__content-shell--{{ section.settings.section_width }}">
      <div class="hero__content">
        {% if hero_eyebrow != blank %}
          <p
            class="hero__eyebrow homepage-reveal"
            data-reveal-preset="premium-hero-reveal"
            data-reveal-disable-mobile
            style="--reveal-delay: 150ms;">{{ hero_eyebrow | escape }}</p>
        {% endif %}
        {% if hero_heading != blank %}
          {% if hero_heading_is_editorial_default %}
            <h1 class="hero__heading hero__heading--editorial">
              <span
                class="hero__heading-line homepage-reveal amzcustom-count-processed"
                data-reveal-preset="premium-hero-reveal"
                data-reveal-disable-mobile
                style="--reveal-delay: 300ms;">Sleep Better</span>
              <span
                class="hero__heading-line hero__heading-line--accent homepage-reveal amzcustom-count-processed"
                data-reveal-preset="premium-hero-reveal"
                data-reveal-disable-mobile
                style="--reveal-delay: 450ms;">Every Night</span>
            </h1>
          {% elsif hero_heading_is_custom_split %}
            <h1 class="hero__heading hero__heading--stacked">
              <span
                class="hero__heading-line homepage-reveal amzcustom-count-processed"
                data-reveal-preset="premium-hero-reveal"
                data-reveal-disable-mobile
                style="--reveal-delay: 300ms;">Your Ideas,</span>
              <span
                class="hero__heading-line homepage-reveal amzcustom-count-processed"
                data-reveal-preset="premium-hero-reveal"
                data-reveal-disable-mobile
                style="--reveal-delay: 450ms;">Made Cozy</span>
            </h1>
          {% else %}
            <h1
              class="hero__heading homepage-reveal"
              data-reveal-preset="premium-hero-reveal"
              data-reveal-disable-mobile
              style="--reveal-delay: 300ms;">{{ hero_heading | escape | newline_to_br }}</h1>
          {% endif %}
        {% endif %}
        {% if hero_description != blank %}
          <p
            class="hero__description homepage-reveal"
            data-reveal-preset="premium-hero-reveal"
            data-reveal-disable-mobile
            style="--reveal-delay: 650ms;">{{ hero_description | escape }}</p>
        {% endif %}
        {% if hero_primary_label != blank %}
          <div
            class="hero__actions homepage-reveal"
            data-reveal-preset="premium-hero-reveal"
            data-reveal-disable-mobile
            style="--reveal-delay: 850ms;">
            {% if hero_primary_label != blank %}
              <a
                {% if hero_primary_link == blank %}
                role="link"
                aria-disabled="true"
                {% else %}
                href="{{ hero_primary_link }}"
                {% endif %}
                class="hero__cta hero__cta--primary">
                {{ hero_primary_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "t:names.hero",
    "tag": "section",
    "class": "hero-wrapper section-wrapper",
    "disabled_on": {
      "groups": ["header"]
    },
    "settings": [
      {
        "type": "header",
        "content": "t:content.media_1"
      },
      {
        "type": "select",
        "id": "media_type_1",
        "label": "t:settings.type",
        "options": [
          {
            "value": "image",
            "label": "t:options.image"
          }, {
            "value": "video",
            "label": "t:options.video"
          }
        ],
        "default": "image"
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "t:settings.image",
        "visible_if": "{{ section.settings.media_type_1 == 'image' }}"
      },
      {
        "type": "video",
        "id": "video_1",
        "label": "t:settings.video",
        "visible_if": "{{ section.settings.media_type_1 == 'video' }}"
      }, {
        "type": "header",
        "content": "t:content.mobile_media"
      }, {
        "type": "checkbox",
        "id": "custom_mobile_media",
        "label": "t:settings.custom_mobile_media",
        "default": false
      }, {
        "type": "header",
        "content": "t:content.mobile_media_1",
        "visible_if": "{{ section.settings.custom_mobile_media }}"
      }, {
        "type": "select",
        "id": "media_type_1_mobile",
        "label": "t:settings.type",
        "options": [
          {
            "value": "image",
            "label": "t:options.image"
          }, {
            "value": "video",
            "label": "t:options.video"
          }
        ],
        "default": "image",
        "visible_if": "{{ section.settings.custom_mobile_media }}"
      }, {
        "type": "image_picker",
        "id": "image_1_mobile",
        "label": "t:settings.image",
        "visible_if": "{{ section.settings.custom_mobile_media and section.settings.media_type_1_mobile == 'image' }}"
      }, {
        "type": "video",
        "id": "video_1_mobile",
        "label": "t:settings.video",
        "visible_if": "{{ section.settings.custom_mobile_media and section.settings.media_type_1_mobile == 'video' }}"
      }, {
        "type": "header",
        "content": "Content"
      }, {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "Premium Bedding"
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Sleep Better Every Night"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Soft blankets, quilts and comforters made for warmer, calmer nights."
      }, {
        "type": "text",
        "id": "primary_label",
        "label": "Primary CTA Label",
        "default": "Shop Bedding"
      }, {
        "type": "url",
        "id": "primary_link",
        "label": "Primary CTA Link"
      }, {
        "type": "text",
        "id": "secondary_label",
        "label": "Secondary CTA Label",
        "default": "Explore Collection"
      }, {
        "type": "url",
        "id": "secondary_link",
        "label": "Secondary CTA Link"
      }, {
        "type": "header",
        "content": "t:content.layout"
      }, {
        "type": "select",
        "id": "horizontal_alignment_flex_direction_column",
        "label": "t:settings.alignment",
        "options": [
          {
            "value": "flex-start",
            "label": "t:options.left"
          }, {
            "value": "center",
            "label": "t:options.center"
          }, {
            "value": "flex-end",
            "label": "t:options.right"
          }
        ],
        "default": "flex-start"
      }, {
        "type": "select",
        "id": "vertical_alignment_flex_direction_column",
        "label": "t:settings.position",
        "options": [
          {
            "value": "flex-start",
            "label": "t:options.top"
          }, {
            "value": "center",
            "label": "t:options.center"
          }, {
            "value": "flex-end",
            "label": "t:options.bottom"
          }
        ],
        "default": "flex-end"
      }, {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          }, {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      }, {
        "type": "select",
        "id": "section_height",
        "label": "t:settings.height",
        "options": [
          {
            "value": "auto",
            "label": "t:options.auto"
          },
          {
            "value": "small",
            "label": "t:options.small"
          },
          {
            "value": "medium",
            "label": "t:options.medium"
          },
          {
            "value": "large",
            "label": "t:options.large"
          }, {
            "value": "full-screen",
            "label": "t:options.full_screen"
          }, {
            "value": "custom",
            "label": "t:options.custom"
          }
        ],
        "default": "large"
      }, {
        "type": "range",
        "id": "section_height_custom",
        "label": "t:settings.custom_height",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 50,
        "unit": "%",
        "visible_if": "{{ section.settings.section_height == 'custom' }}"
      }, {
        "type": "header",
        "content": "t:content.appearance"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "t:settings.background_color",
        "placeholder": "t:settings.default"
      }, {
        "type": "checkbox",
        "id": "toggle_overlay",
        "label": "t:settings.media_overlay"
      }, {
        "type": "color",
        "id": "overlay_color",
        "label": "t:settings.overlay_color",
        "alpha": true,
        "default": "#00000026",
        "visible_if": "{{ section.settings.toggle_overlay }}"
      }, {
        "type": "select",
        "id": "overlay_style",
        "label": "t:settings.overlay_style",
        "options": [
          {
            "value": "solid",
            "label": "t:options.solid"
          }, {
            "value": "gradient",
            "label": "t:options.gradient"
          }
        ],
        "default": "solid",
        "visible_if": "{{ section.settings.toggle_overlay }}"
      }, {
        "type": "select",
        "id": "gradient_direction",
        "label": "t:settings.gradient_direction",
        "options": [
          {
            "value": "to top",
            "label": "t:options.up"
          }, {
            "value": "to bottom",
            "label": "t:options.down"
          }
        ],
        "default": "to top",
        "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
      }, {
        "type": "header",
        "content": "t:content.padding"
      }, {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }, {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "t:names.hero",
        "category": "t:categories.banners",
        "settings": {
          "horizontal_alignment_flex_direction_column": "center",
          "section_height": "large",
          "padding-block-start": 40,
          "padding-block-end": 40,
          "toggle_overlay": true,
          "overlay_style": "gradient",
          "eyebrow": "Premium Bedding",
          "heading": "Sleep Better Every Night",
          "description": "Soft blankets, quilts and comforters made for warmer, calmer nights.",
          "primary_label": "Shop Bedding",
          "secondary_label": "Explore Collection"
        }
      }
    ]
  }
{% endschema %}
