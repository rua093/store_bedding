      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.collections_bento",
      "category": "t:categories.collections",
      "settings": {
        "discovery_layout": "default",
        "layout_type": "bento",
        "bento_gap": 8,
        "section_width": "page-width",
        "carousel_on_mobile": false,
        "patchwork_heading": "Shop by collection",
        "patchwork_subheading": "Browse blankets, quilts and comforters by the kind of comfort you want to bring into the room, from airy and minimal to warm and cocooning.",
        "enable_patchwork_motion": true,
        "enable_patchwork_interaction": true,
        "padding-block-start": 24,
        "padding-block-end": 24
      },
      "blocks": {
        "group_Lg9LkF": {
          "type": "group",
          "name": "t:names.header",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
