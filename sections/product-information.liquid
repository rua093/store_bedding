
{% liquid
  assign product_resource = closest.product
%}

<script type="application/ld+json">
  {{ product_resource | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: product_resource
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: product_resource
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% render 'sticky-add-to-cart', product_resource: product_resource %}
{% endif %}

{% render 'product-information-content',
  product: product_resource,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Support accordions"
    },
    {
      "type": "text",
      "id": "shipping_heading",
      "label": "Shipping heading",
      "default": "Shipping & Returns"
    },
    {
      "type": "textarea",
      "id": "shipping_intro",
      "label": "Shipping intro",
      "default": "Made-to-order pieces move through a simple, reassuring flow from production to doorstep."
    },
    {
      "type": "text",
      "id": "shipping_step_1_label",
      "label": "Step 1 label",
      "default": "Order placed"
    },
    {
      "type": "text",
      "id": "shipping_step_1_copy",
      "label": "Step 1 copy",
      "default": "We review your order details and personalization request."
    },
    {
      "type": "text",
      "id": "shipping_step_2_label",
      "label": "Step 2 label",
      "default": "Made for you"
    },
    {
      "type": "text",
      "id": "shipping_step_2_copy",
      "label": "Step 2 copy",
      "default": "Your bedding enters production and quality check before dispatch."
    },
    {
      "type": "text",
      "id": "shipping_step_3_label",
      "label": "Step 3 label",
      "default": "Delivered"
    },
    {
      "type": "text",
      "id": "shipping_step_3_copy",
      "label": "Step 3 copy",
      "default": "Tracking updates continue until your order reaches your door."
    },
    {
      "type": "textarea",
      "id": "shipping_details",
      "label": "Shipping details",
      "default": "• If your order arrives damaged, incorrect, or incomplete, please contact us within 7 days of delivery so our team can review the issue and help quickly.\n• Because each piece is made to order, production and transit times may be slightly longer during peak seasons, holiday periods, or high-volume promotions.\n• Delivery windows are estimates and may shift slightly due to carrier delays, weather conditions, customs processing, or regional service interruptions."
    },
    {
      "type": "text",
      "id": "personalization_heading",
      "label": "Personalization heading",
      "default": "Personalization"
    },
    {
      "type": "textarea",
      "id": "personalization_intro",
      "label": "Personalization intro",
      "default": "Help shoppers feel safe customizing by telling them exactly what to enter and what to expect."
    },
    {
      "type": "textarea",
      "id": "personalization_details",
      "label": "Personalization details",
      "default": "• Provide the exact name, phrase, or wording you want printed.\n• Double-check spelling, punctuation, and capitalization before placing the order.\n• If your design supports photo upload, choose a clear, bright image for the best result.\n• Preview colors on-screen may vary slightly from the finished product because of display settings and photography."
    },
    {
      "type": "textarea",
      "id": "personalization_note",
      "label": "Personalization note",
      "default": "Need something more custom than the standard options? Mention it in your request and your team can review what is possible before production starts."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
