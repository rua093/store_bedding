{% liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign name_id = 'ContactForm-name-' | append: section.id
  assign email_id = 'ContactForm-email-' | append: section.id
  assign phone_id = 'ContactForm-phone-' | append: section.id
  assign body_id = 'ContactForm-body-' | append: section.id
%}

<section
  class="contact-page"
  style="--contact-page-bg-image: url('{{ 'bg_new_arrivals.webp' | asset_url }}');"
>
  <div class="section page-width-normal">
    <div class="contact-page__inner">
      <header class="contact-page__header">
        <p class="contact-page__eyebrow">WE&rsquo;D LOVE TO HELP</p>
        <h1 class="contact-page__heading">Contact us</h1>
        <p class="contact-page__subheading">
          Have a question about your custom bedding, order, or design idea? Send us a message and
          we&rsquo;ll help you make it cozy.
        </p>
      </header>

      <div class="contact-page__grid">
        <aside class="contact-page__card contact-page__card--info">
          <div class="contact-page__card-content">
            <h2 class="contact-page__card-heading">How can we help?</h2>
            <p class="contact-page__card-text">
              We&rsquo;re here for anything related to custom photo bedding, orders, shipping,
              sizes, materials or design requests.
            </p>

            <div class="contact-page__info-list" role="list">
              <div class="contact-page__info-item" role="listitem">
                <span class="contact-page__info-icon" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect
                      width="20"
                      height="16"
                      x="2"
                      y="4"
                      rx="2"
                    /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </span>
                <div class="contact-page__info-copy">
                  <p class="contact-page__info-label">Email</p>
                  <a href="mailto:support@jeminise.com">support@jeminise.com</a>
                </div>
              </div>

              <div class="contact-page__info-item" role="listitem">
                <span class="contact-page__info-icon" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </span>
                <div class="contact-page__info-copy">
                  <p class="contact-page__info-label">Phone</p>
                  <a href="tel:+15735259889">+1 (573) 525-9889</a>
                </div>
              </div>

              <div class="contact-page__info-item" role="listitem">
                <span class="contact-page__info-icon" aria-hidden="true">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle
                      cx="12"
                      cy="10"
                      r="3"
                    />
                  </svg>
                </span>
                <div class="contact-page__info-copy">
                  <p class="contact-page__info-label">Address</p>
                  <p>30 N Gould St, Sheridan, WY 82801, United States</p>
                </div>
              </div>

              <div class="contact-page__info-item" role="listitem">
                <span class="contact-page__info-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path
                      d="M12 6v6l3.5 2"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.7"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                    />
                  </svg>
                </span>
                <div class="contact-page__info-copy">
                  <p class="contact-page__info-label">Response time</p>
                  <p>Usually replies within 24 hours</p>
                </div>
              </div>
            </div>

            <div class="contact-page__tip">
              <strong>&#9825; Tip:</strong> For custom orders, include your idea, preferred size,
              and any photo/design details.
            </div>
          </div>
        </aside>

        <div class="contact-page__card contact-page__card--form">
          {%- form 'contact', id: form_id, class: 'contact-page__form' -%}
            {%- if form.posted_successfully? -%}
              <div class="contact-page__status contact-page__status--success" tabindex="-1" autofocus>
                <span class="contact-page__status-icon" aria-hidden="true">
                  {{ 'icon-checkmark.svg' | inline_asset_content }}
                </span>
                <div>{{ 'blocks.contact_form.post_success' | t }}</div>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="contact-page__status contact-page__status--error" role="alert" tabindex="-1" autofocus>
                <span class="contact-page__status-icon" aria-hidden="true">
                  {{ 'icon-error.svg' | inline_asset_content }}
                </span>
                <div>{{ form.errors | default_errors }}</div>
              </div>
            {%- endif -%}

            <div class="contact-page__field-grid">
              <div class="contact-page__field">
                <label class="contact-page__label" for="{{ name_id }}">Name</label>
                <input
                  id="{{ name_id }}"
                  class="contact-page__input"
                  type="text"
                  name="contact[name]"
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="Name"
                >
              </div>

              <div class="contact-page__field">
                <label class="contact-page__label" for="{{ email_id }}">Email</label>
                <input
                  id="{{ email_id }}"
                  class="contact-page__input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocapitalize="off"
                  spellcheck="false"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="Email"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>
            </div>

            <div class="contact-page__field">
              <label class="contact-page__label" for="{{ phone_id }}">Phone</label>
              <input
                id="{{ phone_id }}"
                class="contact-page__input"
                type="tel"
                name="contact[phone]"
                autocomplete="tel"
                pattern="[0-9\\-\\+\\s\\(\\)]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="Phone"
              >
            </div>

            <div class="contact-page__field">
              <label class="contact-page__label" for="{{ body_id }}">Comment</label>
              <textarea
                id="{{ body_id }}"
                class="contact-page__input contact-page__textarea"
                name="contact[body]"
                rows="8"
                placeholder="Comment"
              >{{- form.body -}}</textarea>
            </div>

            <div class="contact-page__actions">
              <button class="contact-page__button" type="submit">Send message</button>
              <p class="contact-page__fine-print">We&rsquo;ll get back to you as soon as possible.</p>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact-page {
    position: relative;
    overflow-x: clip;
    background:
      linear-gradient(180deg, rgb(255 251 247 / 0.94) 0%, rgb(247 237 227 / 0.82) 100%),
      var(--contact-page-bg-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .contact-page .section.page-width-normal {
    padding-block: clamp(2.4rem, 4vw, 4.2rem);
  }

  .contact-page__inner {
    width: min(100%, 1060px);
    margin-inline: auto;
  }

  .contact-page__header {
    max-width: 46rem;
    margin: 0 auto clamp(1.35rem, 2vw, 1.8rem);
    text-align: center;
  }

  .contact-page__eyebrow {
    margin: 0 0 0.65rem;
    color: #a45f3c;
    font-family: var(--font-body--family);
    font-size: clamp(0.72rem, 0.8vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contact-page__heading {
    margin: 0;
    color: #4b362c;
    font-family: var(--font-heading--family);
    font-size: clamp(2.5rem, 4.5vw, 3.6rem);
    font-weight: 560;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .contact-page__subheading {
    margin: 0.75rem auto 0;
    max-width: 34rem;
    color: #6f594d;
    font-family: var(--font-body--family);
    font-size: clamp(0.92rem, 0.98vw, 0.98rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(18px, 2vw, 24px);
    align-items: stretch;
  }

  .contact-page__card {
    border: 1px solid rgb(190 130 90 / 0.18);
    border-radius: 22px;
    background: rgb(255 250 245 / 0.9);
    box-shadow: 0 16px 38px rgb(91 62 42 / 0.08);
    overflow: hidden;
    backdrop-filter: blur(1px);
  }

  .contact-page__card-content,
  .contact-page__form {
    padding: clamp(1.35rem, 2vw, 1.75rem);
  }

  .contact-page__card--info {
    min-width: 0;
    align-self: start;
  }

  .contact-page__card-heading {
    margin: 0;
    color: #4b362c;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 2vw, 1.95rem);
    font-weight: 540;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .contact-page__card-text {
    margin: 0.7rem 0 0;
    max-width: 22rem;
    color: #6f594d;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .contact-page__info-list {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.25rem;
  }

  .contact-page__info-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .contact-page__info-icon {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: #bd7145;
  }

  .contact-page__info-icon svg {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .contact-page__info-copy {
    min-width: 0;
  }

  .contact-page__info-copy p,
  .contact-page__info-copy a {
    margin: 0;
    color: #6f594d;
    font-size: 0.9rem;
    line-height: 1.45;
    text-decoration: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .contact-page__info-copy a:hover,
  .contact-page__info-copy a:focus-visible {
    color: #c47a4a;
  }

  .contact-page__info-label {
    margin-bottom: 0.1rem;
    color: #4b362c !important;
    font-size: 0.92rem !important;
    font-weight: 600;
    letter-spacing: normal;
    text-transform: none;
  }

  .contact-page__tip {
    margin-top: 1.2rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid rgb(196 122 74 / 0.14);
    border-radius: 12px;
    background: rgb(249 233 220 / 0.85);
    color: #7a5a47;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .contact-page__tip strong {
    color: #9a603f;
  }

  .contact-page__form {
    display: grid;
    gap: 1rem;
  }

  .contact-page__status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    line-height: 1.5;
  }

  .contact-page__status--success {
    border: 1px solid rgb(126 165 119 / 0.32);
    background: rgb(244 250 241 / 0.94);
    color: #355b34;
  }

  .contact-page__status--error {
    border: 1px solid rgb(194 116 88 / 0.28);
    background: rgb(255 243 239 / 0.96);
    color: #8b4935;
  }

  .contact-page__status-icon {
    width: 1.2rem;
    height: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .contact-page__status-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .contact-page__status :is(ul, li, p) {
    margin: 0;
  }

  .contact-page__status ul {
    padding-left: 1rem;
  }

  .contact-page__field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .contact-page__field {
    display: grid;
    gap: 0.35rem;
  }

  .contact-page__label {
    color: #5d4334;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .contact-page__input {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 0.8rem 0.9rem;
    border: 1px solid rgb(170 120 90 / 0.2);
    border-radius: 10px;
    background: rgb(255 255 255 / 0.7);
    color: #4b362c;
    font: inherit;
    line-height: 1.4;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .contact-page__input::placeholder {
    color: rgb(113 86 70 / 0.72);
  }

  .contact-page__input:focus-visible {
    outline: none;
    border-color: #c47a4a;
    box-shadow: 0 0 0 4px rgb(196 122 74 / 0.14);
  }

  .contact-page__textarea {
    min-height: 170px;
    resize: vertical;
  }

  .contact-page__actions {
    display: grid;
    gap: 0.55rem;
  }

  .contact-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.9rem 1.4rem;
    border: 0;
    border-radius: 10px;
    background: #bd7145;
    color: #fffaf5;
    font: inherit;
    font-size: 0.96rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    box-shadow: none;
    transition:
      background-color 180ms ease,
      filter 180ms ease;
  }

  .contact-page__button:hover,
  .contact-page__button:focus-visible {
    background: #a95f38;
    filter: none;
  }

  .contact-page__fine-print {
    margin: 0;
    color: #7a614f;
    font-size: 0.82rem;
    line-height: 1.45;
    text-align: center;
  }

  @media screen and (max-width: 860px) {
    .contact-page__grid {
      grid-template-columns: 1fr;
      width: min(100%, 620px);
      margin-inline: auto;
    }

    .contact-page__card--info {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .contact-page .section.page-width-normal {
      padding-block: 2rem;
    }

    .contact-page__header {
      margin-bottom: 1.1rem;
    }

    .contact-page__heading {
      font-size: clamp(2rem, 9vw, 2.55rem);
    }

    .contact-page__subheading {
      font-size: 0.93rem;
      line-height: 1.55;
    }

    .contact-page__grid {
      gap: 0.9rem;
    }

    .contact-page__card {
      border-radius: 20px;
    }

    .contact-page__card-content,
    .contact-page__form {
      padding: 1.15rem;
    }

    .contact-page__field-grid {
      grid-template-columns: 1fr;
    }

    .contact-page__textarea {
      min-height: 150px;
    }

    .contact-page__button {
      width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    .contact-page__card-content,
    .contact-page__form {
      padding: 18px;
    }

    .contact-page__heading {
      font-size: clamp(2.125rem, 9vw, 2.375rem);
    }

    .contact-page__input,
    .contact-page__button {
      min-height: 46px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main contact page",
  "tag": "section",
  "class": "section-contact-page",
  "settings": [],
  "presets": [
    {
      "name": "Main contact page"
    }
  ]
}
{% endschema %}
