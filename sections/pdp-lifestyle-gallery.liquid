{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<section class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} pdp-lifestyle-gallery spacing-style">
  <div class="pdp-lifestyle-gallery__shell" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="pdp-lifestyle-gallery__header">
      {% if section.settings.eyebrow != blank %}
        <p class="pdp-lifestyle-gallery__eyebrow">
          <span class="pdp-lifestyle-gallery__eyebrow-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-6.7-4.35-9.25-8.3A5.43 5.43 0 0 1 7.35 4c1.82 0 3.33.9 4.65 2.48C13.32 4.9 14.83 4 16.65 4a5.43 5.43 0 0 1 4.6 8.7C18.7 16.65 12 21 12 21Z"/>
            </svg>
          </span>
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="pdp-lifestyle-gallery__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="pdp-lifestyle-gallery__subheading rte">{{ section.settings.description | escape | newline_to_br }}</div>
      {% endif %}
    </div>

    {% liquid
      assign lifestyle_slide_count = section.blocks.size
      assign lifestyle_render_slide_count = lifestyle_slide_count
      if lifestyle_render_slide_count == 0
        assign lifestyle_render_slide_count = 1
      endif
    %}

    {% capture lifestyle_slides %}
      {% if lifestyle_slide_count > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign image = block.settings.image
            assign tag_name = 'div'
            if block.settings.link != blank
              assign tag_name = 'a'
            endif
          %}

          {% capture slide_children %}
            <{{ tag_name }}
              class="pdp-lifestyle-gallery__card"
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="pdp-lifestyle-gallery__media">
                {% if image != blank %}
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      alt: block.settings.caption,
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200',
                      sizes: '(min-width: 1200px) 24vw, (min-width: 750px) 42vw, 82vw'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'pdp-lifestyle-gallery__placeholder' }}
                {% endif %}
              </div>
              {% if block.settings.caption != blank %}
                <p class="pdp-lifestyle-gallery__caption">{{ block.settings.caption }}</p>
              {% endif %}
            </{{ tag_name }}>
          {% endcapture %}

          {% render 'slideshow-slide', index: forloop.index0, children: slide_children, class: 'pdp-lifestyle-gallery__slide' %}
        {% endfor %}
      {% else %}
        {% capture placeholder_slide %}
          <div class="pdp-lifestyle-gallery__card">
            <div class="pdp-lifestyle-gallery__media">
              {{ 'image' | placeholder_svg_tag: 'pdp-lifestyle-gallery__placeholder' }}
            </div>
            <p class="pdp-lifestyle-gallery__caption">Styled in a real home</p>
          </div>
        {% endcapture %}
        {% render 'slideshow-slide', index: 0, children: placeholder_slide, class: 'pdp-lifestyle-gallery__slide' %}
      {% endif %}
    {% endcapture %}

    {% render 'slideshow',
      ref: 'pdpLifestyleCarousel',
      class: 'pdp-lifestyle-gallery__carousel',
      slides: lifestyle_slides,
      show_arrows: false,
      icon_style: 'arrow',
      icon_shape: 'circle',
      auto_hide_controls: false,
      infinite: false,
      slide_count: lifestyle_render_slide_count
    %}
  </div>
</section>

{% stylesheet %}
  .pdp-lifestyle-gallery__shell {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .pdp-lifestyle-gallery__header {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }

  .pdp-lifestyle-gallery__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    color: #9b6a48;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pdp-lifestyle-gallery__eyebrow-icon {
    display: inline-flex;
    width: 0.95rem;
    height: 0.95rem;
  }

  .pdp-lifestyle-gallery__eyebrow-icon svg {
    width: 100%;
    height: 100%;
  }

  .pdp-lifestyle-gallery__heading {
    margin: 0;
    color: #4d372b;
    font-family: var(--font-heading--family);
    font-size: clamp(1.65rem, 2.9vw, 2.7rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .pdp-lifestyle-gallery__subheading {
    color: #7b6556;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .pdp-lifestyle-gallery__subheading :is(p, ul, ol) {
    margin: 0;
  }

  .pdp-lifestyle-gallery__carousel {
    --pdp-lifestyle-gap: clamp(0.8rem, 1.8vw, 1.1rem);
    width: 100%;
    position: relative;
  }

  .pdp-lifestyle-gallery__carousel slideshow-slides {
    gap: var(--pdp-lifestyle-gap);
    padding-block: 0.45rem 0.75rem;
  }

  .pdp-lifestyle-gallery__slide {
    width: calc((100% - (var(--pdp-lifestyle-gap) * 3)) / 4);
    min-width: 0;
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .pdp-lifestyle-gallery__card {
    display: grid;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
  }

  .pdp-lifestyle-gallery__media {
    position: relative;
    overflow: hidden;
    border-radius: 1.2rem;
    border: 1px solid rgba(125, 93, 67, 0.1);
    background: linear-gradient(180deg, rgba(255, 250, 245, 1), rgba(248, 238, 227, 1));
    box-shadow: 0 16px 38px rgba(86, 57, 38, 0.07);
    aspect-ratio: 0.8;
  }

  .pdp-lifestyle-gallery__media img,
  .pdp-lifestyle-gallery__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .pdp-lifestyle-gallery__card:hover .pdp-lifestyle-gallery__media img {
    transform: scale(1.02);
  }

  .pdp-lifestyle-gallery__media img {
    transition: transform 220ms ease;
  }

  .pdp-lifestyle-gallery__caption {
    margin: 0;
    color: #6a5343;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
  }

  @media screen and (max-width: 1199px) {
    .pdp-lifestyle-gallery__slide {
      width: calc((100% - (var(--pdp-lifestyle-gap) * 1.5)) / 2.5);
    }
  }

  @media screen and (max-width: 749px) {
    .pdp-lifestyle-gallery__carousel slideshow-slides {
      padding-block: 0.3rem 0.55rem;
    }

    .pdp-lifestyle-gallery__slide {
      width: min(82vw, 20rem);
    }

    .pdp-lifestyle-gallery__media {
      aspect-ratio: 1;
      border-radius: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Lifestyle Gallery",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Styled in a real home"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Lifestyle inspiration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See how our bedding styles real homes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "PDP Lifestyle Gallery"
    }
  ]
}
{% endschema %}
