

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- capture announcement_marquee_items -%}
  <span class="announcement-bar__marquee-item">Made From Your Ideas</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item">Turn Photos, Names &amp; Favorite Memories Into Cozy Bedding</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item">Free Shipping</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item">10% Off Your First Order</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
{%- endcapture -%}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-bg-image: url('{{ "bg-anoucement.png" | asset_url }}');{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__slider" aria-live="polite">
    <div class="announcement-bar__marquee" aria-label="Store announcements">
      <div class="announcement-bar__marquee-track">
        {{ announcement_marquee_items }}
        <span class="visually-hidden">Store announcements repeated for marquee loop.</span>
        <span class="announcement-bar__marquee-group" aria-hidden="true">
          {{ announcement_marquee_items }}
        </span>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    min-height: 42px;
    display: flex;
    align-items: center;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background-color: {{ section.settings.background_color | default: '#445958' }};
    background-image: var(--announcement-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom-color: rgb(var(--color-foreground-rgb) / 0.16);
    overflow: hidden;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .announcement-bar::before {
    inset: 0;
    background:
      linear-gradient(180deg, rgb(32 21 15 / 0.03), rgb(32 21 15 / 0.03)),
      linear-gradient(90deg, rgb(255 255 255 / 0.02), transparent 18%, transparent 82%, rgb(255 255 255 / 0.02));
    opacity: 1;
  }

  .announcement-bar::after {
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: rgb(var(--color-foreground-rgb) / 0.16);
  }

  .announcement-bar__slider {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    min-height: inherit;
  }

  .announcement-bar__marquee {
    width: 100%;
    min-height: inherit;
    overflow: hidden;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .announcement-bar__marquee-track {
    display: inline-flex;
    align-items: center;
    min-width: max-content;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    white-space: nowrap;
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    will-change: transform;
    animation: announcement-marquee 26s linear infinite;
  }

  .announcement-bar__marquee-group {
    display: inline-flex;
    align-items: center;
    gap: inherit;
  }

  .announcement-bar__marquee-item,
  .announcement-bar__marquee-separator {
    display: inline-flex;
    align-items: center;
    color: rgb(var(--color-foreground-rgb));
    font-family: var(--font-heading--family);
    font-size: clamp(0.82rem, 1vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: none;
    text-shadow: 0 1px 0 rgb(19 27 21 / 0.12);
  }

  .announcement-bar__marquee-separator {
    color: rgb(var(--color-foreground-rgb) / 0.7);
    font-size: 0.95em;
  }

  .announcement-bar:hover .announcement-bar__marquee-track,
  .announcement-bar:focus-within .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes announcement-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar {
      min-height: 38px;
    }

    .announcement-bar__slider {
      min-height: inherit;
    }

    .announcement-bar__marquee-track {
      gap: 1rem;
      padding-inline: 0.75rem;
      animation-duration: 24s;
    }

    .announcement-bar__marquee-item,
    .announcement-bar__marquee-separator {
      font-size: clamp(0.74rem, 2.7vw, 0.86rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
