

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background: {{ section.settings.background_color | default: '#445958' }};
    border-bottom-color: rgb(244 240 234 / 0.16);
    overflow: hidden;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .announcement-bar::before {
    inset: 0;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.02), transparent 18%, transparent 82%, rgb(255 255 255 / 0.02));
    opacity: 1;
  }

  .announcement-bar::after {
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: rgb(244 240 234 / 0.16);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    min-height: 36px;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: min(1180px, 100%);
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: #f4f0ea;
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    border-radius: 999px;
    transition:
      background-color var(--animation-speed) var(--animation-easing),
      transform var(--animation-speed) var(--animation-easing);

    &:hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.05);
      transform: translateY(-1px);
    }

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
    text-align: center;
    width: 100%;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__content {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: clamp(0.55rem, 1.8vw, 1rem);
    line-height: 1;
    position: relative;
    isolation: isolate;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
  }

  .announcement-bar__icon {
    flex: 0 0 auto;
    width: 1.1rem;
    height: 1.1rem;
    color: rgb(244 240 234 / 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    filter: none;
  }

  .announcement-bar__icon svg {
    width: 100%;
    height: 100%;
  }

  .announcement-bar__text {
    font-size: var(--font-size--sm);
    letter-spacing: 0.015em;
    line-height: 1;
  }

  .announcement-bar__text--main {
    flex: 0 1 auto;
    min-width: 0;
    margin: 0;
    color: #f4f0ea;
    font-family: var(--font-heading--family);
    font-size: clamp(0.9rem, 1.04vw, 1.02rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    text-wrap: nowrap;
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 0 rgb(19 27 21 / 0.18);
  }

  .announcement-bar__slide p {
    color: rgb(var(--color-foreground-rgb) / 0.9);
  }

  .announcement-bar__text-line {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 0.42rem;
  }

  .announcement-bar__text-strong {
    font-weight: 650;
    color: #f4f0ea;
  }

  .announcement-bar__text-divider {
    color: rgb(244 240 234 / 0.72);
    font-weight: 400;
  }

  .announcement-bar__text-emphasis {
    display: inline-block;
    margin-inline: 0;
    color: rgb(244 240 234 / 0.82);
    font-family: var(--font-accent--family, var(--font-heading--family));
    font-style: italic;
    font-size: 1.02em;
    line-height: 1;
    text-shadow: 0 1px 0 rgb(19 27 21 / 0.14);
  }

  .announcement-bar__cta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    max-width: 100%;
    padding: 0 0 0.08rem;
    min-height: 0;
    border-radius: 0;
    background: transparent;
    color: #f4f0ea;
    text-decoration: none;
    box-shadow: none;
    border-bottom: 1px solid currentColor;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    position: relative;
    z-index: 1;
    opacity: 0.92;
    transition:
      color var(--animation-speed-fast) var(--animation-easing),
      border-color var(--animation-speed-fast) var(--animation-easing),
      opacity var(--animation-speed-fast) var(--animation-easing);
  }

  .announcement-bar__cta:hover {
    color: #f4f0ea;
    border-bottom-color: rgb(244 240 234 / 0.96);
    opacity: 1;
  }

  .announcement-bar__cta-arrow {
    font-size: 1em;
    line-height: 1;
    transform: translateX(0);
    transition: transform var(--animation-speed-fast) var(--animation-easing);
  }

  .announcement-bar__cta:hover .announcement-bar__cta-arrow {
    transform: translateX(2px);
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__slides {
      width: 100%;
    }

    .announcement-bar__content {
      gap: 0.35rem;
      padding-inline: 0.65rem;
    }

    .announcement-bar__icon {
      display: none;
    }

    .announcement-bar__text--main {
      flex: 1 1 auto;
      font-size: clamp(0.74rem, 2.7vw, 0.86rem);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .announcement-bar__text-line {
      gap: 0.25rem;
    }

    .announcement-bar__cta {
      flex: 0 0 auto;
      padding-bottom: 0.06rem;
      font-size: 0.72rem;
      gap: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__slide,
    .announcement-bar__slider .slideshow-control,
    .announcement-bar__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
