

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background:
      radial-gradient(circle at 50% 50%, rgb(244 204 129 / 0.14) 0, rgb(244 204 129 / 0.06) 22%, transparent 54%),
      linear-gradient(90deg, #1f140e 0%, #3a2618 45%, #24170f 100%);
    border-bottom-color: rgb(230 196 138 / 0.65);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .announcement-bar::before {
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgb(255 224 158 / 0.12), transparent 34%),
      linear-gradient(90deg, transparent 0%, rgb(255 224 158 / 0.08) 50%, transparent 100%);
    opacity: 0.95;
  }

  .announcement-bar::after {
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, rgb(255 221 162 / 0.18), rgb(244 205 133 / 0.8), rgb(255 221 162 / 0.18));
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    min-height: 36px;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: min(1180px, 100%);
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;
    border-radius: 999px;
    transition:
      background-color var(--animation-speed) var(--animation-easing),
      transform var(--animation-speed) var(--animation-easing);

    &:hover {
      background-color: rgb(var(--color-foreground-rgb) / 0.05);
      transform: translateY(-1px);
    }

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
    text-align: center;
    width: 100%;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__content {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: clamp(1.2rem, 3vw, 3rem);
    line-height: 1;
    position: relative;
    isolation: isolate;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem);
  }

  .announcement-bar__icon {
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    color: rgb(117 75 28 / 0.7);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 6px rgb(255 215 147 / 0.1));
  }

  .announcement-bar__icon svg {
    width: 100%;
    height: 100%;
  }

  .announcement-bar__text {
    font-size: var(--font-size--sm);
    letter-spacing: 0.02em;
    line-height: 1.35;
  }

  .announcement-bar__text--main {
    flex: 0 1 auto;
    min-width: 0;
    margin: 0;
    color: #2f2115;
    font-family: var(--font-heading--family);
    font-size: clamp(0.92rem, 1.1vw, 1.08rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.28);
  }

  .announcement-bar__slide p {
    color: rgb(var(--color-foreground-rgb) / 0.9);
  }

  .announcement-bar__text-line {
    white-space: nowrap;
  }

  .announcement-bar__text-emphasis {
    display: inline-block;
    margin-inline: 0.08em;
    color: #8b5a24;
    font-family: var(--font-accent--family, var(--font-heading--family));
    font-style: italic;
    font-size: 1.18em;
    line-height: 0.9;
    text-shadow: 0 1px 0 rgb(255 236 202 / 0.18);
  }

  .announcement-bar__cta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 100%;
    padding-inline: 1rem;
    min-height: 1.9rem;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffe4aa, #d9a85d);
    color: #2a180d;
    text-decoration: none;
    box-shadow:
      0 0 16px rgb(255 212 126 / 0.12),
      inset 0 1px 0 rgb(255 248 230 / 0.55),
      inset 0 0 0 1px rgb(133 89 29 / 0.16);
    font-size: 0.85rem;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    position: relative;
    z-index: 1;
    transition:
      transform var(--animation-speed-fast) var(--animation-easing),
      filter var(--animation-speed-fast) var(--animation-easing),
      box-shadow var(--animation-speed-fast) var(--animation-easing);
  }

  .announcement-bar__cta:hover {
    filter: brightness(1.03);
    box-shadow:
      0 0 18px rgb(255 212 126 / 0.18),
      inset 0 1px 0 rgb(255 248 230 / 0.62),
      inset 0 0 0 1px rgb(133 89 29 / 0.14);
    transform: translateY(-1px);
  }

  .announcement-bar__cta-arrow {
    font-size: 1em;
    line-height: 1;
    transform: translateY(-0.02em);
  }

  .announcement-bar__motif {
    position: absolute;
    right: max(-0.25rem, calc(50% - 31rem));
    top: 50%;
    width: 5.5rem;
    height: 2.4rem;
    transform: translateY(-50%);
    color: rgb(121 88 53 / 0.16);
    pointer-events: none;
    z-index: 0;
  }

  .announcement-bar__motif svg {
    width: 100%;
    height: 100%;
  }

  .announcement-bar__sparkle {
    position: absolute;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 999px;
    background: #f6d79f;
    box-shadow:
      0 0 0 1px rgb(255 245 214 / 0.2),
      0 0 8px rgb(255 216 146 / 0.28);
    pointer-events: none;
    z-index: 0;
  }

  .announcement-bar__sparkle::before,
  .announcement-bar__sparkle::after {
    content: '';
    position: absolute;
    inset: 50%;
    background: rgb(255 228 169 / 0.85);
    transform: translate(-50%, -50%);
  }

  .announcement-bar__sparkle::before {
    width: 0.9rem;
    height: 1px;
  }

  .announcement-bar__sparkle::after {
    width: 1px;
    height: 0.9rem;
  }

  .announcement-bar__sparkle--one {
    left: max(0.8rem, calc(50% - 23rem));
    top: 28%;
  }

  .announcement-bar__sparkle--two {
    left: min(calc(100% - 6rem), calc(50% + 16rem));
    top: 23%;
    width: 0.2rem;
    height: 0.2rem;
  }

  .announcement-bar__sparkle--three {
    right: max(0.8rem, calc(50% - 24rem));
    top: 69%;
    width: 0.24rem;
    height: 0.24rem;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__slides {
      width: 100%;
    }

    .announcement-bar__content {
      gap: 0.5rem;
      padding-inline: 0.65rem;
    }

    .announcement-bar__icon {
      display: none;
    }

    .announcement-bar__motif,
    .announcement-bar__sparkle {
      display: none;
    }

    .announcement-bar__text--main {
      flex: 1 1 auto;
      font-size: clamp(0.76rem, 2.8vw, 0.9rem);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .announcement-bar__cta {
      flex: 0 0 auto;
      padding-inline: 0.68rem;
      min-height: 1.75rem;
      font-size: 0.74rem;
      gap: 0.32rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__slide,
    .announcement-bar__slider .slideshow-control,
    .announcement-bar__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
