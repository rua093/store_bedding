
{% liquid
  assign announcement_background_image_url = 'bg-announcement.webp' | asset_url
  if section.settings.background_image != blank
    assign announcement_background_image_url = section.settings.background_image | image_url: width: 2400
  endif
%}

<link
  rel="preload"
  as="image"
  href="{{ announcement_background_image_url }}"
>

{%- capture announcement_marquee_items -%}
  <span class="announcement-bar__marquee-item">Made From Your Ideas</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item">Turn Photos, Names &amp; Favorite Memories Into Cozy Bedding</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item">Free Shipping</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
  <span class="announcement-bar__marquee-item announcement-bar__marquee-item--promo">10% Off Your First Order</span>
  <span class="announcement-bar__marquee-separator" aria-hidden="true">•</span>
{%- endcapture -%}
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-bg-image: url('{{ announcement_background_image_url }}');{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__slider" aria-live="polite">
    <div class="announcement-bar__marquee" aria-label="Store announcements">
      <div class="announcement-bar__marquee-track">
        {{ announcement_marquee_items }}
        <span class="visually-hidden">Store announcements repeated for marquee loop.</span>
        <span class="announcement-bar__marquee-group" aria-hidden="true">
          {{ announcement_marquee_items }}
        </span>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    --announcement-text-color: #2f2119;
    --announcement-text-rgb: 47 33 25;
    --announcement-promo-color: #8f3f24;

    position: relative;
    min-height: 32px;
    display: flex;
    align-items: center;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background:
      radial-gradient(circle at top center, rgb(255 251 245 / 0.92), transparent 58%),
      linear-gradient(180deg, #fff7ea 0%, #f7ead9 52%, #efd9c3 100%);
    color: var(--announcement-text-color);
    border-bottom-color: rgb(var(--announcement-text-rgb) / 0.16);
    overflow: hidden;
    isolation: isolate;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    pointer-events: none;
  }

  .announcement-bar::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--announcement-bg-image);
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1;
  }

  .announcement-bar::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: 1px;
    background: rgb(var(--announcement-text-rgb) / 0.16);
  }

  .announcement-bar__slider {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
    min-height: inherit;
  }

  .announcement-bar__marquee {
    width: 100%;
    min-height: inherit;
    overflow: hidden;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .announcement-bar__marquee-track {
    display: inline-flex;
    align-items: center;
    min-width: max-content;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    white-space: nowrap;
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    will-change: transform;
    animation: announcement-marquee 26s linear infinite;
  }

  .announcement-bar__marquee-group {
    display: inline-flex;
    align-items: center;
    gap: inherit;
  }

  .announcement-bar__marquee-item,
  .announcement-bar__marquee-separator {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading--family);
    font-size: clamp(0.82rem, 0.98vw, 0.98rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: none;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.45);
  }

  .announcement-bar__marquee-item {
    color: var(--announcement-text-color);
  }

  .announcement-bar__marquee-item--promo {
    color: var(--announcement-promo-color);
    font-weight: 800;
    letter-spacing: 0.018em;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    background: rgb(255 248 239 / 0.72);
    box-shadow:
      inset 0 0 0 1px rgb(176 79 47 / 0.18),
      0 1px 4px rgb(63 34 22 / 0.08);
  }

  .announcement-bar__marquee-separator {
    color: rgb(var(--announcement-text-rgb) / 0.48);
    font-size: 0.9em;
  }

  .announcement-bar:hover .announcement-bar__marquee-track,
  .announcement-bar:focus-within .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes announcement-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar {
      min-height: 30px;
    }

    .announcement-bar__slider {
      min-height: inherit;
    }

    .announcement-bar__marquee-track {
      gap: 1rem;
      padding-inline: 0.75rem;
      animation-duration: 24s;
    }

    .announcement-bar__marquee-item,
    .announcement-bar__marquee-separator {
      font-size: clamp(0.7rem, 2.45vw, 0.8rem);
    }

    .announcement-bar__marquee-item--promo {
      padding: 0.06rem 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
