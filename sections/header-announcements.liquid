
{% liquid
  assign announcement_background_image_url = blank
  assign announcement_marquee_duration = section.settings.speed
  assign announcement_message_1 = section.settings.message_1 | strip
  assign announcement_message_2 = section.settings.message_2 | strip
  assign announcement_message_3 = section.settings.message_3 | strip
  assign announcement_message_4 = section.settings.message_4 | strip

  assign seasonal_announcement_bg = blank
  if request.page_type == 'collection' and collection != blank
    if collection.metafields.custom.announcement_bg != blank
      assign seasonal_announcement_bg = collection.metafields.custom.announcement_bg | image_url: width: 2400
    endif
  elsif request.page_type == 'product' and product != blank
    if product.metafields.custom.announcement_bg != blank
      assign seasonal_announcement_bg = product.metafields.custom.announcement_bg | image_url: width: 2400
    else
      for col in product.collections
        if col.metafields.custom.announcement_bg != blank
          assign seasonal_announcement_bg = col.metafields.custom.announcement_bg | image_url: width: 2400
          break
        endif
      endfor
    endif
  endif

  if seasonal_announcement_bg != blank
    assign announcement_background_image_url = seasonal_announcement_bg
  elsif section.settings.background_image != blank
    assign announcement_background_image_url = section.settings.background_image | image_url: width: 2400
  endif
%}

{%- capture announcement_marquee_items -%}
  {% if announcement_message_1 != blank %}<span class="announcement-bar__marquee-item">{{ announcement_message_1 }}</span>{% endif %}
  {% if announcement_message_2 != blank %}<span class="announcement-bar__marquee-separator" aria-hidden="true" data-icon-default="•" data-icon-halloween="🎃"></span><span class="announcement-bar__marquee-item">{{ announcement_message_2 }}</span>{% endif %}
  {% if announcement_message_3 != blank %}<span class="announcement-bar__marquee-separator" aria-hidden="true" data-icon-default="•" data-icon-halloween="🦇"></span><span class="announcement-bar__marquee-item">{{ announcement_message_3 }}</span>{% endif %}
  {% if announcement_message_4 != blank %}<span class="announcement-bar__marquee-separator" aria-hidden="true" data-icon-default="•" data-icon-halloween="👻"></span><span class="announcement-bar__marquee-item">{{ announcement_message_4 }}</span>{% endif %}
{%- endcapture -%}
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }}"
  aria-label="Store announcements"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-marquee-duration: {{ announcement_marquee_duration }}s;{% if section.settings.background_color != blank %} --announcement-background-color: {{ section.settings.background_color }};{% endif %}{% if announcement_background_image_url != blank %} --announcement-bg-image: url('{{ announcement_background_image_url }}');{% endif %}{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__slider">
    <div class="announcement-bar__marquee" aria-label="Store announcements">
      <div class="announcement-bar__marquee-track">
        <div class="announcement-bar__marquee-content">
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true" inert>
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true" inert>
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true" inert>
          {{ announcement_marquee_items }}
        </div>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    --announcement-text-color: #3a281a;
    --announcement-text-rgb: 58 40 26;
    --announcement-promo-color: #5c3b24;

    position: relative;
    min-height: 36px;
    display: flex;
    align-items: center;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background: var(--announcement-background-color, #faebe0);
    color: var(--announcement-text-color);
    overflow: hidden;
    isolation: isolate;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    pointer-events: none;
  }

  .announcement-bar::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--announcement-bg-image, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.95;
  }

  .announcement-bar::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    height: 1px;
    background: rgba(0, 0, 0, 0.06);
  }

  .announcement-bar__slider {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
    min-height: inherit;
  }

  .announcement-bar__marquee {
    width: 100%;
    min-height: inherit;
    overflow: hidden;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .announcement-bar__marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: announcement-marquee var(--announcement-marquee-duration, 30s) linear infinite;
  }

  .announcement-bar__marquee-content {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding-inline-end: clamp(1.2rem, 3vw, 2.4rem);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .announcement-bar__marquee-item,
  .announcement-bar__marquee-separator {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading--family);
    font-size: clamp(0.76rem, 0.85vw, 0.88rem);
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: none;
  }

  .announcement-bar__marquee-item {
    color: var(--announcement-text-color);
    text-shadow: none;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .announcement-bar:hover .announcement-bar__marquee-item {
    color: #120b06;
    text-shadow: none;
  }

  .announcement-bar__marquee-item--promo {
    color: #ffffff;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 122, 0, 0.85) 0%, rgba(186, 85, 211, 0.85) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      0 0 10px rgba(255, 122, 0, 0.6);
  }

  .announcement-bar__marquee-separator::before {
    content: attr(data-icon-default);
    color: #6e5746;
    font-size: 1em;
    opacity: 0.85;
  }

  /* Halloween Theme Styles Override */
  [data-seasonal-theme="halloween"] .announcement-bar {
    --announcement-text-color: #ffffff;
    --announcement-text-rgb: 255 255 255;
    background:
      radial-gradient(circle at top center, rgba(255, 122, 0, 0.18), transparent 70%),
      linear-gradient(90deg, #0f0718 0%, #1e0b2e 50%, #0f0718 100%);
    border-bottom-color: rgba(255, 122, 0, 0.4);
  }

  [data-seasonal-theme="halloween"] .announcement-bar .announcement-bar__marquee-item {
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8), 0 0 4px rgba(255, 122, 0, 0.35);
  }

  [data-seasonal-theme="halloween"] .announcement-bar:hover .announcement-bar__marquee-item {
    color: #ffffff;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9), 0 0 6px rgba(255, 122, 0, 0.5);
  }

  [data-seasonal-theme="halloween"] .announcement-bar__marquee-separator::before {
    content: attr(data-icon-halloween);
    font-size: 0.9em;
    padding: 0 0.15rem;
    opacity: 0.8;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.7));
    transition: opacity 0.3s ease, filter 0.3s ease;
    display: inline-block;
    animation: halloween-icon-pulse 2.8s ease-in-out infinite alternate;
  }

  [data-seasonal-theme="halloween"] .announcement-bar:hover .announcement-bar__marquee-separator::before {
    opacity: 1;
  }

  @keyframes halloween-icon-pulse {
    0% {
      transform: scale(0.95) rotate(-5deg);
    }
    50% {
      transform: scale(1.05) rotate(0deg);
    }
    100% {
      transform: scale(1) rotate(5deg);
    }
  }

  .announcement-bar:hover .announcement-bar__marquee-track,
  .announcement-bar:focus-within .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes announcement-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }

    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar {
      min-height: 30px;
    }

    .announcement-bar__slider {
      min-height: inherit;
    }

    .announcement-bar__marquee-content {
      gap: 0.85rem;
      padding-inline-end: 0.85rem;
    }

    .announcement-bar__marquee-item,
    .announcement-bar__marquee-separator {
      font-size: clamp(0.7rem, 2.2vw, 0.78rem);
    }

    .announcement-bar__marquee-item--promo {
      padding: 0.05rem 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track,
    .announcement-bar__marquee-separator::before {
      animation: none;
    }

    .announcement-bar__marquee-track {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 10,
      "max": 40,
      "default": 20,
      "unit": "sec"
    },
    {
      "type": "inline_richtext",
      "id": "message_1",
      "label": "Message 1",
      "default": "Free U.S. & Canada Shipping • International Shipping $5.99"
    },
    {
      "type": "inline_richtext",
      "id": "message_2",
      "label": "Message 2",
      "default": "Made From Your Ideas"
    },
    {
      "type": "inline_richtext",
      "id": "message_3",
      "label": "Message 3",
      "default": "Turn Photos, Names & Favorite Memories Into Cozy Bedding"
    },
    {
      "type": "inline_richtext",
      "id": "message_4",
      "label": "Message 4",
      "default": "Exclusive Deals & Offers"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar"
    }
  ]
}
{% endschema %}
