
{% liquid
  assign announcement_background_image_url = 'bg-announcement.webp' | asset_url
  if section.settings.background_image != blank
    assign announcement_background_image_url = section.settings.background_image | image_url: width: 2400
  endif
%}

<link
  rel="preload"
  as="image"
  href="{{ announcement_background_image_url }}"
>

{%- capture announcement_marquee_items -%}
  <span class="announcement-bar__marquee-item">Free Shipping On All Orders</span>
  <span class="announcement-bar__marquee-separator announcement-bar__marquee-separator--halloween" aria-hidden="true">🎃</span>
  <span class="announcement-bar__marquee-item">Made From Your Ideas</span>
  <span class="announcement-bar__marquee-separator announcement-bar__marquee-separator--halloween" aria-hidden="true">🦇</span>
  <span class="announcement-bar__marquee-item">Turn Photos, Names &amp; Favorite Memories Into Cozy Bedding</span>
  <span class="announcement-bar__marquee-separator announcement-bar__marquee-separator--halloween" aria-hidden="true">👻</span>
  <span class="announcement-bar__marquee-item">Exclusive Deals &amp; Offers</span>
  <span class="announcement-bar__marquee-separator announcement-bar__marquee-separator--halloween" aria-hidden="true">🕷️</span>
{%- endcapture -%}
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-bg-image: url('{{ announcement_background_image_url }}');{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__slider" aria-live="polite">
    <div class="announcement-bar__marquee" aria-label="Store announcements">
      <div class="announcement-bar__marquee-track">
        <div class="announcement-bar__marquee-content">
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true">
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true">
          {{ announcement_marquee_items }}
        </div>
        <div class="announcement-bar__marquee-content" aria-hidden="true">
          {{ announcement_marquee_items }}
        </div>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    --announcement-text-color: #ffffff;
    --announcement-text-rgb: 255 255 255;
    --announcement-promo-color: #ffaa00;

    position: relative;
    min-height: 36px;
    display: flex;
    align-items: center;
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background:
      radial-gradient(circle at top center, rgba(255, 122, 0, 0.18), transparent 70%),
      linear-gradient(90deg, #0f0718 0%, #1e0b2e 50%, #0f0718 100%);
    color: var(--announcement-text-color);
    border-bottom-color: rgba(255, 122, 0, 0.4);
    overflow: hidden;
    isolation: isolate;
  }

  .announcement-bar::before,
  .announcement-bar::after {
    content: '';
    pointer-events: none;
  }

  .announcement-bar::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--announcement-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.9;
  }

  .announcement-bar::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  .announcement-bar__slider {
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 1;
    min-height: inherit;
  }

  .announcement-bar__marquee {
    width: 100%;
    min-height: inherit;
    overflow: hidden;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .announcement-bar__marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    animation: announcement-marquee 30s linear infinite;
  }

  .announcement-bar__marquee-content {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding-inline-end: clamp(1.2rem, 3vw, 2.4rem);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .announcement-bar__marquee-item,
  .announcement-bar__marquee-separator {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading--family);
    font-size: clamp(0.76rem, 0.85vw, 0.88rem);
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: none;
  }

  .announcement-bar__marquee-item {
    color: var(--announcement-text-color);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8), 0 0 4px rgba(255, 122, 0, 0.35);
    transition: text-shadow 0.3s ease, color 0.3s ease;
  }

  .announcement-bar:hover .announcement-bar__marquee-item {
    color: #ffffff;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.9), 0 0 6px rgba(255, 122, 0, 0.5);
  }

  .announcement-bar__marquee-item--promo {
    color: #ffffff;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 122, 0, 0.85) 0%, rgba(186, 85, 211, 0.85) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.4),
      0 0 10px rgba(255, 122, 0, 0.6);
  }

  .announcement-bar__marquee-separator--halloween {
    font-size: 0.95em;
    padding: 0 0.15rem;
    filter: drop-shadow(0 0 4px rgba(255, 122, 0, 0.7));
    animation: halloween-icon-pulse 2.4s ease-in-out infinite alternate;
  }

  @keyframes halloween-icon-pulse {
    0% {
      transform: scale(0.92) rotate(-6deg);
      filter: drop-shadow(0 0 3px rgba(255, 122, 0, 0.5));
    }
    50% {
      transform: scale(1.1) rotate(0deg);
      filter: drop-shadow(0 0 6px rgba(255, 165, 0, 0.9));
    }
    100% {
      transform: scale(1) rotate(6deg);
      filter: drop-shadow(0 0 5px rgba(186, 85, 211, 0.7));
    }
  }

  .announcement-bar:hover .announcement-bar__marquee-track,
  .announcement-bar:focus-within .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  @keyframes announcement-marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }

    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar {
      min-height: 30px;
    }

    .announcement-bar__slider {
      min-height: inherit;
    }

    .announcement-bar__marquee-track {
      animation-duration: 25s;
    }

    .announcement-bar__marquee-content {
      gap: 0.85rem;
      padding-inline-end: 0.85rem;
    }

    .announcement-bar__marquee-item,
    .announcement-bar__marquee-separator {
      font-size: clamp(0.7rem, 2.2vw, 0.78rem);
    }

    .announcement-bar__marquee-item--promo {
      padding: 0.05rem 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
