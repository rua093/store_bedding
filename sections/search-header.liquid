

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign hero_image = section.settings.hero_image | default: section.settings.fallback_hero_image
  assign eyebrow_text = section.settings.eyebrow | default: 'Search results'
  assign heading_text = section.settings.heading | default: 'Cozy finds'
  assign subtitle_text = section.settings.subtitle | default: 'Made for moments that matter.'
  assign fallback_text = section.settings.fallback_text | default: 'Search blankets, quilts, comforters and more.'
  assign overlay_primary = section.settings.overlay_strength | plus: 12 | at_most: 100
  assign overlay_secondary = section.settings.overlay_strength | plus: 4 | at_most: 100
  assign overlay_tertiary = section.settings.overlay_strength | minus: 22 | at_least: 0
  assign overlay_edge = section.settings.overlay_strength | minus: 60 | at_least: 0
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <section
    id="JemSearchHero-{{ section.id }}"
    class="spacing-style jem-search-hero-section"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div class="jem-search-hero">
      <div class="jem-search-hero__media" aria-hidden="true">
        {% if hero_image != blank %}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              alt: '',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 1800, 2200, 2400',
              sizes: '(min-width: 990px) 1200px, 100vw',
              class: 'jem-search-hero__image'
          }}
        {% else %}
          <img
            src="{{ 'media-brand-intro-1600.webp' | asset_url }}"
            srcset="{{ 'media-brand-intro-1600.webp' | asset_url }} 1600w, {{ 'media-brand-intro-2400.webp' | asset_url }} 2400w"
            sizes="(min-width: 990px) 1200px, 100vw"
            alt=""
            loading="eager"
            fetchpriority="high"
            class="jem-search-hero__image"
          >
        {% endif %}
      </div>
      <div class="jem-search-hero__overlay" aria-hidden="true"></div>

      <div class="jem-search-hero__inner">
        <div class="jem-search-hero__content">
          {% if eyebrow_text != blank %}
            <p class="jem-search-hero__eyebrow">{{ eyebrow_text }}</p>
          {% endif %}
          <h1 class="jem-search-hero__title">
            {% if search.performed and search.terms != blank %}
              Search results for "{{ search.terms | remove: '*' | escape }}"
            {% elsif heading_text != blank %}
              {{ heading_text }}
            {% endif %}
          </h1>
          {% if subtitle_text != blank %}
            <p class="jem-search-hero__subtitle">{{ subtitle_text }}</p>
          {% endif %}

          {% if search.performed and search.terms != blank and section.settings.show_results_count %}
            <p class="jem-search-hero__meta">
              {{ search.results_count }} results for "{{ search.terms | remove: '*' | escape }}"
            </p>
          {% elsif fallback_text != blank %}
            <p class="jem-search-hero__meta">{{ fallback_text }}</p>
          {% endif %}
        </div>

        <div class="jem-search-hero__search">
          {% content_for 'block', id: 'search', type: '_search-input' %}
        </div>
      </div>
    </div>

  </section>
</div>

{% style %}
  #JemSearchHero-{{ section.id }} {
    display: block;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero {
    position: relative;
    min-height: clamp(222px, 17vw, 238px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: linear-gradient(135deg, #18120e 0%, #261c15 100%);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.22);
    isolation: isolate;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__media,
  #JemSearchHero-{{ section.id }} .jem-search-hero__overlay {
    position: absolute;
    inset: 0;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__overlay {
    background:
      linear-gradient(
        90deg,
        rgb(20 14 10 / {{ overlay_primary }}%) 0%,
        rgb(24 17 12 / {{ overlay_secondary }}%) 32%,
        rgb(26 18 13 / {{ overlay_tertiary }}%) 64%,
        rgb(26 18 13 / {{ overlay_edge }}%) 100%
      ),
      linear-gradient(180deg, rgb(0 0 0 / 38%), rgb(0 0 0 / 10%));
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
    gap: 24px;
    align-items: center;
    min-height: inherit;
    padding: clamp(22px, 3.2vw, 34px);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__content {
    max-width: 400px;
    color: #ffffff;
    min-width: 0;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__eyebrow {
    margin: 0 0 10px;
    color: #e5a880;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__title {
    margin: 0;
    color: #ffffff;
    font-size: clamp(3rem, 3vw, 3.25rem);
    line-height: 0.96;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__subtitle {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.98rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__meta {
    margin: 10px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.94rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__search {
    width: 100%;
    max-width: 440px;
    justify-self: end;
    min-width: 0;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__search .search-page-input__parent {
    align-items: stretch;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__search search-page-input-component {
    max-width: 100%;
    margin: 0;
    border-radius: 999px;
    background: rgb(255 253 251 / 90%);
    box-shadow: 0 10px 24px rgb(75 52 37 / 8%);
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__search .search-page-input {
    min-height: 60px;
    border-radius: 999px;
    border-color: rgba(116, 82, 58, 0.1);
    background: #fffdfb;
    color: #2f241d;
  }

  #JemSearchHero-{{ section.id }} .jem-search-hero__search .search__icon svg,
  #JemSearchHero-{{ section.id }} .jem-search-hero__search .search__reset-button svg {
    color: #7b6657;
  }

  @media screen and (max-width: 1199px) {
    #JemSearchHero-{{ section.id }} .jem-search-hero {
      min-height: 230px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
      padding: 24px 28px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__title {
      font-size: clamp(2.5rem, 3.8vw, 2.7rem);
    }
  }

  @media screen and (max-width: 989px) {
    #JemSearchHero-{{ section.id }} .jem-search-hero {
      min-height: clamp(220px, 30vw, 236px);
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(250px, 340px);
      gap: 16px 20px;
      padding: 24px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__content {
      max-width: 360px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__title {
      font-size: clamp(2.5rem, 5vw, 2.75rem);
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__search {
      align-self: center;
      max-width: 340px;
    }
  }

  @media screen and (max-width: 749px) {
    #JemSearchHero-{{ section.id }} .jem-search-hero {
      min-height: 210px;
      border-radius: 22px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__media {
      inset: 0;
      height: auto;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__overlay {
      background:
        linear-gradient(180deg, rgb(18 12 8 / 94%) 0%, rgb(22 15 10 / 84%) 55%, rgb(18 12 8 / 45%) 100%),
        linear-gradient(90deg, rgb(18 12 8 / 88%) 0%, rgb(18 12 8 / 30%) 100%);
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      align-content: space-between;
      padding: 16px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__content {
      max-width: 100%;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__eyebrow {
      margin-bottom: 8px;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__title {
      font-size: clamp(1.9rem, 8.2vw, 2.125rem);
      line-height: 0.95;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__search {
      justify-self: stretch;
      max-width: 100%;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__search search-page-input-component {
      box-shadow: 0 8px 20px rgb(75 52 37 / 7%);
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__search .search-page-input {
      min-height: 48px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__subtitle,
    #JemSearchHero-{{ section.id }} .jem-search-hero__meta {
      font-size: 0.81rem;
      line-height: 1.35;
    }
  }

  @media screen and (max-width: 479px) {
    #JemSearchHero-{{ section.id }} .jem-search-hero {
      min-height: 204px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__inner {
      padding: 14px;
      gap: 10px;
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__title {
      font-size: clamp(1.875rem, 9vw, 2rem);
    }

    #JemSearchHero-{{ section.id }} .jem-search-hero__search .search-page-input {
      min-height: 46px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "fallback_hero_image",
      "label": "Fallback banner image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Search results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cozy finds"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Made for moments that matter."
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text before search",
      "default": "Search blankets, quilts, comforters and more."
    },
    {
      "type": "checkbox",
      "id": "show_results_count",
      "label": "Show search results count",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Overlay strength",
      "min": 70,
      "max": 96,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center right",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center right",
          "label": "Right"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Search hero"
    }
  ]
}
{% endschema %}
