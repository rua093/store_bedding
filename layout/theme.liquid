<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <link
      rel="icon"
      href="{{ 'favicon.ico' | asset_url }}"
      sizes="any"
    >
    <link
      rel="icon"
      type="image/svg+xml"
      href="{{ 'favicon.svg' | asset_url }}"
    >
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="{{ 'favicon-96x96.png' | asset_url }}"
    >
    <link
      rel="shortcut icon"
      href="{{ 'favicon.ico' | asset_url }}"
      type="image/x-icon"
    >
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="{{ 'apple-touch-icon.png' | asset_url }}"
    >
    <link
      rel="manifest"
      href="{{ 'site.webmanifest' | asset_url }}"
    >

    {%- if request.page_type == 'collection' and collection != blank -%}
      {%- liquid
        assign collection_hero_preload_image = collection.metafields.custom.banner_img.value
        if collection_hero_preload_image == blank
          assign collection_hero_preload_image = collection.image
        endif
      -%}
      {%- if collection_hero_preload_image != blank -%}
        <link
          rel="preload"
          as="image"
          href="{{ collection_hero_preload_image | image_url: width: 1920 }}"
          imagesrcset="
            {{ collection_hero_preload_image | image_url: width: 750 }} 750w,
            {{ collection_hero_preload_image | image_url: width: 1100 }} 1100w,
            {{ collection_hero_preload_image | image_url: width: 1500 }} 1500w,
            {{ collection_hero_preload_image | image_url: width: 1800 }} 1800w,
            {{ collection_hero_preload_image | image_url: width: 2100 }} 2100w,
            {{ collection_hero_preload_image | image_url: width: 2400 }} 2400w,
            {{ collection_hero_preload_image | image_url: width: 2880 }} 2880w,
            {{ collection_hero_preload_image | image_url: width: 3200 }} 3200w,
            {{ collection_hero_preload_image | image_url: width: 3840 }} 3840w
          "
          imagesizes="100vw"
          fetchpriority="high"
        >
      {%- elsif collection.handle == 'all' -%}
        {%- liquid
          assign all_collection_preload_image = 'bg-product.webp' | asset_url
          if settings.all_collection_fallback_image != blank
            assign all_collection_preload_image = settings.all_collection_fallback_image | image_url: width: 1920
          endif
        -%}
        <link
          rel="preload"
          as="image"
          href="{{ all_collection_preload_image }}"
          fetchpriority="high"
        >
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'product' and product != blank -%}
      {%- liquid
        assign product_media_preload_image = product.selected_or_first_available_variant.featured_media.preview_image
        if product_media_preload_image == blank
          assign product_media_preload_image = product.featured_media.preview_image
        endif
      -%}
      {%- if product_media_preload_image != blank -%}
        <link
          rel="preload"
          as="image"
          href="{{ product_media_preload_image | image_url: width: 1920 }}"
          imagesrcset="
            {{ product_media_preload_image | image_url: width: 352 }} 352w,
            {{ product_media_preload_image | image_url: width: 832 }} 832w,
            {{ product_media_preload_image | image_url: width: 1200 }} 1200w,
            {{ product_media_preload_image | image_url: width: 1600 }} 1600w,
            {{ product_media_preload_image | image_url: width: 1920 }} 1920w,
            {{ product_media_preload_image | image_url: width: 2560 }} 2560w,
            {{ product_media_preload_image | image_url: width: 3200 }} 3200w,
            {{ product_media_preload_image | image_url: width: 3840 }} 3840w
          "
          imagesizes="(min-width: 750px) 50vw, 100vw"
          fetchpriority="high"
        >
      {%- endif -%}
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% unless request.page_type == 'index' or template == 'index' %}
      <style>
        shopify-chat,
        #chat-drawer,
        .shopify-chat-host {
          display: none !important;
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
        }
      </style>
    {% endunless %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  {% liquid
    assign active_seasonal_theme = ''
    assign page_bg_image = nil
    assign page_bg_image_url = ''
    assign page_bg_tile_width = 1200

    if request.page_type == 'collection' and collection != blank
      if collection.metafields.custom.seasonal_theme != blank
        assign active_seasonal_theme = collection.metafields.custom.seasonal_theme.value | downcase | strip
      elsif collection.handle contains 'halloween'
        assign active_seasonal_theme = 'halloween'
      endif
      assign page_bg_image = collection.metafields.custom.page_bg.value
      if page_bg_image != blank
        assign page_bg_image_url = page_bg_image | image_url: width: 2400
        assign page_bg_tile_width = page_bg_image.width | divided_by: 2 | at_most: 1200
      endif
    elsif request.page_type == 'product' and product != blank
      if product.metafields.custom.seasonal_theme != blank
        assign active_seasonal_theme = product.metafields.custom.seasonal_theme.value | downcase | strip
      else
        for col in product.collections
          if col.metafields.custom.seasonal_theme != blank
            assign active_seasonal_theme = col.metafields.custom.seasonal_theme.value | downcase | strip
            break
          elsif col.handle contains 'halloween'
            assign active_seasonal_theme = 'halloween'
            break
          endif
        endfor
      endif

      if active_seasonal_theme == 'halloween'
        assign page_bg_image_url = 'pdp-bg.webp' | asset_url
        assign page_bg_tile_width = 627
      endif

    endif
  %}

  {% if page_bg_image_url != blank %}
    <style>
      #MainContent {
        background-image: url('{{ page_bg_image_url }}') !important;
        background-repeat: repeat !important;
        background-position: top center !important;
        background-size: min(100%, {{ page_bg_tile_width }}px) auto !important;
        background-attachment: scroll !important;
      }

      #MainContent .shopify-section,
      #MainContent .section-background,
      #MainContent .product-recommendations--pdp-related-skin {
        background-color: transparent !important;
      }

      #MainContent .product-recommendations--pdp-related-skin::before {
        display: none !important;
      }

      {% if request.page_type == 'product' %}
        #MainContent #judgeme_product_reviews {
          padding: clamp(24px, 4vw, 48px) clamp(16px, 3vw, 36px) !important;
          border: 1px solid rgba(120, 84, 58, 0.16) !important;
          border-radius: 18px !important;
          background: linear-gradient(
            180deg,
            rgba(255, 252, 247, 0.97) 0%,
            rgba(255, 248, 240, 0.95) 100%
          ) !important;
          box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.62),
            0 14px 32px rgba(74, 45, 28, 0.08) !important;
        }

        #MainContent #judgeme_product_reviews .jdgm-review-card,
        #MainContent #judgeme_product_reviews .jdgm-review-card__content {
          background: #fffaf4 !important;
        }

        @media screen and (max-width: 749px) {
          #MainContent #judgeme_product_reviews {
            padding: 22px 14px !important;
            border-radius: 14px !important;
          }
        }
      {% endif %}
    </style>
  {% endif %}

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}"{% if active_seasonal_theme != blank %} data-seasonal-theme="{{ active_seasonal_theme }}"{% endif %}>
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% if request.page_type == 'index' or template == 'index' %}
      {% render 'chat-drawer' %}
    {% endif %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const isMobileMenuViewport = window.matchMedia('(max-width: 989px)').matches;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || isMobileMenuViewport || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    <button
      type="button"
      class="back-to-top-button back-to-top-button--bubble"
      aria-label="Back to top"
      data-back-to-top
      aria-hidden="true"
      style="opacity:0;visibility:hidden;"
    >
      <span class="back-to-top-button__icon" aria-hidden="true">↑</span>
    </button>

    {{ 'dialog-modal.css' | asset_url | stylesheet_tag }}

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% if request.page_type == 'index' or template == 'index' %}
      {% render 'discount-popup' %}
    {% endif %}

    <style>
      :root {
        --floating-action-right: clamp(1.15rem, 2vw, 1.65rem);
        --floating-action-bottom: 1rem;
        --floating-action-size: 3.45rem;
        --floating-action-gap: 0.8rem;
      }

      /* Back to top is aligned to Shopify Chat's launcher using shared floating action variables. Shopify Chat itself is a web component, so we do not wrap/move it. */
      .back-to-top-button {
        position: fixed;
        right: var(--floating-action-right);
        bottom: calc(
          var(--floating-action-bottom)
          + var(--floating-action-size)
          + var(--floating-action-gap)
          + env(safe-area-inset-bottom)
        );
        z-index: 120;
        display: inline-grid;
        place-items: center;
        width: var(--floating-action-size);
        height: var(--floating-action-size);
        min-height: var(--floating-action-size);
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: #120b08;
        box-shadow:
          0 14px 30px rgb(18 11 8 / 0.28),
          0 0 0 1px rgb(255 255 255 / 0.08) inset;
        color: #ffffff;
        font: inherit;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.85rem) scale(0.96);
        transition:
          opacity 180ms ease,
          transform 180ms ease,
          visibility 180ms ease,
          box-shadow 180ms ease,
          background-color 180ms ease;
      }

      .back-to-top-button.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
      }

      .back-to-top-button:hover {
        background: #1b110d;
        box-shadow:
          0 18px 34px rgb(18 11 8 / 0.34),
          0 0 0 1px rgb(255 255 255 / 0.12) inset;
      }

      .back-to-top-button:focus-visible {
        outline: 2px solid rgb(255 255 255 / 0.78);
        outline-offset: 3px;
      }

      .back-to-top-button__icon {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        color: #ffffff;
        font-size: 1.38rem;
        font-weight: 500;
        line-height: 1;
      }

      @media screen and (max-width: 989px) {
        .back-to-top-button {
          display: none !important;
        }
      }

      @media screen and (max-width: 749px) {
        :root {
          --floating-action-right: 0.72rem;
          --floating-action-bottom: 1rem;
          --floating-action-size: 3rem;
          --floating-action-gap: 0.72rem;
        }

        .back-to-top-button {
          width: 3rem;
          height: 3rem;
          min-height: 3rem;
          padding: 0;
          font-size: 0.82rem;
        }

        .back-to-top-button__icon {
          font-size: 1.15rem;
        }
      }

      @media screen and (max-width: 480px) {
        :root {
          --floating-action-right: 0.72rem;
          --floating-action-bottom: 1rem;
          --floating-action-size: 3rem;
          --floating-action-gap: 0.72rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .back-to-top-button {
          transition: opacity 1ms linear, visibility 1ms linear;
        }
      }
    </style>

    <script>
      (function initBackToTopButton() {
        const button = document.querySelector('[data-back-to-top]');
        const pageWrapper = document.querySelector('.page-wrapper');
        if (!button) return;

        const setVisible = (visible) => {
          button.classList.toggle('is-visible', Boolean(visible));
          button.setAttribute('aria-hidden', visible ? 'false' : 'true');
        };

        const scrollToTop = () => {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const behavior = reduceMotion ? 'auto' : 'smooth';

          if (pageWrapper && pageWrapper.scrollHeight > pageWrapper.clientHeight) {
            pageWrapper.scrollTo({ top: 0, behavior });
          }

          window.scrollTo({ top: 0, behavior });
        };

        button.style.removeProperty('opacity');
        button.style.removeProperty('visibility');
        button.addEventListener('click', scrollToTop);

        // Create sentinel for IntersectionObserver to avoid scroll listeners
        const sentinel = document.createElement('div');
        sentinel.style.cssText = 'position: absolute; top: 360px; left: 0; width: 1px; height: 1px; visibility: hidden; pointer-events: none; z-index: -999;';

        if (pageWrapper) {
          pageWrapper.appendChild(sentinel);
        } else {
          document.body.appendChild(sentinel);
        }

        let observer = null;
        const mediaQuery = window.matchMedia('(min-width: 990px)');

        const setupObserver = () => {
          if (observer) {
            observer.disconnect();
          }

          const root = (mediaQuery.matches && pageWrapper) ? pageWrapper : null;

          observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              setVisible(!entry.isIntersecting);
            });
          }, {
            root: root,
            threshold: 0
          });

          observer.observe(sentinel);
        };

        setupObserver();
        if (typeof mediaQuery.addEventListener === 'function') {
          mediaQuery.addEventListener('change', setupObserver);
        } else {
          mediaQuery.addListener(setupObserver);
        }
      })();
    </script>
  </body>
</html>
