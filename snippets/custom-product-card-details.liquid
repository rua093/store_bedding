{% doc %}
  Renders the textual content area for the custom product card.

  @param {product} product
  @param {string} product_display_title
  @param {string} contextual_content_class
  @param {string} contextual_title_class
  @param {string} contextual_price_row_class
  @param {string} contextual_price_class
  @param {string} contextual_compare_class
  @param {number} current_price
  @param {number} compare_price
  @param {boolean} show_compare_price
  @param {number} total_rating_count
{% enddoc %}

<div class="custom-product-card__content{% if contextual_content_class != blank %} {{ contextual_content_class }}{% endif %}">
  <h3 class="custom-product-card__title{% if contextual_title_class != blank %} {{ contextual_title_class }}{% endif %}">
    {{ product_display_title | strip }}
  </h3>
  <div class="custom-product-card__price-row{% if contextual_price_row_class != blank %} {{ contextual_price_row_class }}{% endif %}">
    <span class="custom-product-card__price{% if contextual_price_class != blank %} {{ contextual_price_class }}{% endif %}">
      {{ current_price | money }}
    </span>
    {% if show_compare_price %}
      <span class="custom-product-card__compare{% if contextual_compare_class != blank %} {{ contextual_compare_class }}{% endif %}">
        {{ compare_price | money }}
      </span>
    {% endif %}
  </div>
  {% if total_rating_count > 0 %}
    <div
      class="custom-product-card__rating"
      aria-label="4.5 out of 5 stars from {{ total_rating_count }} reviews"
    >
      <svg
        class="visually-hidden"
        style="width: 0; height: 0;"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        role="presentation"
      >
        <defs>
          <linearGradient id="custom-product-card-half-{{ product.id }}" x1="0" x2="100%" y1="0" y2="0">
            <stop offset="50%" stop-color="#f4b400"></stop>
            <stop offset="50%" stop-color="rgba(244, 180, 0, 0.2)"></stop>
          </linearGradient>
          <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="custom-product-card-star-{{ product.id }}">
            <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
          </symbol>
        </defs>
      </svg>
      <div class="custom-product-card__rating-stars" aria-hidden="true">
        {%- for star in (1..4) -%}
          <svg class="custom-product-card__rating-star is-filled" viewBox="0 0 32 32" role="presentation">
            <use xlink:href="#custom-product-card-star-{{ product.id }}"></use>
          </svg>
        {%- endfor -%}
        <svg class="custom-product-card__rating-star is-filled" viewBox="0 0 32 32" role="presentation">
          <use xlink:href="#custom-product-card-star-{{ product.id }}" fill="url(#custom-product-card-half-{{ product.id }})"></use>
        </svg>
      </div>
      <span class="custom-product-card__rating-count">({{ total_rating_count }})</span>
    </div>
  {% endif %}
</div>
