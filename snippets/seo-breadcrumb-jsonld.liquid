{% liquid
  assign breadcrumb_page_type = request.page_type
  assign breadcrumb_collection = nil
  assign render_breadcrumbs = false

  if breadcrumb_page_type == 'product' and product != blank
    assign render_breadcrumbs = true
    if collection != blank and collection.handle != blank and collection.handle != 'all'
      for product_collection in product.collections
        if product_collection.handle == collection.handle
          assign breadcrumb_collection = collection
          break
        endif
      endfor
    endif
  elsif breadcrumb_page_type == 'collection' and collection != blank
    assign render_breadcrumbs = true
  elsif breadcrumb_page_type == 'article' and article != blank and blog != blank
    assign render_breadcrumbs = true
  elsif breadcrumb_page_type == 'page' and page != blank
    assign render_breadcrumbs = true
  endif
%}

{% if render_breadcrumbs %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'Home' | json }},
          "item": {{ request.origin | json }}
        }
        {% if breadcrumb_page_type == 'product' %}
          {% if breadcrumb_collection != blank %}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ breadcrumb_collection.title | json }},
              "item": {{ request.origin | append: breadcrumb_collection.url | json }}
            }
            ,{
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ request.origin | append: product.url | json }}
            }
          {% else %}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ request.origin | append: product.url | json }}
            }
          {% endif %}
        {% elsif breadcrumb_page_type == 'collection' %}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          }
        {% elsif breadcrumb_page_type == 'article' %}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ request.origin | append: blog.url | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | json }},
            "item": {{ request.origin | append: article.url | json }}
          }
        {% elsif breadcrumb_page_type == 'page' %}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": {{ request.origin | append: page.url | json }}
          }
        {% endif %}
      ]
    }
  </script>
{% endif %}
