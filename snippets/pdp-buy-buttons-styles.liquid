{%- doc -%}
  Product-page-only buy-buttons layout and visual treatment.

  Keeps PDP-specific quantity / CTA / trust-badges / customizer rules in one
  place so they do not compete with shared buy-button styles.
{%- enddoc -%}

{% stylesheet %}
  .product-information--main-product .product-details--main-product .buy-buttons-block {
    --buy-box-background: rgba(255, 250, 244, 0.8);
    --buy-box-border: rgba(92, 61, 42, 0.1);
    --buy-box-shadow: none;
    --pdp-buy-buttons-gap: clamp(8px, 1.6cqi, 12px);
    --pdp-quantity-column: minmax(116px, 124px);
    --pdp-buy-control-height: 48px;
    --shopify-accelerated-checkout-button-block-size: var(--pdp-buy-control-height) !important;

    container-type: inline-size;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block,
  .product-information--main-product .product-details--main-product .buy-buttons-block .product-form-buttons,
  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .product-form-buttons
    > :is(.quantity-selector-wrapper, .product-form-customize, span:has(.add-to-cart-button), .accelerated-checkout-block, .product-form-trust-badges) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .product-form-buttons {
    display: grid;
    grid-auto-flow: row;
    gap: 12px;
    align-items: stretch;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .product-form-buttons::before {
    content: 'Quantity';
    grid-column: 1 / -1;
    display: block;
    margin-bottom: 6px;
    color: #000000;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media screen and (max-width: 749px) {
    .product-information--main-product .product-details--main-product .buy-buttons-block .product-form-buttons::before {
      display: none !important;
    }
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-label {
    display: none !important;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector-wrapper {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector-wrapper {
      display: flex !important;
      align-items: center !important;
      gap: 16px !important;
      margin: 0 !important;
      width: auto !important;
      flex-wrap: nowrap !important;
    }

    .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector-wrapper::before {
      content: 'Quantity';
      display: inline-block;
      color: #000000;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
    }

    .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector {
      width: 130px !important;
      min-width: 130px !important;
      max-width: 130px !important;
      height: 44px !important;
      min-height: 44px !important;
      border-radius: 4px !important;
      border: 1.5px solid #000000 !important;
      box-shadow: none !important;
      background: #ffffff !important;
      overflow: hidden !important;
      padding-inline: 0 !important;
    }
  }

  @media screen and (min-width: 750px) {
    .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector-wrapper::before {
      display: none !important;
    }

    .product-information--main-product .product-details--main-product .buy-buttons-block .quantity-selector {
      width: 100% !important;
      max-width: 100% !important;
      height: 48px !important;
      min-height: 48px !important;
      border-radius: 6px !important;
      border: 1.5px solid #000000 !important;
      box-shadow: none !important;
      background: #ffffff !important;
      overflow: hidden !important;
      padding-inline: 0 !important;
    }
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block :is(.add-to-cart-button, .product-form-customize__button),
  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .accelerated-checkout-block
    :is(.shopify-payment-button__button, .shopify-payment-button__button--unbranded),
  .product-information--main-product .product-details--main-product .buy-buttons-block shopify-accelerated-checkout {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: var(--pdp-buy-control-height) !important;
    height: var(--pdp-buy-control-height) !important;
    border-radius: 10px;
    box-sizing: border-box;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .accelerated-checkout-block {
    --shopify-accelerated-checkout-button-block-size: var(--pdp-buy-control-height) !important;

    align-self: start;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .accelerated-checkout-block
    .shopify-payment-button {
    display: block;
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .accelerated-checkout-block
    :is(more-payment-options-link, .shopify-payment-button__more-options) {
    position: static !important;
    display: block;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 8px 0 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #5f4b3f;
    font-size: 0.82rem;
    line-height: 1.3;
    text-align: center;
    transform: none !important;
  }

  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .accelerated-checkout-block
    more-payment-options-link
    a {
    display: inline-block;
    color: inherit;
    line-height: inherit;
    text-underline-offset: 3px;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .add-to-cart-button {
    background: linear-gradient(180deg, #fff 0%, #fff9f2 100%);
    border: 1.5px solid #e56a45;
    color: #e56a45;
    box-shadow: none;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .add-to-cart-button .add-to-cart-icon {
    color: currentColor;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .add-to-cart-button:hover:not([disabled]) {
    background: #fff6ed;
    border-color: #d45c38;
    color: #d45c38;
  }

  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .shopify-payment-button__button--unbranded {
    background: #e56a45;
    border-color: #e56a45;
    color: #fffaf4;
    box-shadow: none;
  }

  .product-information--main-product
    .product-details--main-product
    .buy-buttons-block
    .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    background: #d45c38;
    border-color: #d45c38;
  }

  .product-information--main-product .product-details--main-product .buy-buttons-block .product-form-trust-badges {
    container-type: inline-size;
    grid-column: 1 / -1;
    display: grid;
    gap: 14px;
    width: 100%;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(184, 115, 69, 0.14);
    overflow: hidden;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badges__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    justify-items: stretch;
    align-items: stretch;
    width: 100%;
    margin-inline: auto;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.58rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding-inline: clamp(0.45rem, 1.2vw, 0.75rem);
    color: #000;
    position: relative;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge:not(:last-child)::after {
    content: '';
    display: block;
    position: absolute;
    top: 0.18rem;
    right: 0;
    width: 1px;
    height: calc(100% - 0.36rem);
    background: rgba(184, 115, 69, 0.16);
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    color: #000000;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge__icon :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge__content {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge__title {
    color: #000000;
    font-size: clamp(0.76rem, 1.25vw, 0.9rem);
    line-height: 1.12;
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badge__meta {
    color: #8a7364;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badges__note {
    display: flex;
    position: static;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    min-height: 2.6rem;
    margin-inline: 0;
    padding: 0.68rem 1rem;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 246, 237, 0.92) 100%);
    border: 1px solid rgba(184, 115, 69, 0.12);
    color: #000000;
    font-size: 0.98rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badges__note-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: #000000;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badges__note-icon :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    > .group-block
    > .group-block-content
    > .shopify-app-block {
    position: static !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    clip-path: none !important;
    white-space: normal !important;
    border: 0 !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    > .group-block
    > .group-block-content
    > .shopify-app-block
    .amzcustom-open {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    clip-path: inset(50%) !important;
    white-space: nowrap !important;
    border: 0 !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    .buy-buttons-block
    .product-form-customize__button {
    background: #e56a45;
    border-color: #e56a45;
    color: #fffaf4;
    box-shadow: none;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    .buy-buttons-block
    color: #000000;
  }

  .product-information--main-product .product-details--main-product .product-form-trust-badges__note-icon :is(svg, img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    > .group-block
    > .group-block-content
    > .shopify-app-block {
    position: static !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    overflow: visible !important;
    clip: auto !important;
    clip-path: none !important;
    white-space: normal !important;
    border: 0 !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  .product-information--main-product
    .product-details--main-product.product-details--has-amazon-customizer
    > .group-block
    > .group-block-content
    > .shopify-app-block
    .amzcustom-open {
    position: absolute !important;
