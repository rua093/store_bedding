      height: 18px;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badge__title {
      font-size: clamp(0.8rem, 2.4cqi, 0.92rem);
      line-height: 1.25;
      overflow-wrap: normal;
      word-break: keep-all;
      hyphens: none;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__note {
      display: flex;
      position: static;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      min-height: 0;
      padding: 0.72rem 1rem;
      border-radius: 10px;
      font-size: clamp(0.82rem, 2.5cqi, 0.92rem);
      line-height: 1.35;
      text-align: center;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__note-icon {
      position: static;
