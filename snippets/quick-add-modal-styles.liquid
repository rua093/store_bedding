{%- doc -%}
  Quick-add modal styles consolidated into a single snippet.

  @example
  {% render 'quick-add-modal-styles' %}
{%- enddoc -%}

{% stylesheet %}
  #quick-add-dialog {
    display: contents;
  }

  .quick-add-modal {
    --quick-add-accent: #e56a45;
    --quick-add-accent-hover: #d45c38;
    --quick-add-text: #2f241d;
    --quick-add-muted: #78685d;
    --quick-add-border: rgba(92, 61, 42, 0.16);
    --quick-add-surface: #fffdfb;
    --quick-add-control-radius: 6px;
    --quick-add-panel-radius: 12px;

    width: min(1240px, calc(100vw - 32px)) !important;
    max-width: min(1240px, calc(100vw - 32px)) !important;
    max-height: 88dvh;
    box-sizing: border-box;
    padding: 0;
    border: 1px solid var(--quick-add-border);
    border-radius: var(--quick-add-panel-radius);
    background: var(--quick-add-surface);
    box-shadow: 0 24px 64px rgba(36, 26, 20, 0.22);
    overflow: hidden;
  }

  .quick-add-modal::backdrop {
    background: rgba(32, 24, 19, 0.56);
    backdrop-filter: blur(3px);
  }

  .quick-add-modal[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .quick-add-modal.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .quick-add-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    color: var(--quick-add-text);
    background: rgba(255, 253, 251, 0.96);
    border: 1px solid var(--quick-add-border);
    box-shadow: 0 4px 12px rgba(47, 36, 29, 0.08);
    z-index: 3;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .quick-add-modal__close:hover {
    color: var(--quick-add-accent-hover);
    background: #fff8f3;
    border-color: rgba(229, 106, 69, 0.42);
    box-shadow: 0 5px 14px rgba(47, 36, 29, 0.1);
  }

  .quick-add-modal__close svg {
    width: 16px;
    height: 16px;
  }

  .quick-add-modal__content {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 20px;
    min-height: 0;
    height: min(720px, 88dvh);
    max-height: 88dvh;
    box-sizing: border-box;
    padding: 28px;
    overflow: hidden;
    position: relative;
  }

  .quick-add-modal__content > * {
    min-width: 0;
    min-height: 0;
  }

  .quick-add-modal__main {
    display: grid;
    grid-template-columns: minmax(420px, 0.95fr) minmax(0, 1.05fr);
    gap: 36px;
    align-items: start;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  @keyframes quickAddSkeletonShimmer {
    0% {
      background-position: 100% 0;
    }

    100% {
      background-position: -100% 0;
    }
  }

  .quick-add-modal[data-quick-add-state='loading'] .quick-add-modal__content {
    display: grid;
    grid-template-columns: minmax(420px, 0.95fr) minmax(0, 1.05fr);
    gap: 36px;
    height: min(600px, 84dvh);
    min-height: 420px;
    align-items: stretch;
  }

  .quick-add-modal__skeleton-media,
  .quick-add-modal__skeleton-info {
    display: grid;
    gap: 12px;
  }

  .quick-add-modal__skeleton-main,
  .quick-add-modal__skeleton-thumbs span,
  .quick-add-modal__skeleton-title,
  .quick-add-modal__skeleton-price,
  .quick-add-modal__skeleton-options span,
  .quick-add-modal__skeleton-button {
    background:
      linear-gradient(90deg, rgba(255, 248, 241, 0.95) 0%, rgba(244, 232, 221, 0.95) 45%, rgba(255, 248, 241, 0.95) 100%);
    background-size: 200% 100%;
    animation: quickAddSkeletonShimmer 1.4s ease-in-out infinite;
    border: 1px solid rgba(92, 61, 42, 0.06);
  }

  .quick-add-modal__skeleton-main {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.84);
  }

  .quick-add-modal__skeleton-thumbs {
    display: flex;
    gap: 10px;
    overflow: hidden;
  }

  .quick-add-modal__skeleton-thumbs span {
    width: 60px;
    height: 60px;
    min-width: 60px;
    border-radius: 7px;
  }

  .quick-add-modal__skeleton-info {
    align-content: start;
    padding-top: 8px;
  }

  .quick-add-modal__skeleton-title {
    width: 90%;
    height: 22px;
    border-radius: 4px;
  }

  .quick-add-modal__skeleton-title--short {
    width: 56%;
  }

  .quick-add-modal__skeleton-price {
    width: 36%;
    height: 28px;
    margin-top: 6px;
    border-radius: 4px;
  }

  .quick-add-modal__skeleton-options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 12px;
  }

  .quick-add-modal__skeleton-options span {
    width: 92px;
    height: 42px;
    border-radius: 6px;
  }

  .quick-add-modal__skeleton-button {
    width: 100%;
    height: 50px;
    margin-top: 8px;
    border-radius: 8px;
  }

  .quick-add-modal__skeleton-button--secondary {
    margin-top: 0;
    opacity: 0.88;
  }

  .quick-add-modal[data-quick-add-state='error'] .quick-add-modal__content {
    grid-template-columns: minmax(0, 1fr);
    height: auto;
    min-height: 260px;
    align-items: center;
  }

  .quick-add-modal__error {
    display: grid;
    justify-items: start;
    gap: 10px;
    max-width: 360px;
    padding: 28px;
    border-radius: 10px;
    background: rgba(255, 252, 248, 0.96);
    border: 1px solid rgba(92, 61, 42, 0.1);
    box-shadow: 0 12px 30px rgba(47, 36, 29, 0.08);
  }

  .quick-add-modal__error strong {
    color: #3c2b21;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .quick-add-modal__error span {
    color: #7b6657;
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .quick-add-modal__error-close {
    min-height: 44px;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(92, 61, 42, 0.14);
    border-radius: var(--quick-add-control-radius);
    background: #fff;
    color: #4b382c;
    font-weight: 600;
  }

  .quick-add-modal .quantity-selector-wrapper {
    --color-input-background: rgba(255, 255, 255, 0.92);
    --color-input-text: #2f241d;
    --color-input-text-rgb: 47, 36, 29;
    --color-input-border: rgba(92, 61, 42, 0.16);
    --style-border-width-inputs: 1px;
    --style-border-radius-inputs: var(--quick-add-control-radius);
    --style-border-radius-buttons-primary: 8px;
    --style-border-radius-buttons-secondary: 8px;
  }

  .quick-add-modal__content .product-information__media {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-self: start;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .quick-add-modal__main > .product-information__media {
    grid-column: 1;
    align-self: start;
    width: 100%;
    min-width: 0;
  }

  .quick-add-modal__content .product-information__media media-gallery {
    display: block;
    position: static;
    top: auto;
    width: 100%;
    max-height: none;
    overflow: visible;
    padding: 0;
    pointer-events: auto;
  }

  .quick-add-modal__content .product-information__media slideshow-component,
  .quick-add-modal media-gallery.media-gallery--grid slideshow-component,
  .quick-add-modal media-gallery.media-gallery--carousel slideshow-component {
    display: grid !important;
    grid-template:
      'media' minmax(0, 1fr)
      'controls' auto
      / minmax(0, 1fr) !important;
    gap: 12px;
    position: static;
    width: 100%;
    min-width: 0;
    max-height: none;
    overflow: visible;
  }

  .quick-add-modal media-gallery[data-quick-add-slideshow-ready='true'] .media-gallery__grid {
    display: none !important;
  }

  .quick-add-modal media-gallery:not([data-quick-add-slideshow-ready='true']) .media-gallery__grid {
    display: block !important;
  }

  .quick-add-modal__content .product-information__media slideshow-container,
  .quick-add-modal media-gallery.media-gallery--grid slideshow-container,
  .quick-add-modal media-gallery.media-gallery--carousel slideshow-container {
    display: block;
    grid-area: media !important;
    position: static;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 440px;
    min-height: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--quick-add-border);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .quick-add-modal__content .product-information__media slideshow-slides {
    position: relative;
    top: auto;
    max-height: none;
    width: 100%;
    height: 100%;
    min-height: 100%;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: auto;
    scrollbar-width: none;
  }

  .quick-add-modal__content .product-information__media slideshow-slides::-webkit-scrollbar {
    display: none;
  }

  .quick-add-modal__content .product-information__media slideshow-slide {
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  .quick-add-modal__content .product-information__media .product-media,
  .quick-add-modal__content .product-information__media .product-media > *,
  .quick-add-modal__content .product-information__media .product-media-constraint-wrapper,
  .quick-add-modal__content .product-information__media .product-media img,
  .quick-add-modal__content .product-information__media .product-media video,
  .quick-add-modal__content .product-information__media .product-media iframe,
  .quick-add-modal__content .product-information__media .product-media model-viewer {
    width: 100%;
    height: 100%;
  }

  .quick-add-modal__content .product-information__media .product-media img,
  .quick-add-modal__content .product-information__media .product-media video,
  .quick-add-modal__content .product-information__media .product-media iframe,
  .quick-add-modal__content .product-information__media .product-media model-viewer {
    object-fit: contain;
    border-radius: 0;
  }

  .quick-add-modal__content .product-information__media .product-media-container__zoom-button,
  .quick-add-modal__content .product-information__media slideshow-arrows,
  .quick-add-modal__content .product-information__media .slideshow-controls__arrows {
    display: none;
  }

  .quick-add-modal__content .product-information__media slideshow-controls[thumbnails] {
    grid-area: controls !important;
    position: static !important;
    display: block !important;
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    margin: 0;
    overflow: visible;
  }

  .quick-add-modal__content .product-information__media slideshow-controls[thumbnails][pagination-position='left'],
  .quick-add-modal__content .product-information__media slideshow-controls[thumbnails][pagination-position='right'],
  .quick-add-modal__content .product-information__media slideshow-controls[thumbnails][pagination-position='center'] {
    display: block !important;
    height: auto;
    min-height: 0;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnails-container {
    display: block !important;
    width: 100%;
    height: 62px !important;
    min-height: 62px !important;
    max-height: 62px !important;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    padding: 0;
    cursor: grab;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    mask-image: none !important;
    -webkit-mask-image: none !important;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnails-container::-webkit-scrollbar {
    display: none;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnails-container.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .quick-add-modal__content
    .product-information__media
    .slideshow-controls__thumbnails-container.is-dragging
    .slideshow-controls__thumbnail {
    pointer-events: none;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnails {
    display: flex !important;
    flex-direction: row !important;
    gap: 8px;
    width: max-content;
    margin: 0;
    padding: 2px;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px !important;
    height: 58px !important;
    min-width: 58px !important;
    flex: 0 0 58px !important;
    padding: 0;
    overflow: hidden;
    border-radius: 7px;
    border: 1px solid var(--quick-add-border);
    background: #fff;
    box-shadow: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail img {
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail:hover {
    border-color: rgba(229, 106, 69, 0.56);
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail[aria-selected='true'] {
    border-color: var(--quick-add-accent);
    box-shadow: inset 0 0 0 1px var(--quick-add-accent);
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 5px;
  }

  .quick-add-modal__content .product-information__media .slideshow-controls__thumbnail-badge {
    top: 6px;
    right: 6px;
  }

  .quick-add-modal
    media-gallery:not([data-quick-add-slideshow-ready='true'])
    .media-gallery__grid
    .product-media-container:not(:first-child) {
    display: none !important;
  }

  .quick-add-modal
    media-gallery:not([data-quick-add-slideshow-ready='true'])
    .media-gallery__grid
    .product-media-container:first-child {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--quick-add-border);
  }

  .quick-add-modal__content .product-details {
    display: block;
    align-self: start !important;
    justify-self: stretch;
    margin: 0 !important;
    padding: 0 !important;
    padding-top: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  .quick-add-modal__main > .product-details {
    grid-column: 2;
    align-self: start !important;
    justify-self: stretch;
    margin: 0 !important;
    padding: 0 !important;
    padding-top: 0 !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    display: block !important;
    padding: 0 12px 32px 30px !important;
    border-left: 1px solid rgba(92, 61, 42, 0.12);
    scrollbar-gutter: stable;
    scroll-padding-block-end: 32px;
    box-sizing: border-box;
  }

  .quick-add-modal__content .product-details > .group-block {
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    flex-grow: 0;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .quick-add-modal__content .product-details > .group-block > .group-block-content {
    display: flex !important;
    flex-direction: column !important;
    align-content: start !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    gap: 12px !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    flex-grow: 0;
    margin: 0 !important;
    padding: 0 !important;
    padding-top: 0 !important;
  }

  /* Reset PDP card styling leaks inside quick add only. */
  .quick-add-modal__content .product-details--main-product > .group-block,
  .quick-add-modal__content .product-details--main-product > .group-block > .group-block-content,
  .quick-add-modal__content .product-details--main-product > .group-block > .group-block-content > product-price,
  .quick-add-modal__content .product-details--main-product > .group-block > .group-block-content > variant-picker,
  .quick-add-modal__content .product-details--main-product > .group-block > .group-block-content > .buy-buttons-block {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .quick-add-modal__content .product-details--main-product > .group-block > .group-block-content {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    flex-grow: 0;
  }

  .quick-add-modal .product-details--main-product > .group-block,
  .quick-add-modal .product-details--main-product > .group-block > .group-block-content {
    width: 100% !important;
    max-width: none !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    padding-top: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .quick-add-modal .product-details--main-product > .group-block > .group-block-content {
    --horizontal-alignment: stretch !important;
    --vertical-alignment: flex-start !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    gap: 12px !important;
  }

  .quick-add-modal__content .view-product-title {
    display: block;
    position: static;
    margin: 0 !important;
    padding: 0 48px 0 0 !important;
  }

  .quick-add-modal__content .view-product-title a {
    display: block;
    color: #2f241d;
    text-decoration: none;

    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);

    font-size: clamp(1.7rem, 2.1vw, 2.15rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    overflow: visible;
  }

  .quick-add-modal__content .product-details product-price,
  .quick-add-modal__content .product-details product-price > *,
  .quick-add-modal__content .product-details product-price.text-center,
  .quick-add-modal__content .product-details product-price.text-block--align-center {
    --text-align: left;
    text-align: left;
    margin-inline: 0;
  }

  .quick-add-modal__content .product-details product-price {
    display: grid;
    gap: 8px;
    margin: 0 !important;
    padding: 0 !important;
    color: var(--quick-add-accent);
  }

  .quick-add-modal__content .product-details .price__regular,
  .quick-add-modal__content .product-details .price__sale {
    font-size: clamp(1.55rem, 1.9vw, 1.8rem);
    line-height: 1.08;
    font-weight: 700;
  }

  .quick-add-modal__content .product-details .price__sale-layout {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .quick-add-modal__content .product-details .compare-at-price {
    color: #a59183;
  }

  .quick-add-modal__content .product-details .price-sale-badge {
    min-height: 1.65rem;
    border-radius: 4px;
    padding: 0.22rem 0.62rem;
    background: #fff0e9;
    color: var(--quick-add-accent-hover);
    font-size: 0.74rem;
  }

  .quick-add-modal__content .product-details .price-callouts {
    display: grid !important;
    gap: 0.32rem;
    width: 100%;
    margin: 4px 0 0;
    padding: 12px 0 2px;
    border-top: 1px solid rgba(92, 61, 42, 0.12);
    color: var(--quick-add-text);
  }

  .quick-add-modal__content .product-details .price-callouts :is(
      .price-discount-tier,
      .product-delivery-estimate,
      .product-delivery-estimate__country-button,
      .product-delivery-estimate__country-static,
      .product-delivery-estimate__shipping-line,
      .exclusive-fomo__trigger,
      .price-policy-note
    ) {
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .quick-add-modal__content .product-details .price-callouts :is(
      .price-discount-tier__icon,
      .product-delivery-estimate__icon,
      .exclusive-fomo__icon,
      .price-policy-note__icon
    ) {
    width: 1.1rem;
    height: 1.1rem;
    flex-basis: 1.1rem;
    margin-inline-end: 0.38rem;
  }

  .quick-add-modal__content .product-details .price-callouts .discount-auto-note {
    font-size: 0.75rem;
  }

  .quick-add-modal__content .product-details .price-callouts :is(
      .product-delivery-estimate__country-button,
      .product-delivery-estimate__shipping-line,
      .exclusive-fomo__trigger
    ) {
    cursor: default;
    pointer-events: none;
  }

  .quick-add-modal__content .product-details .price-callouts :is(
      .product-delivery-estimate__country-caret,
      .product-delivery-estimate__caret,
      .exclusive-fomo__caret,
      .product-delivery-estimate__localization-panel,
      .product-delivery-estimate__popover,
      .exclusive-fomo__panel
    ) {
    display: none !important;
  }

  .quick-add-modal__content .product-details .variant-picker {
    margin: 0 !important;
    padding-top: 8px !important;
    border-top: 0;
  }

  .quick-add-modal__content .product-details .variant-option {
    margin-bottom: 14px;
  }

  .quick-add-modal__content .product-details .variant-option:last-child {
    margin-bottom: 0;
  }

  .quick-add-modal__content .product-details .variant-option > legend,
  .quick-add-modal__content .product-details .variant-option legend {
    margin-bottom: 8px;
