{% doc %}
  Renders homepage-only scripts and config needed by homepage sections/features.
{% enddoc %}

<script
  data-homepage-module
  data-src="{{ 'collection-discovery.js' | asset_url }}"
  data-observe-selector="[data-collection-discovery]"
  type="module"
  fetchpriority="low"
></script>
<script id="new-arrivals-embla" data-src="{{ 'embla-carousel.umd.js' | asset_url }}"></script>
<script
  data-homepage-module
  data-src="{{ 'new-arrivals-line-carousel.js' | asset_url }}"
  data-observe-selector="[data-new-arrivals-line-section]"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'homepage-section-loader.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script id="homepage-quick-add-config" type="application/json">
  {% render 'homepage-quick-add-config' %}
</script>
<script
  src="{{ 'homepage-quick-add.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
