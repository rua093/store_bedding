{%- liquid
  assign free_shipping_context = context | default: 'drawer'
  assign free_shipping_threshold = 10000
  assign amount_remaining = free_shipping_threshold | minus: cart.total_price

  if amount_remaining < 0
    assign amount_remaining = 0
  endif

  assign progress_value = cart.total_price | times: 100.0 | divided_by: free_shipping_threshold
  if progress_value > 100
    assign progress_value = 100
  endif

  if settings.currency_code_enabled_cart_total
    assign amount_remaining_money = amount_remaining | money_with_currency
    assign threshold_money = free_shipping_threshold | money_with_currency
  else
    assign amount_remaining_money = amount_remaining | money
    assign threshold_money = free_shipping_threshold | money
  endif
-%}

<div
  class="cart-drawer-free-shipping cart-drawer-free-shipping--{{ free_shipping_context }}"
  data-free-shipping-progress
>
  <div class="cart-drawer-free-shipping__copy">
    {%- if amount_remaining > 0 -%}
      <p class="cart-drawer-free-shipping__message">
        Free shipping at <strong>{{ threshold_money }}</strong> · add <strong>{{ amount_remaining_money }}</strong> more.
      </p>
    {%- else -%}
      <p class="cart-drawer-free-shipping__message cart-drawer-free-shipping__message--success">
        Free shipping unlocked on this order.
      </p>
    {%- endif -%}
  </div>

  <div
    class="cart-drawer-free-shipping__bar"
    role="progressbar"
    aria-label="Free shipping progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="{{ progress_value | round }}"
  >
    <span
      class="cart-drawer-free-shipping__progress"
      style="width: {{ progress_value }}%;"
    ></span>
  </div>
</div>

{% stylesheet %}
  .cart-drawer-free-shipping {
    display: grid;
    gap: 0.28rem;
  }

  .cart-drawer-free-shipping__copy {
    min-width: 0;
  }

  .cart-drawer-free-shipping__message {
    margin: 0;
    color: #5f4c40;
    font-size: 0.88rem;
    line-height: 1.24;
  }

  .cart-drawer-free-shipping__message strong {
    color: #b55f3d;
    font-weight: 700;
  }

  .cart-drawer-free-shipping__message--success {
    color: #446b57;
    font-weight: 600;
  }

  .cart-drawer-free-shipping__bar {
    position: relative;
    width: 100%;
    height: 0.48rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: rgb(222 210 199 / 0.7);
  }

  .cart-drawer-free-shipping__progress {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #d97d4f 0%, #f0a44f 100%);
    transition: width 220ms ease;
  }

  .cart-drawer-free-shipping__meta {
    display: block;
    color: #8a7466;
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .cart-drawer-free-shipping--drawer {
    padding: 0.5rem 1.25rem 0.56rem;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    background: linear-gradient(180deg, rgb(255 251 245 / 0.98), rgb(255 248 239 / 0.94));
  }

  .cart-drawer-free-shipping--page {
    width: 100%;
    max-width: 100%;
    padding: 1rem 1.125rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 14px;
    background: linear-gradient(180deg, rgb(255 251 245 / 0.98), rgb(255 248 239 / 0.94));
  }

  @media screen and (max-width: 749px) {
    .cart-drawer-free-shipping--drawer {
      gap: 0.28rem;
      padding: 0.48rem 1rem 0.54rem;
    }

    .cart-drawer-free-shipping--page {
      gap: 0.32rem;
      padding: 0.875rem 1rem;
    }
  }
{% endstylesheet %}
