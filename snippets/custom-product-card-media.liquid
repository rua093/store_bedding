{% doc %}
  Renders the media area for the custom product card.

  @param {product} product
  @param {string} featured_image_classes
  @param {string} hover_image_classes
  @param {string} placeholder_svg_classes
  @param {string} contextual_placeholder_class
  @param {boolean} hover_image_enabled
  @param {string} card_image_widths
  @param {string} card_image_sizes
  @param {string} card_hover_image_sizes
  @param {boolean} show_sale_badge
  @param {string} contextual_badge_class
  @param {number} discount_percent
  @param {boolean} should_render_quick_add
  @param {string} product_card_section_id
{% enddoc %}

{% if product.featured_media != blank %}
  {{
    product.featured_media
    | image_url: width: 640
    | image_tag:
      class: featured_image_classes,
      widths: card_image_widths,
      sizes: card_image_sizes,
      loading: 'lazy',
      fetchpriority: 'low',
      decoding: 'async',
      alt: product.featured_media.alt | default: product.title
  }}
  {% if hover_image_enabled and product.media.size > 1 %}
    {{
      product.media[1]
      | image_url: width: 640
      | image_tag:
        class: hover_image_classes,
        widths: card_image_widths,
        sizes: card_hover_image_sizes,
        loading: 'lazy',
        fetchpriority: 'low',
        decoding: 'async',
        alt: product.media[1].alt | default: product.title
    }}
  {% endif %}
{% else %}
  <div class="custom-product-card__placeholder{% if contextual_placeholder_class != blank %} {{ contextual_placeholder_class }}{% endif %}" aria-hidden="true">
    {{ 'product-apparel-1' | placeholder_svg_tag: placeholder_svg_classes }}
  </div>
{% endif %}

{% if custom_tag_label != blank %}
  <span class="custom-product-card__tag-badge custom-product-card__tag-badge--{{ custom_tag_type }}{% if contextual_badge_class != blank %} {{ contextual_badge_class }}--tag{% endif %}">
    <svg class="custom-product-card__tag-bg" viewBox="0 0 100 27" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="tagBgGrad-{{ product.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#E52E2E" />
          <stop offset="100%" stop-color="#B71C1C" />
        </linearGradient>
      </defs>
      <path d="M 11 2 H 95 A 3.5 3.5 0 0 1 98.5 5.5 V 21.5 A 3.5 3.5 0 0 1 95 25 H 11 A 2.5 2.5 0 0 1 9.2 24.1 L 2.8 14.8 A 2.2 2.2 0 0 1 2.8 12.2 L 9.2 2.9 A 2.5 2.5 0 0 1 11 2 Z" fill="url(#tagBgGrad-{{ product.id }})" />
      <path d="M 12.5 4.5 H 93.5 A 2 2 0 0 1 95.5 6.5 V 20.5 A 2 2 0 0 1 93.5 22.5 H 12.5 A 1.5 1.5 0 0 1 11.2 21.8 L 5.2 14.2 A 1.2 1.2 0 0 1 5.2 12.8 L 11.2 5.2 A 1.5 1.5 0 0 1 12.5 4.5 Z" fill="none" stroke="#FFFFFF" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" opacity="0.85" />
    </svg>

    <span class="custom-product-card__tag-body">
      {% if custom_tag_type == 'bestseller' %}
        <svg class="custom-product-card__tag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 23c-4.97 0-9-3.58-9-8 0-4.19 3.23-7.6 7.15-8.45.47-.1.85.34.73.8-.76 2.87.5 4.65 2.12 4.65 1.5 0 2.5-1.5 2.5-3 0-1.85-1.2-3.45-1.2-3.45a.75.75 0 0 1 .84-1.14C17.5 5.5 21 9.5 21 15c0 4.42-4.03 8-9 8z"/>
        </svg>
      {% elsif custom_tag_type == 'new' %}
        <svg class="custom-product-card__tag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
        </svg>
      {% elsif custom_tag_type == 'hot' %}
        <svg class="custom-product-card__tag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M13 2L3 14h7v8l10-12h-7L13 2z"/>
        </svg>
      {% else %}
        <svg class="custom-product-card__tag-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      {% endif %}
      <span class="custom-product-card__tag-text">{{ custom_tag_label }}</span>
    </span>
  </span>
{% endif %}

{% if show_sale_badge %}
  <span class="custom-product-card__badge custom-product-card__badge--sale{% if contextual_badge_class != blank %} {{ contextual_badge_class }} {{ contextual_badge_class }}--sale{% endif %}">
    -{{ discount_percent }}%
  </span>
{% endif %}

{% if should_render_quick_add %}
  {% render 'quick-add', product: product, section_id: product_card_section_id %}
{% endif %}
