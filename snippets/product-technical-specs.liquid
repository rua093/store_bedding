</div>

<script>
  (() => {
    const initTechSpecsTabs = () => {
      document.querySelectorAll('[data-tech-specs-root]').forEach((root) => {
        if (root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';

        const tabButtons = root.querySelectorAll('[data-tech-tab]');
        const tabPanels = root.querySelectorAll('[data-tech-panel]');

        const switchTab = (tabName) => {
          if (!tabName) return;
          const normalized = tabName.toLowerCase().replace(/\s+/g, '-');

          let matchedKey = null;
          if (normalized.includes('duvet')) matchedKey = 'duvet-cover';
          else if (normalized.includes('quilt')) matchedKey = 'quilt';
          else if (normalized.includes('comforter')) matchedKey = 'comforter';
          else matchedKey = normalized;

          tabButtons.forEach((btn) => {
            const isActive = btn.dataset.techTab === matchedKey;
            btn.classList.toggle('is-active', isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          tabPanels.forEach((panel) => {
            const isActive = panel.dataset.techPanel === matchedKey;
            panel.classList.toggle('is-active', isActive);
          });
        };

        tabButtons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            switchTab(btn.dataset.techTab);
          });
        });

        // Auto-sync tab when Bedding Type variant is clicked
        const handleVariantChange = (event) => {
          const target = event.target;
          if (!target) return;

          const optionName = (target.dataset?.optionName || target.name || '').toLowerCase();
          if (optionName.includes('bedding') || optionName.includes('type')) {
            const selectedVal = (target.value || '').toLowerCase();
            switchTab(selectedVal);
          }
        };

        document.addEventListener('change', handleVariantChange);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTechSpecsTabs);
    } else {
      initTechSpecsTabs();
    }

    document.addEventListener('shopify:section:load', initTechSpecsTabs);
  })();
</script>
