{% comment %}
  Renders Product / ProductGroup JSON-LD structured data.
  Implements Google Merchant Listings requirements:
  - Product description propagated to both parent entity and all variant entities
  - hasMerchantReturnPolicy (7-day claim/return window for US & CA matching Jeminise policy)
  - shippingDetails (Free standard shipping for US & CA matching Jeminise policy)
  - Preserves aggregateRating if review metafields exist
{% endcomment %}

{% liquid
  if product == blank
    assign product = closest.product
  endif
%}

{% if product != blank %}
  {% liquid
    assign product_desc = product.description | strip_html | strip
    if product_desc == blank
      assign product_desc = product.title | append: ' - Custom bedding from Jeminise'
    endif

    assign shop_origin = request.origin | default: shop.url
    assign product_url = shop_origin | append: product.url
    assign product_brand = product.vendor | default: shop.name
    assign product_category = product.type | default: 'Bedding'
    assign currency_code = cart.currency.iso_code | default: shop.currency | default: 'USD'
    assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

    assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0

    assign is_variant_group = false
    if product.variants.size > 1
      assign is_variant_group = true
    endif

    assign main_image = product.featured_image
    assign main_image_url = ''
    if main_image != blank
      assign raw_main = main_image | image_url: width: 1920
      if raw_main contains 'https:' or raw_main contains 'http:'
        assign main_image_url = raw_main
      elsif raw_main contains '//'
        assign main_image_url = 'https:' | append: raw_main
      else
        assign main_image_url = shop_origin | append: raw_main
      endif
    endif
  %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      {% if is_variant_group %}
        "@type": "ProductGroup",
        "@id": {{ product_url | append: '#product' | json }},
        "productGroupID": {{ product.id | json }},
        "name": {{ product.title | json }},
        "description": {{ product_desc | json }},
        "url": {{ product_url | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product_brand | json }}
        },
        "category": {{ product_category | json }},
        {% if product.options.size > 0 and product.has_only_default_variant == false %}
          "variesBy": [
            {% for opt in product.options %}
              {{ opt | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
        {% endif %}
        {% if rating_val != blank and rating_count > 0 %}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating_val | json }},
            "reviewCount": {{ rating_count | json }}
          },
        {% endif %}
        "hasVariant": [
          {% for variant in product.variants %}
            {% liquid
              assign variant_url = shop_origin | append: variant.url
              assign variant_image = variant.image | default: product.featured_image
              assign variant_image_url = ''
              if variant_image != blank
                assign raw_vimg = variant_image | image_url: width: 1920
                if raw_vimg contains 'https:' or raw_vimg contains 'http:'
                  assign variant_image_url = raw_vimg
                elsif raw_vimg contains '//'
                  assign variant_image_url = 'https:' | append: raw_vimg
                else
                  assign variant_image_url = shop_origin | append: raw_vimg
                endif
              endif

              assign variant_price = variant.price | money_without_currency | remove: ','
              assign variant_name = product.title
              if variant.title != 'Default Title'
                assign variant_name = product.title | append: ' - ' | append: variant.title
              endif
            %}
            {
              "@type": "Product",
              "@id": {{ variant_url | append: '#variant' | json }},
              "name": {{ variant_name | json }},
              "description": {{ product_desc | json }},
              "sku": {{ variant.sku | default: variant.id | json }},
              {% if variant.barcode != blank %}
                "gtin": {{ variant.barcode | json }},
              {% endif %}
              {% if variant_image_url != blank %}
                "image": {{ variant_image_url | json }},
              {% endif %}
              "offers": {
                "@type": "Offer",
                "@id": {{ variant_url | append: '#offer' | json }},
                "price": {{ variant_price | json }},
                "priceCurrency": {{ currency_code | json }},
                "priceValidUntil": {{ price_valid_until | json }},
                "availability": "{% if variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
                "url": {{ variant_url | json }},
                "hasMerchantReturnPolicy": [
                  {
                    "@type": "MerchantReturnPolicy",
                    "applicableCountry": "US",
                    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                    "merchantReturnDays": 7,
                    "returnMethod": "https://schema.org/ReturnByMail",
                    "returnFees": "https://schema.org/FreeReturn"
                  },
                  {
                    "@type": "MerchantReturnPolicy",
                    "applicableCountry": "CA",
                    "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
                    "merchantReturnDays": 7,
                    "returnMethod": "https://schema.org/ReturnByMail",
                    "returnFees": "https://schema.org/FreeReturn"
                  }
                ],
                "shippingDetails": [
                  {
                    "@type": "OfferShippingDetails",
                    "shippingRate": {
                      "@type": "MonetaryAmount",
                      "value": "0.00",
                      "currency": "USD"
                    },
                    "shippingDestination": {
                      "@type": "DefinedRegion",
                      "addressCountry": "US"
                    },
                    "deliveryTime": {
                      "@type": "ShippingDeliveryTime",
                      "handlingTime": {
                        "@type": "QuantitativeValue",
                        "minValue": 1,
                        "maxValue": 3,
                        "unitCode": "d"
                      },
                      "transitTime": {
                        "@type": "QuantitativeValue",
                        "minValue": 7,
                        "maxValue": 14,
                        "unitCode": "d"
                      }
                    }
                  },
                  {
                    "@type": "OfferShippingDetails",
                    "shippingRate": {
                      "@type": "MonetaryAmount",
                      "value": "0.00",
                      "currency": "USD"
                    },
                    "shippingDestination": {
                      "@type": "DefinedRegion",
                      "addressCountry": "CA"
                    },
                    "deliveryTime": {
                      "@type": "ShippingDeliveryTime",
                      "handlingTime": {
                        "@type": "QuantitativeValue",
                        "minValue": 1,
                        "maxValue": 3,
                        "unitCode": "d"
                      },
                      "transitTime": {
                        "@type": "QuantitativeValue",
                        "minValue": 7,
                        "maxValue": 14,
                        "unitCode": "d"
                      }
                    }
                  }
                ]
              }
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      {% else %}
        {% liquid
          assign default_variant = product.selected_or_first_available_variant
          assign variant_price = default_variant.price | default: product.price | money_without_currency | remove: ','
        %}
        "@type": "Product",
        "@id": {{ product_url | append: '#product' | json }},
        "name": {{ product.title | json }},
        "description": {{ product_desc | json }},
        "url": {{ product_url | json }},
        "brand": {
          "@type": "Brand",
          "name": {{ product_brand | json }}
        },
        "category": {{ product_category | json }},
        "sku": {{ default_variant.sku | default: product.id | json }},
        {% if default_variant.barcode != blank %}
          "gtin": {{ default_variant.barcode | json }},
        {% endif %}
        {% if main_image_url != blank %}
          "image": {{ main_image_url | json }},
        {% endif %}
        {% if rating_val != blank and rating_count > 0 %}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ rating_val | json }},
            "reviewCount": {{ rating_count | json }}
          },
        {% endif %}
        "offers": {
          "@type": "Offer",
          "@id": {{ product_url | append: '#offer' | json }},
          "price": {{ variant_price | json }},
          "priceCurrency": {{ currency_code | json }},
          "priceValidUntil": {{ price_valid_until | json }},
          "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "url": {{ product_url | json }},
          "hasMerchantReturnPolicy": [
            {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": "US",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 7,
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            },
            {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": "CA",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 7,
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            }
          ],
          "shippingDetails": [
            {
              "@type": "OfferShippingDetails",
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": "0.00",
                "currency": "USD"
              },
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": "US"
              },
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 1,
                  "maxValue": 3,
                  "unitCode": "d"
                },
                "transitTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 7,
                  "maxValue": 14,
                  "unitCode": "d"
                }
              }
            },
            {
              "@type": "OfferShippingDetails",
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": "0.00",
                "currency": "USD"
              },
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": "CA"
              },
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 1,
                  "maxValue": 3,
                  "unitCode": "d"
                },
                "transitTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 7,
                  "maxValue": 14,
                  "unitCode": "d"
                }
              }
            }
          ]
        }
      {% endif %}
    }
  </script>
{% endif %}
