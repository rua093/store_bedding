{%- liquid
  assign resolved_section_id = section_id | default: 'main-product'
  assign delivery_country_form_id = 'pdp-delivery-' | append: product.id | append: '-' | append: resolved_section_id
  assign delivery_country_panel_id = 'pdp-delivery-panel-' | append: product.id | append: '-' | append: resolved_section_id
  assign show_delivery_country_selector = false
  if localization.available_countries.size > 1
    assign show_delivery_country_selector = true
  endif
-%}

<div
  class="product-delivery-estimate"

<div
  class="product-delivery-estimate"
  data-delivery-estimate
  data-country-code="{{ localization.country.iso_code }}"
  aria-label="Estimated delivery"
>
  {%- if show_delivery_country_selector -%}
    <dropdown-localization-component class="product-delivery-estimate__localization">
      <button
        type="button"
        class="product-delivery-estimate__country-button"
        aria-expanded="false"
        aria-controls="{{ delivery_country_panel_id }}"
        ref="button"
        on:click="/toggleSelector"
      >
        <span
          class="product-delivery-estimate__flag"
          style="background-image: url({{- localization.country | image_url: width: 32 }});"
          aria-hidden="true"
        ></span>
        <span class="product-delivery-estimate__country-label">Deliver to:</span>
        <span class="product-delivery-estimate__country-name">{{ localization.country.name }}</span>
        <span class="product-delivery-estimate__country-caret" aria-hidden="true">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        id="{{ delivery_country_panel_id }}"
        class="product-delivery-estimate__localization-panel color-custom-popover"
        hidden
        ref="panel"
      >
        {% render 'localization-form',
          show_country: true,
          show_language: false,
          localization_style: 'dropdown',
          form_id: delivery_country_form_id,
          back: request.path
        %}
      </div>
    </dropdown-localization-component>
  {%- else -%}
    <div class="product-delivery-estimate__country-static">
      <span
        class="product-delivery-estimate__flag"
        style="background-image: url({{- localization.country | image_url: width: 32 }});"
        aria-hidden="true"
      ></span>
      <span class="product-delivery-estimate__country-label">Deliver to:</span>
      <span class="product-delivery-estimate__country-name">{{ localization.country.name }}</span>
    </div>
  {%- endif -%}

  <div class="product-delivery-estimate__shipping-popover">
    <button
      type="button"
      class="product-delivery-estimate__shipping-line button-unstyled"
      aria-label="View delivery timeline"
    >
      <span class="product-delivery-estimate__icon" aria-hidden="true">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 16H9m10 0h2v-3.6a1 1 0 0 0-.2-.6l-1.8-2.4a1 1 0 0 0-.8-.4H14" />
          <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h8A1.5 1.5 0 0 1 14 6.5V17H3z" />
          <circle cx="7.5" cy="17.5" r="1.5" />
          <circle cx="17.5" cy="17.5" r="1.5" />
        </svg>
      </span>

      <span class="product-delivery-estimate__copy">
        <span class="product-delivery-estimate__label">Estimated delivery:</span>
        <strong class="product-delivery-estimate__range" data-delivery-date-range></strong>
      </span>
    </button>

    <div
      class="product-delivery-estimate__popover color-custom-popover"
      role="dialog"
      aria-label="Shipping timeline"
    >
      <div
        class="product-support-shipping-journey product-delivery-estimate__journey"
        data-delivery-timeline
        data-country-code="{{ localization.country.iso_code }}"
        aria-label="Shipping timeline"
      >
        <div class="product-support-shipping-journey__track" aria-hidden="true"></div>

        <div class="product-support-shipping-journey__step product-support-shipping-journey__step--order">
          <span class="product-support-shipping-journey__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-6.5-4.2-8.8-8.5C1.8 9.5 3.2 5.6 7 4.5c2-.6 3.9.1 5 1.6 1.1-1.5 3-2.2 5-1.6 3.8 1.1 5.2 5 3.8 8-2.3 4.3-8.8 8.5-8.8 8.5Z"></path>
            </svg>
          </span>
          <div class="product-support-shipping-journey__date" data-delivery-stage-order-date></div>
          <p class="product-support-shipping-journey__heading">Order placed</p>
        </div>

        <div class="product-support-shipping-journey__step product-support-shipping-journey__step--ship">
          <span class="product-support-shipping-journey__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h8A1.5 1.5 0 0 1 14 7.5V17H3z"></path>
              <path d="M14 10h3.6a1 1 0 0 1 .8.4l1.8 2.4a1 1 0 0 1 .2.6V17H14"></path>
              <circle cx="7.5" cy="17.5" r="1.5"></circle>
              <circle cx="17.5" cy="17.5" r="1.5"></circle>
            </svg>
          </span>
          <div class="product-support-shipping-journey__date" data-delivery-stage-ship-range></div>
          <p class="product-support-shipping-journey__heading">Order ships</p>
        </div>

        <div class="product-support-shipping-journey__step product-support-shipping-journey__step--deliver">
          <span class="product-support-shipping-journey__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="7" width="16" height="13" rx="1.5"></rect>
              <path d="M12 7v13"></path>
              <path d="M8 7V5.8A1.8 1.8 0 0 1 9.8 4h4.4A1.8 1.8 0 0 1 16 5.8V7"></path>
              <path d="M4 11.5h16"></path>
            </svg>
          </span>
          <div class="product-support-shipping-journey__date" data-delivery-stage-delivery-range></div>
          <p class="product-support-shipping-journey__heading">Delivered!</p>
        </div>
      </div>

      {% if section.settings.shipping_details != blank %}
        <div class="product-delivery-estimate__popover-details rte">
          <ul class="product-delivery-estimate__popover-list">
            <li>Orders can be cancelled or modified within 2 hours after being placed.</li>
            <li>Refund or free replacement requests must be submitted within 30 days of delivery for damaged, defective, incorrectly customized, or missing items.</li>
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  .product-delivery-estimate {
    display: grid;
    gap: 0.38rem;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    container-type: inline-size;
    color: #000000;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .product-delivery-estimate__localization {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  .product-delivery-estimate__country-button,
  .product-delivery-estimate__country-static {
    display: inline-flex;
    align-items: center;
    gap: 0;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: #000000;
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.4;
    text-align: left;
  }

  .product-delivery-estimate__country-button {
    cursor: pointer;
  }

  .product-delivery-estimate__country-label,
  .product-delivery-estimate__label {
    font-weight: 400;
    margin-inline-end: 0.3rem;
  }

  .product-delivery-estimate__country-name {
    font-weight: 600;
  }

  .product-delivery-estimate__flag {
    width: 1.25rem;
    height: 0.88rem;
    border-radius: 2px;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    display: inline-block;
    flex-shrink: 0;
    margin-inline-end: 0.4rem;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .product-delivery-estimate__country-caret {
    display: inline-flex;
    width: 0.85rem;
    height: 0.85rem;
    color: #000000;
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .product-delivery-estimate__country-caret :is(svg, img) {
    width: 100%;
    height: 100%;
  }

  .product-delivery-estimate__country-button[aria-expanded='true'] .product-delivery-estimate__country-caret {
    transform: rotate(180deg);
  }

  .product-delivery-estimate__localization-panel {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    z-index: 25;
    width: min(24rem, calc(100vw - 2rem));
    min-width: 18rem;
    border: 1px solid rgba(104, 79, 61, 0.12);
    border-radius: 16px;
    background: #fffdfb;
    box-shadow: 0 18px 42px rgba(62, 51, 45, 0.12);
    overflow: hidden;
  }

  .product-delivery-estimate__localization-panel localization-form-component {
    width: 100%;
  }

  .product-delivery-estimate__localization-panel .country-selector-form__wrapper {
    max-height: min(24rem, 60vh);
  }

  .product-delivery-estimate__shipping-line {
    display: inline-flex;
    align-items: center;
    gap: 0;
    width: fit-content;
    max-width: 100%;
    flex-wrap: wrap;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
  }

  .product-delivery-estimate__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 0.88rem;
    flex: 0 0 1.25rem;
    margin-inline-end: 0.4rem;
    color: #000000;
  }

  .product-delivery-estimate__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-delivery-estimate__copy {
    min-width: 0;
    max-width: 100%;
  }

  .product-delivery-estimate__range {
    color: #000000;
    font-weight: 700;
    white-space: normal;
  }

  .product-delivery-estimate__shipping-popover {
    display: grid;
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .product-delivery-estimate__popover {
    position: static;
    z-index: 30;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    margin-top: 0.65rem;
    padding: 1.1rem 1.1rem 1rem;
    border: var(--style-border-popover);
    border-radius: 1.35rem;
    box-shadow: var(--shadow-popover);
    background: #fffdfb;
    color: #4f4238;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    align-items: start;
    gap: 0.9rem;
    overflow: hidden;
    display: none;
  }

  .product-delivery-estimate__shipping-popover:is(:hover, :focus-within) .product-delivery-estimate__popover {
    display: grid;
  }

  .product-delivery-estimate__journey {
    min-width: 0;
    width: 100%;
  }

  .product-delivery-estimate__popover-details {
    color: #5d5046;
    font-size: 0.82rem;
    line-height: 1.4;
    text-align: left;
    width: 100%;
    max-width: none;
    min-width: 0;
    inline-size: 100%;
  }

  .product-delivery-estimate__popover-details :is(p, ul, ol) {
    margin: 0;
  }

  .product-delivery-estimate__popover-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.38rem;
    padding-left: 0;
    margin: 0;
    width: 100%;
    max-width: none;
    min-width: 0;
    inline-size: 100%;
    list-style: none;
  }

  .product-delivery-estimate__popover-list li {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    gap: 0.42rem;
    text-align: left;
    max-width: none;
    min-width: 0;
    width: 100%;
    inline-size: 100%;
    white-space: normal;
    text-wrap: wrap;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .product-delivery-estimate__popover-list li::before {
    content: '★';
    color: #6e5646;
    font-size: 0.58rem;
    line-height: 1.4;
    transform: translateY(0.08em);
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.55rem;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__track {
    display: none;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    justify-items: start;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__badge {
    grid-column: 1;
    width: 2.25rem;
    height: 2.25rem;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__badge svg {
    width: 1.22rem;
    height: 1.22rem;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__date {
    grid-column: 2;
    font-size: 0.76rem;
    line-height: 1.2;
    font-weight: 680;
    white-space: nowrap;
    min-width: 0;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__heading {
    grid-column: 3;
    font-size: 0.78rem;
    line-height: 1.24;
    font-weight: 430;
    min-width: 0;
  }

  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step--ship,
  .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step--deliver {
    text-align: left;
    justify-items: start;
  }

  @container (min-width: 34rem) {
    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__track {
      display: block;
      position: absolute;
      top: 1.65rem;
      left: 2.35rem;
      right: 2.35rem;
      height: 3px;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 0.42rem;
      text-align: center;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__badge,
    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__date,
    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__heading {
      grid-column: auto;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__badge {
      width: 3.3rem;
      height: 3.3rem;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__date {
      white-space: normal;
    }

    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step--ship,
    .product-delivery-estimate .product-delivery-estimate__popover .product-support-shipping-journey__step--deliver {
      text-align: center;
      justify-items: center;
    }
  }

  @media screen and (max-width: 749px) {
    .product-delivery-estimate__localization-panel {
      min-width: 0;
      width: min(24rem, calc(100vw - 2.5rem));
    }

    .product-delivery-estimate__popover {
      padding: 1rem 0.95rem;
      border-radius: 1.1rem;
    }
  }
{% endstyle %}
