{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
  capture visible_item_count
    render 'cart-visible-item-count'
  endcapture
  assign visible_item_count = visible_item_count | strip | plus: 0
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <div class="cart-drawer__empty-state">
        <span
          class="cart-drawer__empty-icon"
          aria-hidden="true"
        >
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>

        <h2
          class="theme-drawer__title h4 cart-drawer__empty-title"
          id="cart-drawer-heading"
        >
          {{ 'content.your_cart_is_empty' | t }}
        </h2>

        <p class="cart-drawer__empty-subtitle">
          Personalized blankets, quilts, and comforters are waiting for you.
        </p>

        <div class="cart-drawer__items">
          {% render 'cart-products', force_empty: true, context: 'drawer' %}
        </div>
      </div>
    </div>
    {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            <div class="theme-drawer__header cart-drawer__header">
              <div class="cart-drawer__header-main">
                <h2
                  class="theme-drawer__title h4 cart-drawer__title"
                  id="cart-drawer-heading"
                >
                  <span class="cart-drawer__title-text cart-drawer__title-text--desktop">Your cart</span>
                  <span class="cart-drawer__title-text cart-drawer__title-text--mobile">Cart</span>
                  <span class="cart-drawer__inline-count">
                    {{ visible_item_count }}
                    {% if visible_item_count == 1 %}
                      item
                    {% else %}
                      items
                    {% endif %}
                  </span>
                </h2>
              </div>

              <button
                class="theme-drawer__close-button cart-drawer__close-button"
                on:click="#cart-drawer/close"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section', context: 'drawer' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --cart-drawer-panel-border: rgb(var(--color-foreground-rgb) / 0.08);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  #cart-drawer .theme-drawer__dialog {
    width: min(31rem, 92vw);
    overflow: hidden;
    background:
      radial-gradient(circle at top center, rgb(252 248 242 / 0.98), transparent 36%),
      linear-gradient(180deg, rgb(var(--color-background-rgb) / 1), rgb(var(--color-background-rgb) / 0.96));
    border-inline-start: 1px solid var(--cart-drawer-panel-border);
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    flex: 1 1 auto;
    height: auto;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    padding: 0;
    background: linear-gradient(180deg, rgb(var(--color-background-rgb) / 1), rgb(var(--color-background-rgb) / 0.96));
    overflow: hidden;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding: 0.45rem var(--cart-drawer-padding) 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    min-width: 0;
    min-height: 0;
    gap: 0.6rem;
  }

  .cart-drawer__items .cart-items__table-row {
    padding: 0.82rem;
    border: 1px solid var(--cart-drawer-panel-border);
    border-radius: 22px;
    background: linear-gradient(180deg, rgb(255 252 247 / 0.94), rgb(255 250 244 / 0.98));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.72),
      0 10px 28px rgb(62 51 45 / 0.05);
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: 1px solid var(--cart-drawer-panel-border);
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    padding-block-end: 0.82rem;
    margin-block-end: 0;
  }

  .cart-drawer__header {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.7rem;
    padding: 0.85rem 1.25rem 0.55rem;
    background: linear-gradient(180deg, rgb(var(--color-background-rgb) / 1), rgb(var(--color-background-rgb) / 0.92));
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    backdrop-filter: blur(10px);
  }

  .cart-drawer__header-main {
    display: grid;
    min-width: 0;
  }

  .cart-drawer__title {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    color: #3e2f28;
    font-size: clamp(1.28rem, 1.7vw, 1.42rem);
    line-height: 1.08;
  }

  .cart-drawer__title-text--mobile {
    display: none;
  }

  .cart-drawer__inline-count {
    color: #7c6859;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .cart-drawer__inline-count::before {
    content: '\00B7';
    margin-inline-end: 0.35rem;
  }

  .cart-drawer__close-button {
    flex: 0 0 auto;
    width: 2.6rem;
    height: 2.6rem;
    min-width: 2.6rem;
    min-height: 2.6rem;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: 0.95rem 1.25rem 1.05rem;

    flex-shrink: 0;
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.6rem;
    padding: var(--cart-drawer-summary-padding);
    margin-top: 0;
    background: linear-gradient(180deg, rgb(var(--color-background-rgb) / 0.92), rgb(var(--color-background-rgb) / 1) 24%);
    border-top: 1px solid var(--cart-drawer-panel-border);
    box-shadow: 0 -10px 22px rgb(62 51 45 / 0.05);
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: sticky;
    bottom: 0;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: 0.45rem;
    line-height: 1.2;
    min-height: 44px;
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    overflow-y: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  .cart-drawer__empty-state {
    width: 100%;
    max-width: 22rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    transform: translateY(-2vh);
  }

  .cart-drawer__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0.7rem;
    border-radius: 999px;
    color: #7a6252;
    background: rgb(255 249 242 / 0.92);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.8),
      0 10px 24px rgb(62 51 45 / 0.06);
  }

  .cart-drawer__empty-icon .svg-wrapper,
  .cart-drawer__empty-icon svg {
    width: 100%;
    height: 100%;
  }

  .cart-drawer__empty-title {
    margin: 0;
    color: #3e2f28;
    line-height: 1.08;
  }

  .cart-drawer__empty-subtitle {
    margin: 0;
    color: #8b7464;
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .cart-items__wrapper--drawer-empty .cart-items__empty-button {
    width: min(100%, 16.5rem);
    margin-top: 0.35rem;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (max-width: 749px) {
    #cart-drawer .theme-drawer__dialog {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
      border-radius: 0;
    }

    .cart-drawer__header {
      padding: 0.78rem 1rem 0.48rem;
    }

    .cart-drawer__title {
      gap: 0.32rem;
      font-size: 1.18rem;
    }

    .cart-drawer__title-text--desktop {
      display: none;
    }

    .cart-drawer__title-text--mobile {
      display: inline;
    }

    .cart-drawer__inline-count {
      font-size: 0.82rem;
    }

    .cart-drawer__close-button {
      width: 2.5rem;
      height: 2.5rem;
      min-width: 2.5rem;
      min-height: 2.5rem;
    }

    .cart-drawer__items {
      padding: 0.38rem 1rem 0.72rem;
      gap: 0.42rem;
    }

    .cart-drawer__items .cart-items__table-row {
      padding: 0.64rem;
      border-radius: 16px;
    }

    .cart-drawer__items .cart-items__table-row:last-child {
      padding-block-end: 0.64rem;
    }

    .cart-drawer__summary {
      --cart-drawer-summary-padding: 0.78rem 1rem 0.88rem;
      padding-bottom: max(0.88rem, calc(0.88rem + env(safe-area-inset-bottom)));
      gap: 0.55rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}
