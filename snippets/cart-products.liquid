<script>
  (() => {
    const initializeCustomizationPropertyToggles = () => {
      document.querySelectorAll('[data-cart-properties-wrapper]').forEach((wrapper) => {
        if (wrapper.dataset.initialized === 'true') return;
        wrapper.dataset.initialized = 'true';
        wrapper.classList.remove('is-expanded');
        wrapper.querySelectorAll('.cart-items__property.is-collapsed').forEach((item) => {
          item.hidden = true;
        });
        const button = wrapper.querySelector('[data-cart-properties-toggle]');
        if (button) button.setAttribute('aria-expanded', 'false');
      });
    };

    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-cart-properties-toggle]');
      if (!button) return;
      const wrapper = button.closest('[data-cart-properties-wrapper]');
      if (!wrapper) return;
      const expanded = wrapper.classList.toggle('is-expanded');
      wrapper.querySelectorAll('.cart-items__property.is-collapsed').forEach((item) => {
        item.hidden = !expanded;
      });
      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    });

    initializeCustomizationPropertyToggles();
    new MutationObserver(initializeCustomizationPropertyToggles).observe(document.body, { childList: true, subtree: true });
  })();
</script>
