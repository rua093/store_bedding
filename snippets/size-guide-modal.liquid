{%- doc -%}
  Renders a PDP-only size guide trigger and modal for supported product types.

  @param {object} product_resource - The product object.
  @param {object} section - The current section object.
  @param {string} size_guide_type - Supported values: blanket, quilt, comforter.
  @param {string} [mode] - Optional render mode: trigger, dialog, or all.
{%- enddoc -%}

{%- liquid
  assign product_resource = product_resource | default: empty
  assign section = section | default: empty
  assign size_guide_type = size_guide_type | default: blank | downcase | strip
  assign mode = mode | default: 'all'
  assign guide_image = blank
  assign guide_image_alt = blank
  assign supported_guide = true

  case size_guide_type
    when 'blanket'
      assign guide_image = 'size-guide-blanket.webp'
      assign guide_image_alt = 'Blanket size guide'
    when 'quilt'
      assign guide_image = 'size-guide-quilt.webp'
      assign guide_image_alt = 'Quilt size guide'
    when 'comforter'
      assign guide_image = 'size-guide-comforter.webp'
      assign guide_image_alt = 'Comforter size guide'
    else
      assign supported_guide = false
  endcase

  assign unique_id = product_resource.id | append: '-' | append: section.id
  assign dialog_component_id = 'SizeGuideDialog-' | append: unique_id
  assign dialog_id = 'SizeGuideModal-' | append: unique_id
  assign heading_id = 'SizeGuideHeading-' | append: unique_id
  assign description_id = 'SizeGuideDescription-' | append: unique_id
-%}
{%- if product_resource != empty and section != empty and size_guide_type != blank and supported_guide -%}
  {%- assign render_trigger = true -%}
  {%- assign render_dialog = true -%}
  {%- if mode == 'trigger' -%}
    {%- assign render_dialog = false -%}
  {%- elsif mode == 'dialog' -%}
    {%- assign render_trigger = false -%}
  {%- endif -%}

  {%- if render_trigger -%}
    {% style %}
      .size-guide-trigger {
        font-size: 0.82rem !important;
        font-weight: 300 !important;
        color: #999999 !important;
        text-decoration: underline !important;
        text-decoration-color: #AAAAAA !important;
        text-decoration-thickness: 1px !important;
        text-underline-offset: 3px !important;
        border: none !important;
        border-bottom: none !important;
        background: transparent !important;
        box-shadow: none !important;
        cursor: pointer !important;
        opacity: 0.85 !important;
        transition: opacity 0.15s ease, color 0.15s ease !important;
        display: inline-block !important;
      }
      .size-guide-trigger:hover {
        opacity: 1 !important;
        color: #444444 !important;
        text-decoration-color: #444444 !important;
      }
    {% endstyle %}
    <span
      class="size-guide-trigger"
      role="button"
      tabindex="0"
      aria-haspopup="dialog"
      aria-controls="{{ dialog_id }}"
      on:click="#{{ dialog_component_id }}/showDialog"
      style="font-size: 13px !important; font-weight: 300 !important; color: #888888 !important; text-decoration: underline !important; text-decoration-color: #bbbbbb !important; text-decoration-thickness: 1px !important; text-underline-offset: 3px !important; border: none !important; border-bottom: none !important; background: transparent !important; box-shadow: none !important; -webkit-font-smoothing: antialiased !important;"
    >
      Size Chart
    </span>
  {%- endif -%}

  {%- if render_dialog -%}
    {% style %}
      .size-guide-dialog {
        display: contents;
      }

      .size-guide-modal {
        position: fixed !important;
        inset: 0 !important;
        margin: auto !important;
        width: min(90vw, 32rem) !important;
        height: fit-content !important;
        max-height: min(84dvh, 600px) !important;
        padding: 0 !important;
        border: 1px solid rgba(92, 61, 42, 0.14) !important;
        border-radius: 24px !important;
        background: linear-gradient(180deg, #fffdf9 0%, #faf5ee 100%) !important;
        color: #3e332d !important;
        box-shadow:
          0 24px 60px rgba(47, 36, 29, 0.22),
          inset 0 1px 0 rgba(255, 255, 255, 0.85) !important;
        overflow: hidden !important;
        isolation: isolate !important;
        outline: none !important;
        z-index: 10001 !important;
        transform: none !important;
        translate: none !important;
      }

      .size-guide-modal::backdrop {
        background: rgba(30, 20, 15, 0.52);
        backdrop-filter: blur(8px) saturate(120%);
        -webkit-backdrop-filter: blur(8px) saturate(120%);
        opacity: 0;
        transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .size-guide-modal[open]::backdrop {
        opacity: 1;
      }

      .size-guide-modal.dialog-closing::backdrop {
        opacity: 0;
      }

      .size-guide-modal[open] {
        animation: sizeGuideModalIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .size-guide-modal.dialog-closing {
        animation: sizeGuideModalOut 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes sizeGuideModalIn {
        from {
          opacity: 0;
          transform: scale(0.92);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @keyframes sizeGuideModalOut {
        from {
          opacity: 1;
          transform: scale(1);
        }
        to {
          opacity: 0;
          transform: scale(0.95);
        }
      }

      .size-guide-modal__close {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 10;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(92, 61, 42, 0.07);
        border: 1px solid rgba(92, 61, 42, 0.1);
        color: #5c3d2a;
        cursor: pointer;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }

      .size-guide-modal__close:hover {
        background: rgba(92, 61, 42, 0.14);
        transform: scale(1.08);
      }

      .size-guide-modal__close svg {
        width: 14px;
        height: 14px;
      }

      .size-guide-modal__content {
        display: flex;
        flex-direction: column;
        max-height: inherit;
        padding: 1.25rem 1.4rem 1.75rem;
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
      }

      @media screen and (max-width: 749px) {
        .size-guide-modal__content {
          padding: 1.15rem 1.15rem 1.4rem;
        }
      }

      .size-guide-modal__heading {
        margin: 0;
        padding-right: 2.2rem;
        color: #3a2a20;
        font-family: var(--font-heading--family, inherit);
        font-size: clamp(1.2rem, 1.4vw, 1.45rem);
        font-weight: 600;
        line-height: 1.25;
      }

      .size-guide-modal__helper {
        margin: 0.25rem 0 0;
        color: #7a6556;
        font-size: 0.9rem;
        line-height: 1.45;
      }

      .size-guide-modal__image-wrap {
        margin-top: 1.1rem;
        width: 100%;
      }

      .size-guide-modal__image {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(92, 61, 42, 0.08);
        box-shadow: 0 10px 24px rgba(68, 45, 30, 0.06);
      }
    {% endstyle %}

    <dialog-component
      id="{{ dialog_component_id }}"
      class="size-guide-dialog"
    >
      <dialog
        id="{{ dialog_id }}"
        ref="dialog"
        class="size-guide-modal"
        scroll-lock
        aria-labelledby="{{ heading_id }}"
        aria-describedby="{{ description_id }}"
      >
        <button
          type="button"
          ref="closeButton"
          on:click="/closeDialog"
          class="button button-unstyled close-button size-guide-modal__close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>

        <div class="size-guide-modal__content">
          <h2
            id="{{ heading_id }}"
            class="size-guide-modal__heading h4"
          >
            Size Chart
          </h2>
          <p
            id="{{ description_id }}"
            class="size-guide-modal__helper"
          >
            Choose the size that fits your needs best.
          </p>

          <div class="size-guide-modal__image-wrap">
            <img
              src="{{ guide_image | asset_url }}"
              alt="{{ guide_image_alt }}"
              class="size-guide-modal__image"
              loading="lazy"
            >
          </div>
        </div>
      </dialog>
    </dialog-component>
  {%- endif -%}
{%- endif -%}
