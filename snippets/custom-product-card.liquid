{%- doc -%}
  Lightweight custom product card without card-gallery/slideshow.

  @param {object} product
  @param {string} section_id
  @param {string} [product_view_context]
  @param {boolean} [show_badge]
  @param {string} [card_class]
  @param {string} [image_widths]
  @param {string} [image_sizes]
  @param {string} [hover_image_sizes]
  @param {boolean} [show_hover_image]
  @param {boolean} [enable_quick_add]
{%- enddoc -%}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_card_section_id = section_id | default: 'custom-product-card'
  assign product_card_id = 'custom-product-card-link-' | append: product_card_section_id | append: '-' | append: product.id
  assign current_price = selected_variant.price
  assign compare_price = selected_variant.compare_at_price
  assign max_safe_compare_price = current_price | times: 5
  assign show_compare_price = false
  if compare_price > current_price and compare_price <= max_safe_compare_price
    assign show_compare_price = true
  endif

  assign show_sale_badge = false
  if show_badge and show_compare_price
    assign show_sale_badge = true
  endif

  assign discount_percent = 0
  if show_compare_price and compare_price > current_price and compare_price > 0
    assign discount_percent = compare_price | minus: current_price | times: 100.0 | divided_by: compare_price | round
  endif

  capture quick_add_state
    render 'custom-product-card-quick-add-state', product: product, enable_quick_add: enable_quick_add
  endcapture
  assign quick_add_state_parts = quick_add_state | strip | split: '||'
  assign quick_add_enabled = false
  if quick_add_state_parts[0] == 'true'
    assign quick_add_enabled = true
  endif

  assign has_quick_add = false
  if quick_add_state_parts[1] == 'true'
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if quick_add_state_parts[2] == 'true'
    assign has_mobile_quick_add = true
  endif

  assign should_render_quick_add = false
  if quick_add_state_parts[3] == 'true'
    assign should_render_quick_add = true
  endif

  assign root_card_class = card_class | default: ''
  capture contextual_class_state
    render 'custom-product-card-contextual-classes', card_class: root_card_class
  endcapture
  assign contextual_class_parts = contextual_class_state | strip | split: '||'
  assign contextual_link_class = contextual_class_parts[0]
  assign contextual_card_class = contextual_class_parts[1]
  assign contextual_media_class = contextual_class_parts[2]
  assign contextual_image_class = contextual_class_parts[3]
  assign contextual_hover_image_class = contextual_class_parts[4]
  assign contextual_placeholder_class = contextual_class_parts[5]
  assign contextual_placeholder_svg_class = contextual_class_parts[6]
  assign contextual_badge_class = contextual_class_parts[7]
  assign contextual_content_class = contextual_class_parts[8]
  assign contextual_title_class = contextual_class_parts[9]
  assign contextual_price_row_class = contextual_class_parts[10]
  assign contextual_price_class = contextual_class_parts[11]
  assign contextual_compare_class = contextual_class_parts[12]
  assign featured_image_classes = 'custom-product-card__image'
  assign hover_image_classes = 'custom-product-card__image custom-product-card__image--hover'
  assign placeholder_svg_classes = 'custom-product-card__placeholder-svg'
  assign card_image_widths = image_widths | default: '160, 220, 320, 440, 640'
  assign card_image_sizes = image_sizes | default: '(min-width: 1400px) 300px, (min-width: 990px) 21vw, (min-width: 750px) 30vw, 44vw'
  assign card_hover_image_sizes = hover_image_sizes | default: card_image_sizes
  assign hover_image_enabled = true
  if show_hover_image == false
    assign hover_image_enabled = false
  endif

  if root_card_class != blank
    assign featured_image_classes = featured_image_classes | append: ' ' | append: contextual_image_class
    assign hover_image_classes = hover_image_classes | append: ' ' | append: contextual_image_class | append: ' ' | append: contextual_hover_image_class
    assign placeholder_svg_classes = placeholder_svg_classes | append: ' ' | append: contextual_placeholder_svg_class
  endif

  assign onboarding = false
  if product == blank or product.id == empty
    assign onboarding = true
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count | default: 0
  assign custom_product_rating_count = product.metafields.custom.product_rating_count.value | default: product.metafields.custom.product_rating_count | default: 0
  assign total_rating_count = custom_product_rating_count | plus: rating_count
  assign decimal_rating = 0
  assign decimal_rounded = 0
  assign svg_filled_stars = 0

  if rating != blank
    assign decimal = rating | modulo: 1

    if decimal >= 0.3 and decimal <= 0.7
      assign decimal_rating = 0.5
    elsif decimal > 0.7
      assign decimal_rating = 1
    endif

    assign decimal_rounded = decimal_rating | ceil
    assign svg_filled_stars = rating | floor | plus: decimal_rounded
  endif
%}

<product-card
  class="product-card custom-product-card{% if root_card_class != blank %} {{ root_card_class }}{% endif %}"
  data-product-id="{{ product.id }}"
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
  style="
    --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
    --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
    --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
    --padding-inline-end: 0.35rem;
    --padding-block-end: 0.35rem;
    --border-radius: 18px;
  "
  {%- unless onboarding -%}
    {% # theme-check-disable-next-line UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view', context: product_view_context | escape }}"
  {%- endunless -%}
>
  <a
    id="{{ product_card_id | md5 }}"
    class="custom-product-card__card-link{% if contextual_link_class != blank %} {{ contextual_link_class }}{% endif %}"
    {% unless onboarding %}
      href="{{ selected_variant.url | default: product.url }}"
    {% endunless %}
    ref="productCardLink"
  >
    <span class="visually-hidden">{% render 'product-display-title', product: product %}</span>
  </a>

  <div class="custom-product-card__card{% if contextual_card_class != blank %} {{ contextual_card_class }}{% endif %}">
    <div class="custom-product-card__media{% if contextual_media_class != blank %} {{ contextual_media_class }}{% endif %}">
      {% render 'custom-product-card-media',
        product: product,
        featured_image_classes: featured_image_classes,
        hover_image_classes: hover_image_classes,
        placeholder_svg_classes: placeholder_svg_classes,
        contextual_placeholder_class: contextual_placeholder_class,
        hover_image_enabled: hover_image_enabled,
        card_image_widths: card_image_widths,
        card_image_sizes: card_image_sizes,
        card_hover_image_sizes: card_hover_image_sizes,
        show_sale_badge: show_sale_badge,
        contextual_badge_class: contextual_badge_class,
        discount_percent: discount_percent,
        should_render_quick_add: should_render_quick_add,
        product_card_section_id: product_card_section_id
      %}
    </div>

    {%- capture product_display_title -%}{% render 'product-display-title', product: product %}{%- endcapture -%}
    {% render 'custom-product-card-details',
      product: product,
      product_display_title: product_display_title,
      contextual_content_class: contextual_content_class,
      contextual_title_class: contextual_title_class,
      contextual_price_row_class: contextual_price_row_class,
      contextual_price_class: contextual_price_class,
      contextual_compare_class: contextual_compare_class,
      current_price: current_price,
      compare_price: compare_price,
      show_compare_price: show_compare_price,
      total_rating_count: total_rating_count
    %}
  </div>
</product-card>
