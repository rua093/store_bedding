{%- liquid
  assign personalization_fields = product.metafields.custom.personalization_fields.value
-%}

{%- if personalization_fields != blank -%}
  {%- capture personalizer_fields_markup -%}
    <div class="product-personalizer__controls">
      {%- if personalization_fields != blank -%}
        <div class="product-personalizer__fields">
          {%- for field in personalization_fields -%}
            {%- liquid
              assign field_id = field.field_id.value | default: field.field_id | default: field.id.value | default: field.id
              assign field_label = field.label.value | default: field.label | default: field.name.value | default: field.name
              assign field_type = field.type.value | default: field.type | downcase
              assign field_required = false
              if field.required.value == true or field.required == true
                assign field_required = true
              endif
              assign field_placeholder = field.placeholder.value | default: field.placeholder
              assign field_help_text = field.help_text.value | default: field.help_text
              assign field_max_length = field.max_length.value | default: field.max_length
              assign field_min_length = field.min_length.value | default: field.min_length
              assign field_accept = field.accept.value | default: field.accept
              if field_type == 'image' and field_accept == blank
                assign field_accept = 'image/*'
              endif
              assign field_max_file_size_mb = field.max_file_size_mb.value | default: field.max_file_size_mb
              assign field_default = field.default.value | default: field.default
              assign field_options = field.options.value | default: field.options
              assign field_preview_key = field.preview_key.value | default: field.preview_key
              assign field_property_name = field.property_name.value | default: field.property_name | default: field_label | default: field_id
            -%}

            {%- if field_id != blank and field_label != blank and field_type != blank -%}
              {%- capture field_input_id -%}
                PersonalizerField-{{ section.id }}-{{ field_id }}
              {%- endcapture -%}

              <div
                class="personalizer-field personalizer-field--{{ field_type | handle }}"
                data-personalizer-field
                data-field-id="{{ field_id | escape }}"
                data-field-type="{{ field_type | escape }}"
                data-preview-key="{{ field_preview_key | escape }}"
                data-property-name="{{ field_property_name | escape }}"
                {% if field_required %}
                  data-required="true"
                {% endif %}
                {% if field_max_length != blank %}
                  data-max-length="{{ field_max_length }}"
                {% endif %}
                {% if field_min_length != blank %}
                  data-min-length="{{ field_min_length }}"
                {% endif %}
                {% if field_accept != blank %}
                  data-accept="{{ field_accept | escape }}"
                {% endif %}
                {% if field_max_file_size_mb != blank %}
                  data-max-file-size-mb="{{ field_max_file_size_mb }}"
                {% endif %}
              >
                <div class="personalizer-field__header">
                  <label
                    class="personalizer-field__label"
                    {% unless field_type == 'font' or field_type == 'option' %}
                      for="{{ field_input_id | escape }}"
                    {% endunless %}
                  >
                    {{ field_label | escape }}

                    {%- if field_required -%}
                      <span aria-hidden="true">*</span>
                    {%- endif -%}
                  </label>

                  {%- if field_help_text != blank -%}
                    <p class="personalizer-field__help">
                      {{ field_help_text | escape }}
                    </p>
                  {%- endif -%}
                </div>

                <div class="personalizer-field__control">
                  {%- case field_type -%}
                    {%- when 'text' -%}
                      <input
                        id="{{ field_input_id | escape }}"
                        class="personalizer-field__input"
                        type="text"
                        name="properties[{{ field_property_name | escape }}]"
                        value="{{ field_default | escape }}"
                        placeholder="{{ field_placeholder | escape }}"
                        data-personalizer-input
                        data-input-kind="text"
                        data-field-id="{{ field_id | escape }}"
                        data-preview-key="{{ field_preview_key | escape }}"
                        {% if field_required %}
                          required
                        {% endif %}
                        {% if field_max_length != blank %}
                          maxlength="{{ field_max_length }}"
                        {% endif %}
                        {% if field_min_length != blank %}
                          minlength="{{ field_min_length }}"
                        {% endif %}
                      >

                    {%- when 'textarea' -%}
                      <textarea
                        id="{{ field_input_id | escape }}"
                        class="personalizer-field__input personalizer-field__input--textarea"
                        name="properties[{{ field_property_name | escape }}]"
                        placeholder="{{ field_placeholder | escape }}"
                        rows="4"
                        data-personalizer-input
                        data-input-kind="textarea"
                        data-field-id="{{ field_id | escape }}"
                        data-preview-key="{{ field_preview_key | escape }}"
                        {% if field_required %}
                          required
                        {% endif %}
                        {% if field_max_length != blank %}
                          maxlength="{{ field_max_length }}"
                        {% endif %}
                        {% if field_min_length != blank %}
                          minlength="{{ field_min_length }}"
                        {% endif %}
                      >{{ field_default | escape }}</textarea>

                    {%- when 'image', 'file' -%}
                      <label
                        class="personalizer-upload"
                        for="{{ field_input_id | escape }}"
                      >
                        <span class="personalizer-upload__headline">
                          {%- if field_type == 'image' -%}
                            Upload image
                          {%- else -%}
                            Upload file
                          {%- endif -%}
                        </span>
                        <span class="personalizer-upload__hint">
                          {%- if field_accept != blank -%}
                            Accepted: {{ field_accept | escape }}
                          {%- else -%}
                            Choose a file from your device
                          {%- endif -%}
                        </span>
                        {%- if field_max_file_size_mb != blank -%}
                          <span class="personalizer-upload__meta">
                            Max {{ field_max_file_size_mb }} MB
                          </span>
                        {%- endif -%}
                      </label>

                      <input
                        id="{{ field_input_id | escape }}"
                        class="personalizer-field__input personalizer-field__input--file"
                        type="file"
                        name="properties[{{ field_property_name | escape }}]"
                        data-personalizer-input
                        data-input-kind="{{ field_type | escape }}"
                        data-field-id="{{ field_id | escape }}"
                        data-preview-key="{{ field_preview_key | escape }}"
                        {% if field_accept != blank %}
                          accept="{{ field_accept | escape }}"
                        {% endif %}
                        {% if field_required %}
                          required
                        {% endif %}
                      >

                      <div class="personalizer-upload__details">
                        <span
                          class="personalizer-upload__filename"
                          data-personalizer-file-name
                        >
                          No file selected
                        </span>
                      </div>

                      <div
                        class="personalizer-upload__preview"
                        data-personalizer-upload-preview
                        hidden
                      >
                        <img
                          class="personalizer-upload__preview-image"
                          src=""
                          alt=""
                          data-upload-preview-image
                          hidden
                        >
                      </div>

                    {%- when 'font', 'option' -%}
                      <div
                        class="personalizer-choice-grid"
                        data-selection-kind="radio-field"
                        {% if field_required %}
                          data-required="true"
                        {% endif %}
                      >
                        {%- for option in field_options -%}
                          {%- liquid
                            assign option_label = option.label.value | default: option.label | default: option.value.value | default: option.value
                            assign option_value = option.value.value | default: option.value | default: option_label
                            assign option_css_family = option.css_family.value | default: option.css_family
                            assign option_thumbnail = option.thumbnail.value | default: option.thumbnail
                            assign option_thumbnail_url = option.thumbnail_url.value | default: option.thumbnail_url
                            assign option_layer_image = option.layer_image.value | default: option.layer_image
                            assign option_layer_image_url = option.layer_image_url.value | default: option.layer_image_url
                            assign option_is_default = false
                            if option.is_default.value == true or option.is_default == true
                              assign option_is_default = true
                            endif
                          -%}

                          {%- if option_thumbnail_url == blank and option_thumbnail != blank -%}
                            {%- capture option_thumbnail_url -%}{{ option_thumbnail | image_url: width: 160 }}{%- endcapture -%}
                          {%- endif -%}

                          {%- if option_layer_image_url == blank and option_layer_image != blank -%}
                            {%- capture option_layer_image_url -%}{{ option_layer_image | image_url: width: 1200 }}{%- endcapture -%}
                          {%- endif -%}

                          {%- capture option_input_id -%}
                            {{ field_input_id }}-{{ forloop.index0 }}
                          {%- endcapture -%}

                          <div class="personalizer-choice">
                            <input
                              id="{{ option_input_id | escape }}"
                              class="personalizer-choice__input"
                              type="radio"
                              name="properties[{{ field_property_name | escape }}]"
                              {% if field_type == 'option' %}
                                value="{{ option_label | escape }}"
                              {% else %}
                                value="{{ option_value | escape }}"
                              {% endif %}
                              data-personalizer-input
                              data-input-kind="{{ field_type | escape }}"
                              data-field-id="{{ field_id | escape }}"
                              data-preview-key="{{ field_preview_key | escape }}"
                              data-option-css-family="{{ option_css_family | escape }}"
                              data-option-value="{{ option_value | escape }}"
                              data-option-label="{{ option_label | escape }}"
                              data-layer-image="{{ option_layer_image_url | escape }}"
                              {% if field_required %}
                                required
                              {% endif %}
                              {% if option_is_default or field_default == option_value %}
                                checked
                              {% endif %}
                            >

                            <label
                              class="personalizer-choice__label{% if option_thumbnail_url != blank %} personalizer-choice__label--has-image{% endif %}"
                              for="{{ option_input_id | escape }}"
                              {% if option_css_family != blank and field_type == 'font' %}
                                style="font-family: {{ option_css_family }};"
                              {% endif %}
                            >
                              {%- if option_thumbnail_url != blank -%}
                                <img
                                  class="personalizer-choice__image"
                                  src="{{ option_thumbnail_url }}"
                                  width="80"
                                  height="80"
                                  loading="lazy"
                                  alt="{{ option_label | escape }}"
                                >
                              {%- endif -%}
                              <span class="personalizer-choice__text">
                                {{ option_label | escape }}
                              </span>
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>

                    {%- when 'color' -%}
                      <div class="personalizer-color">
                        <input
                          id="{{ field_input_id | escape }}"
                          class="personalizer-color__input"
                          type="color"
                          name="properties[{{ field_property_name | escape }}]"
                          value="{% if field_default != blank %}{{ field_default | escape }}{% else %}#b87345{% endif %}"
                          data-personalizer-input
                          data-input-kind="color"
                          data-field-id="{{ field_id | escape }}"
                          data-preview-key="{{ field_preview_key | escape }}"
                          {% if field_required %}
                            required
                          {% endif %}
                        >

                        <label
                          class="personalizer-color__swatch"
                          for="{{ field_input_id | escape }}"
                          aria-label="{{ field_label | escape }}"
                        >
                          <span class="personalizer-color__swatch-chip" aria-hidden="true"></span>
                          <span class="personalizer-color__swatch-text">Choose color</span>
                        </label>

                        <span
                          class="personalizer-color__value"
                          data-color-value
                        >
                          {% if field_default != blank %}{{ field_default | escape }}{% else %}#B87345{% endif %}
                        </span>
                      </div>

                    {%- when 'select' -%}
                      <select
                        id="{{ field_input_id | escape }}"
                        class="personalizer-field__input personalizer-field__input--select"
                        name="properties[{{ field_property_name | escape }}]"
                        data-personalizer-input
                        data-input-kind="select"
                        data-field-id="{{ field_id | escape }}"
                        data-preview-key="{{ field_preview_key | escape }}"
                        {% if field_required %}
                          required
                        {% endif %}
                      >
                        {%- unless field_required -%}
                          <option value="">
                            {% if field_placeholder != blank %}
                              {{ field_placeholder | escape }}
                            {% else %}
                              Select an option
                            {% endif %}
                          </option>
                        {%- endunless -%}

                        {%- for option in field_options -%}
                          {%- liquid
                            assign option_label = option.label.value | default: option.label | default: option.value.value | default: option.value
                            assign option_value = option.value.value | default: option.value | default: option_label
                            assign option_is_default = false
                            if option.is_default.value == true or option.is_default == true
                              assign option_is_default = true
                            endif
                          -%}

                          <option
                            value="{{ option_value | escape }}"
                            {% if option_is_default or field_default == option_value %}
                              selected
                            {% endif %}
                          >
                            {{ option_label | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                  {%- endcase -%}
                </div>

                <p
                  class="personalizer-field__error"
                  data-personalizer-error
                  hidden
                ></p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- assign personalizer_modal_id = 'PersonalizerModal-' | append: section.id | append: '-' | append: product.id -%}
  {%- assign personalizer_heading_id = 'PersonalizerHeading-' | append: section.id | append: '-' | append: product.id -%}
  {%- assign personalizer_preview_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
  {%- capture personalizer_preview_markup -%}
    {%- if personalizer_preview_image != blank -%}
      <div class="product-personalizer-popup__preview-card">
        <p class="product-personalizer-popup__preview-label">Live preview</p>
        <div
          class="product-personalizer-popup__preview-stage"
          data-personalizer-preview="{{ product.id }}"
          style="--ratio: {{ personalizer_preview_image.aspect_ratio | default: 1 }};"
        >
          {{
            personalizer_preview_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'product-personalizer-popup__preview-image',
              alt: product.title,
              widths: '480, 720, 960, 1400',
              sizes: '(min-width: 990px) 360px, 100vw'
          }}

          <div
            class="product-media__personalization-dynamic-preview"
            data-personalizer-dynamic-preview
            aria-hidden="true"
          >
            {%- assign option_preview_keys = '|' -%}
            {%- for field in personalization_fields -%}
              {%- liquid
                assign field_type = field.type.value | default: field.type | downcase
                assign preview_key = field.preview_key.value | default: field.preview_key
              -%}

              {%- if preview_key != blank -%}
                {%- case field_type -%}
                  {%- when 'image' -%}
                    <img
                      class="product-media__preview-upload"
                      data-preview-upload="{{ preview_key | escape }}"
                      alt=""
                      width="1200"
                      height="1200"
                      hidden
                    >
                  {%- when 'text', 'textarea' -%}
                    <span
                      class="product-media__preview-text"
                      data-preview-text="{{ preview_key | escape }}"
                      hidden
                    ></span>
                  {%- when 'option' -%}
                    {%- capture option_preview_token -%}|{{ preview_key }}|{%- endcapture -%}
                    {%- unless option_preview_keys contains option_preview_token -%}
                      <img
                        class="product-media__personalization-layer"
                        data-preview-layer="{{ preview_key | escape }}"
                        alt=""
                        width="1200"
                        height="1200"
                        hidden
                      >
                      {%- assign option_preview_keys = option_preview_keys | append: preview_key | append: '|' -%}
                    {%- endunless -%}
                {%- endcase -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  <div
    class="product-personalizer"
    data-product-personalizer
    data-product-id="{{ product.id }}">
    <button
      type="button"
      class="button button-unstyled product-personalizer__trigger"
      data-personalizer-trigger
      aria-haspopup="dialog"
      aria-controls="{{ personalizer_modal_id }}"
    >
      Customize now
    </button>

    <div
      id="{{ personalizer_modal_id }}"
      class="product-personalizer-popup"
      data-personalizer-modal
      hidden
      role="dialog"
      aria-modal="true"
      aria-labelledby="{{ personalizer_heading_id }}"
    >
      <button
        type="button"
        class="product-personalizer-popup__backdrop"
        data-personalizer-close
        tabindex="-1"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      ></button>

      <div class="product-personalizer-popup__panel" data-personalizer-panel>
        <div class="product-personalizer-popup__inner">
          <div class="product-personalizer-popup__header">
            <div>
              <p class="product-personalizer-popup__eyebrow">Personalization</p>
              <h2
                id="{{ personalizer_heading_id }}"
                class="product-personalizer-popup__heading"
              >
                Customize your order
              </h2>
            </div>
            <button
              type="button"
              class="button button-unstyled close-button product-personalizer-popup__close"
              data-personalizer-close
              aria-label="{{ 'accessibility.close_dialog' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>

          <div class="product-personalizer-popup__body">
            {{ personalizer_preview_markup }}
            <div class="product-personalizer-popup__form">
              {{ personalizer_fields_markup }}
            </div>
          </div>

          <div
            class="product-personalizer__errors"
            data-personalizer-errors
            hidden
          ></div>

          <div class="product-personalizer-popup__footer">
            <button
              type="button"
              class="button product-personalizer-popup__done"
              data-personalizer-close
            >
              Done
            </button>
          </div>
        </div>
      </div>
    </div>

    <input
      type="hidden"
      name="properties[_personalization_id]"
      value=""
      data-personalization-id-input
    >

    <input
      type="hidden"
      name="properties[_personalization_json]"
      value=""
      data-personalization-json-input
    >

    <div
      class="product-personalizer__summary"
      data-personalization-properties
      hidden
      aria-hidden="true"
    ></div>
  </div>

  {% style %}
    .product-personalizer__trigger {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      padding: 0;
      color: #000;
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
      cursor: pointer;
    }

    .product-personalizer-popup {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: grid;
      place-items: center;
      padding: 0.75rem;
      box-sizing: border-box;
      isolation: isolate;
    }

    .product-personalizer-popup[hidden] {
      display: none;
    }

    .product-personalizer-popup__backdrop {
      appearance: none;
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: rgba(53, 37, 27, 0.38) !important;
      box-shadow: none;
      opacity: 1;
      pointer-events: auto;
      cursor: default;
    }

    .product-personalizer-popup__backdrop:hover,
    .product-personalizer-popup__backdrop:focus,
    .product-personalizer-popup__backdrop:active {
      background: rgba(53, 37, 27, 0.38) !important;
      opacity: 1;
      outline: none;
    }

    .product-personalizer-popup[open] {
      display: grid;
    }

    .product-personalizer-popup__panel {
      position: relative;
      z-index: 1;
      width: min(68rem, calc(100vw - 1.5rem));
      max-height: min(88dvh, calc(100dvh - 1.5rem));
      border: 1px solid rgba(92, 61, 42, 0.14);
      border-radius: 24px;
      background: linear-gradient(180deg, #fffdfb 0%, #fbf5ed 100%);
      box-shadow:
        0 28px 60px rgba(47, 36, 29, 0.18),
        inset 0 1px 0 rgba(255, 255, 255, 0.78);
      overflow: hidden;
      box-sizing: border-box;
    }

    .product-personalizer-popup__inner {
      display: grid;
      gap: 1rem;
      max-height: inherit;
      padding: 1.2rem;
      overflow: auto;
      box-sizing: border-box;
    }

    .product-personalizer-popup__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding-right: 3.25rem;
    }

    .product-personalizer-popup__eyebrow {
      margin: 0 0 0.2rem;
      color: #7b6657;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-personalizer-popup__heading {
      margin: 0;
      color: #000;
      font-size: clamp(1.25rem, 2vw, 1.6rem);
      line-height: 1.08;
    }

    .product-personalizer-popup__close {
      position: absolute;
      top: 0.95rem;
      right: 0.95rem;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: 1px solid rgba(92, 61, 42, 0.14);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.94);
      color: #000;
      box-shadow: 0 8px 18px rgba(47, 36, 29, 0.12);
    }

    .product-personalizer-popup__close:hover,
    .product-personalizer-popup__close:focus-visible {
      background: #ffffff;
      color: #000;
    }

    .product-personalizer-popup__close svg {
      width: 1rem;
      height: 1rem;
      color: currentColor;
    }

    .product-personalizer-popup__body {
      display: grid;
      grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.25fr);
      gap: 1.15rem;
      align-items: start;
    }

    .product-personalizer-popup__body > * {
      min-width: 0;
    }

    .product-personalizer-popup__preview-card {
      position: sticky;
      top: 0;
      display: grid;
      gap: 0.75rem;
      padding: 0.85rem;
      border: 1px solid rgba(92, 61, 42, 0.12);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.82),
        0 14px 26px rgba(47, 36, 29, 0.06);
    }

    .product-personalizer-popup__preview-label {
      margin: 0;
      color: #000;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .product-personalizer-popup__preview-stage {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: var(--ratio, 1);
      min-height: 0;
      max-height: none;
      border-radius: 18px;
      overflow: hidden;
      background: linear-gradient(180deg, #fffdf9 0%, #f6efe6 100%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.82),
        0 12px 24px rgba(47, 36, 29, 0.08);
    }

    .product-personalizer-popup__preview-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      background: #f6efe6;
    }

    .product-personalizer-popup__preview-stage .product-media__personalization-dynamic-preview {
      position: absolute;
      inset: 0;
      z-index: 2;
      overflow: hidden;
      border-radius: inherit;
      pointer-events: none;
    }

    .product-personalizer-popup__form {
      display: grid;
      gap: 1rem;
      align-content: start;
    }

    .product-personalizer-popup .personalizer-field__control {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .product-personalizer-popup .personalizer-upload {
      display: grid;
      width: 100%;
      min-width: 0;
      min-height: 0;
      box-sizing: border-box;
    }

    .product-personalizer-popup .personalizer-color {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      align-items: center;
      gap: 0.75rem;
      width: fit-content;
      max-width: 100%;
    }

    .product-personalizer-popup .personalizer-color__swatch {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      position: relative;
      width: auto;
      height: auto;
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow:
