      display: inline-block;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 999px;
      border: 1px solid rgba(120, 84, 58, 0.18);
      background: var(--personalizer-color, #b87345);
      box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.9);
      flex: 0 0 auto;
