{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by the product-information section and quick-add/product rendering flows.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  assign is_main_product_page = false
  if request.page_type == 'product'
    assign is_main_product_page = true
  endif

  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product.media.size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns and is_main_product_page == false
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

%}

{% liquid
  if settings.background_color != blank
    render 'contrast-override', background_color: settings.background_color, section_id: section_id
  endif
%}

<div
  class="section-background{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>
<div
  class="product-information section section--{{ content_width }} spacing-style{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %} relative{% if is_main_product_page %} product-information--main-product{% endif %}"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div class="product-information__shell">
    <product-component
      class="{{ product_grid_class }}"
      data-product-grid-content
      {% # theme-check-disable UnknownFilter %}
      view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
      {% # theme-check-enable UnknownFilter %}
    >
      {% assign render_order_array = render_order | split: ',' %}
      {% capture media %}
        <div
          class="product-information__media"
          data-testid="product-information-media"
        >
          {{ media_gallery }}
        </div>
      {% endcapture %}

      {% for block in render_order_array %}
        {% if block == 'media' and product_has_media %}
          {{ media }}
        {% elsif block == 'product-details' %}
          {{ product_details }}
        {% endif %}
      {% endfor %}
    </product-component>
  </div>

  {% if is_main_product_page and product.description != blank %}
    <div class="product-information__details-below" data-product-details-below>
      <details class="product-description-collapsible">
        <summary class="product-description-collapsible__summary">
          <span class="product-description-collapsible__summary-copy">
            <span class="product-description-collapsible__title">Product Details</span>
          </span>
          <span class="product-description-collapsible__icon" aria-hidden="true">+</span>
        </summary>
        <div class="product-description-collapsible__content">
          <rte-formatter
            class="product-description-rich"
            style="--width: 100%; --max-width: 100%;"
          >
            {{ product.description }}
          </rte-formatter>
        </div>
      </details>
    </div>
  {% endif %}

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  .product-information--main-product {
    --product-surface: #fffaf4;
    --product-surface-alt: #fff9f2;
    --product-border: rgba(92, 61, 42, 0.12);
    --product-shadow: 0 22px 44px rgba(47, 36, 29, 0.08);
    --product-accent-strong: #FC5732;
    max-width: min(1440px, calc(100vw - clamp(24px, 4vw, 48px)));
    margin-inline: auto;
  }

  .product-information--main-product product-price .price,
  .product-information--main-product product-price .price-item--sale.price,
  .product-information--main-product .sticky-add-to-cart__price .price,
  .product-information--main-product .sticky-add-to-cart__price .price-item--sale.price {
    color: var(--product-accent-strong);
  }

  .product-information--main-product,
  .product-information--main-product .product-information__shell,
  .product-information--main-product .product-information__grid,
  .product-information--main-product .product-information__media,
  .product-information--main-product .product-details,
  .product-information--main-product .product-details--main-product,
  .product-information--main-product .product-information__details-below,
  .product-information--main-product .product-information__details-below > * {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
  }

  .product-information--main-product .product-information__media {
    width: 100%;
    min-width: 0;
  }

  .product-information__shell {
    width: 100%;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .product-information__details-below[hidden] {
    display: none;
  }

  .product-information--main-product .product-information__details-below {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    margin-top: clamp(20px, 2.2vw, 30px);
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .product-information--main-product .product-information__details-below::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    background:
      radial-gradient(circle at top right, rgba(255, 246, 237, 0.72), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 251, 247, 0.96) 100%);
    border: 1px solid rgba(120, 84, 58, 0.08);
    box-shadow:
      0 22px 44px rgba(47, 36, 29, 0.06),
      0 8px 18px rgba(184, 115, 69, 0.035);
    z-index: -1;
    pointer-events: none;
  }

  .product-information--main-product .product-information__details-below > :only-child {
    grid-column: 1 / -1;
  }

  .product-information--main-product .product-information__details-below > .product-description-collapsible,
  .product-information--main-product .product-information__details-below > rte-formatter,
  .product-information--main-product .product-information__details-below > .accordion,
  .product-information--main-product .product-information__details-below > .shopify-app-block {
    --width: 100%;
    --max-width: 100%;
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.985) 0%, rgba(255, 252, 249, 0.965) 100%);
    border: 1px solid rgba(120, 84, 58, 0.1);
    border-radius: 18px;
    padding: clamp(18px, 1.8vw, 26px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      0 16px 30px rgba(47, 36, 29, 0.045);
  }

  .product-information--main-product .product-description-collapsible {
    padding: 0;
    overflow: hidden;
  }

  .product-information--main-product .product-description-collapsible__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    cursor: pointer;
    color: #2f241d;
    font-family: var(--font-heading--family);
    font-size: clamp(1.18rem, 4vw, 1.38rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    list-style: none;
  }

  .product-information--main-product .product-description-collapsible__summary-copy {
    display: grid;
    gap: 0.32rem;
    min-width: 0;
  }

  .product-information--main-product .product-description-collapsible__title {
    display: block;
  }

  .product-information--main-product .product-description-collapsible__summary::-webkit-details-marker {
    display: none;
  }

  .product-information--main-product .product-description-collapsible__icon {
    flex: 0 0 auto;
    color: #c46f41;
    font-family: var(--font-body--family);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .product-information--main-product .product-description-collapsible[open] .product-description-collapsible__icon {
    transform: rotate(45deg);
  }

  .product-information--main-product .product-description-collapsible__content {
    padding: 0 1.2rem 1.3rem;
  }

  .product-information--main-product .product-description-collapsible__content > rte-formatter {
    --width: 100%;
    --max-width: 100%;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .product-information--main-product .product-information__details-below > .accordion {
    display: none;
  }

  .product-information--main-product .product-description-rich {
    display: block;
    width: 100%;
    color: #4f3c31;
  }

  .product-information--main-product .product-description-rich__layout {
    display: grid;
    width: 100%;
    gap: 18px;
  }

  .product-information--main-product .product-description-rich__section {
    min-width: 0;
  }

  .product-information--main-product .product-description-rich__section--intro {
    max-width: none;
  }

  .product-information--main-product .product-description-rich__section--intro > p:first-child {
    margin: 0;
    padding: clamp(16px, 1.8vw, 20px) clamp(16px, 1.8vw, 22px);
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 249, 243, 0.9) 0%, rgba(255, 255, 255, 0.86) 100%);
    border: 1px solid rgba(196, 111, 65, 0.09);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    color: #4f3a2e;
    font-size: clamp(1.04rem, 1.2vw, 1.14rem);
    font-weight: 500;
    line-height: 1.8;
  }

  .product-information--main-product .product-description-rich__section--features,
  .product-information--main-product .product-description-rich__section--specs {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 252, 248, 0.95) 100%);
    border: 1px solid rgba(120, 84, 58, 0.1);
    border-radius: 20px;
    padding: clamp(18px, 1.6vw, 22px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 12px 24px rgba(47, 36, 29, 0.04);
  }

  .product-information--main-product .product-description-rich__section--features {
    position: relative;
    overflow: clip;
  }

  .product-information--main-product .product-description-rich__section--features::before,
  .product-information--main-product .product-description-rich__section--specs::before {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    border-radius: 999px;
    margin-bottom: 1rem;
    background: linear-gradient(90deg, #c46f41 0%, rgba(196, 111, 65, 0.18) 100%);
  }

  .product-information--main-product
    .product-description-rich__section
    > :is(h2, h3, h4, h5, h6):first-child {
    margin: 0 0 14px;
    color: #2f241d;
    font-size: clamp(1.32rem, 1.55vw, 1.62rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .product-information--main-product .product-description-rich ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 13px;
  }

  .product-information--main-product .product-description-rich li {
    position: relative;
    margin: 0;
    padding-left: 1.9rem;
    color: #5a473b;
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .product-information--main-product .product-description-rich li::before {
    content: '✦';
    position: absolute;
    top: 0.76rem;
    left: 0.1rem;
    color: #c46f41;
    font-size: 0.8rem;
    line-height: 1;
    transform: translateY(-50%);
  }

  .product-information--main-product .product-description-rich li strong {
    color: #2f241d;
    font-weight: 650;
  }

  .product-information--main-product .product-description-rich .rte-table-wrapper {
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .product-information--main-product .product-description-rich table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .product-information--main-product .product-description-rich tr {
    display: grid;
    grid-template-columns: minmax(9rem, 0.78fr) minmax(0, 1.22fr);
    align-items: stretch;
    gap: 0;
    filter: drop-shadow(0 6px 14px rgba(47, 36, 29, 0.03));
  }

  .product-information--main-product .product-description-rich th,
  .product-information--main-product .product-description-rich td {
    padding: 12px 14px;
    border-bottom: 0;
    vertical-align: top;
    text-align: left;
    line-height: 1.55;
  }

  .product-information--main-product .product-description-rich tr:last-child :is(th, td) {
    border-bottom: 0;
  }

  .product-information--main-product .product-description-rich th {
    width: auto;
    color: #6e5849;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(250, 242, 235, 0.92);
    border: 1px solid rgba(120, 84, 58, 0.08);
    border-right: 0;
    border-radius: 14px 0 0 14px;
  }

  .product-information--main-product .product-description-rich td {
    color: #3f3027;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(120, 84, 58, 0.08);
    border-left: 0;
    border-radius: 0 14px 14px 0;
    word-break: break-word;
  }

  .product-information--main-product .product-information__details-below :is(.shopify-app-block, iframe, video, model-viewer, img, svg, canvas, table, pre) {
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .product-information--main-product .product-information__details-below pre {
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .product-information--main-product .product-description-rich__section--specs > p:last-child {
    margin: 16px 0 0;
    color: #887265;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 1 / -1;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    .product-information--main-product .product-information__shell {
      position: relative;
      border: 1px solid var(--product-border);
      border-radius: 28px;
      background:
        radial-gradient(circle at top left, rgba(255, 241, 225, 0.92), transparent 31%),
        radial-gradient(circle at bottom right, rgba(255, 248, 240, 0.78), transparent 26%),
        linear-gradient(180deg, rgba(255, 254, 251, 0.99) 0%, rgba(255, 250, 244, 0.98) 100%);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.92),
        0 30px 62px rgba(47, 36, 29, 0.1),
        0 12px 24px rgba(184, 115, 69, 0.06);
      padding: clamp(20px, 2vw, 28px);
    }

    .product-information--main-product .product-information__grid:not(.product-information--media-none) {
      align-items: start;
      gap: clamp(28px, 3vw, 42px);
      grid-column: 1 / -1;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .product-information--main-product .product-information__shell {
      padding: 18px;
      overflow: clip;
    }

    .product-information--main-product .product-information__grid:not(.product-information--media-none) {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-information--main-product .product-information__media,
    .product-information--main-product .product-details {
      padding-inline: 0;
      grid-column: 1 / -1;
      order: initial;
    }

    .product-information--main-product .product-information__media,
    .product-information--main-product .product-details--main-product {
      position: static;
      top: auto;
      max-height: none;
      overflow: visible;
      padding-right: 0;
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  @media screen and (min-width: 990px) {
    .product-information--main-product .product-information__grid.product-information--media-left,
    .product-information--main-product .product-information__grid.product-information--media-right {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.92fr);
      grid-column: 1 / -1;
      justify-content: space-between;
    }

    .product-information--main-product .product-information__grid.product-information--media-right {
      grid-template-columns: minmax(22rem, 0.92fr) minmax(0, 1fr);
    }

    .product-information--main-product .product-information__grid.product-information__grid--half .product-information__media,
    .product-information--main-product .product-information__grid.product-information__grid--half .product-details {
      grid-column: auto;
    }

    .product-information--main-product .product-information__media,
    .product-information--main-product .product-details {
      padding-inline: 0 !important;
    }

    .product-information--main-product .product-information__media {
      width: 100%;
      min-width: 0;
      position: sticky;
      top: calc(var(--header-height, 80px) + 24px);
      align-self: start;
    }

