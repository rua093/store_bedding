{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by the product-information section and quick-add/product rendering flows.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  assign is_main_product_page = false
  if request.page_type == 'product'
    assign is_main_product_page = true
  endif

  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product.media.size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns and is_main_product_page == false
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

%}

{% liquid
  if settings.background_color != blank
    render 'contrast-override', background_color: settings.background_color, section_id: section_id
  endif
%}

{% if is_main_product_page %}
  <style id="pdp-buy-buttons-responsive-override">
    @media screen and (min-width: 750px) and (max-width: 800px) {
      .product-information--main-product .product-information__grid.product-information--media-left,
      .product-information--main-product .product-information__grid.product-information--media-right,
      .product-information--main-product .product-information__grid:not(.product-information--media-none) {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) !important;
        grid-column: 1 / -1 !important;
        gap: 16px !important;
      }

      .product-information--main-product .product-information__media,
      .product-information--main-product .product-details,
      .product-information--main-product .product-details--main-product {
        grid-column: 1 / -1 !important;
        width: 100% !important;
        min-width: 0 !important;
        position: static !important;
        top: auto !important;
        max-height: none !important;
        overflow: visible !important;
        align-self: auto !important;
        order: initial !important;
        padding-inline: 0 !important;
        padding-right: 0 !important;
      }
    }

    @media screen and (min-width: 801px) and (max-width: 989px) {
      .product-information--main-product .product-information__shell {
        padding: 18px !important;
        overflow: clip !important;
      }

      .product-information--main-product .product-information__grid.product-information--media-left,
      .product-information--main-product .product-information__grid.product-information--media-right,
      .product-information--main-product .product-information__grid:not(.product-information--media-none) {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.86fr) !important;
        grid-column: 1 / -1 !important;
        gap: clamp(14px, 2vw, 22px) !important;
        align-items: start !important;
      }

      .product-information--main-product .product-information__grid.product-information--media-right {
        grid-template-columns: minmax(280px, 0.86fr) minmax(0, 1fr) !important;
      }

      .product-information--main-product .product-information__media,
      .product-information--main-product .product-details,
      .product-information--main-product .product-details--main-product {
        grid-column: auto !important;
        width: 100% !important;
        min-width: 0 !important;
        max-height: none !important;
        overflow: visible !important;
        align-self: start !important;
        order: initial !important;
        padding-inline: 0 !important;
        padding-right: 0 !important;
      }

      .product-information--main-product .product-information__media {
        position: sticky !important;
        top: calc(var(--header-height, 80px) + 16px) !important;
      }

      .product-information--main-product .product-information__media media-gallery.spacing-style {
        padding-block-start: 0 !important;
        padding-block-end: 0 !important;
      }

      .product-information--main-product .product-details,
      .product-information--main-product .product-details--main-product {
        position: static !important;
        top: auto !important;
      }
    }

    @media screen and (min-width: 900px) and (max-width: 989px) {
      .product-information--main-product .product-form-trust-badges__note {
        display: flex !important;
        position: static !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 0.5rem !important;
        text-align: center !important;
        padding-inline: 1rem !important;
        font-size: 0.9rem !important;
        line-height: 1.35 !important;
      }

      .product-information--main-product .product-form-trust-badges__note-icon {
        position: static !important;
        transform: none !important;
        flex: 0 0 auto !important;
      }

      .product-information--main-product .product-form-trust-badges__note > span:not(.product-form-trust-badges__note-icon) {
        display: inline !important;
        flex: 0 1 auto !important;
        max-width: 22rem !important;
        margin-inline: 0 !important;
        text-wrap: balance !important;
      }
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) {
      display: grid !important;
      grid-template-columns: minmax(116px, 124px) minmax(0, 1fr) !important;
      column-gap: 12px !important;
      row-gap: 12px !important;
      align-items: stretch !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize)::before {
      display: block !important;
      grid-column: 1 / -1 !important;
      margin: 0 0 8px !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .quantity-selector-wrapper {
      display: block !important;
      grid-column: 1 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: none !important;
      margin: 0 !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .quantity-selector-wrapper::before {
      display: none !important;
      content: none !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .quantity-selector-wrapper .quantity-selector {
      width: 100% !important;
      --quantity-selector-width: 124px !important;
      min-width: 0 !important;
      max-width: none !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .product-form-customize {
      grid-column: 2 !important;
      width: 100% !important;
      min-width: 0 !important;
      max-width: none !important;
      margin: 0 !important;
    }

    .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .product-form-customize .product-form-customize__button {
      width: 100% !important;
    }

    @container (max-width: 340px) {
      .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) {
        grid-template-columns: minmax(0, 1fr) !important;
        column-gap: 0 !important;
      }

      .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .quantity-selector-wrapper,
      .product-information--main-product .product-details .buy-buttons-block .product-form-buttons:has(> .product-form-customize) > .product-form-customize {
        grid-column: 1 / -1 !important;
      }
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges {
      width: 100% !important;
      max-width: 100% !important;
      margin-inline: auto !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__items {
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 0 !important;
      justify-items: stretch !important;
      align-items: stretch !important;
      width: 100% !important;
      margin-inline: auto !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badge {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 0.58rem !important;
      width: 100% !important;
      max-width: 100% !important;
      padding-inline: clamp(0.45rem, 1.2vw, 0.75rem) !important;
      text-align: left !important;
      position: relative !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badge:not(:last-child)::after {
      content: '' !important;
      display: block !important;
      position: absolute !important;
      top: 0.18rem !important;
      right: 0 !important;
      width: 1px !important;
      height: calc(100% - 0.36rem) !important;
      background: rgba(184, 115, 69, 0.16) !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badge__icon {
      width: 1.45rem !important;
      height: 1.45rem !important;
      flex: 0 0 auto !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badge__title {
      font-size: clamp(0.76rem, 1.25vw, 0.9rem) !important;
      line-height: 1.12 !important;
      white-space: normal !important;
      text-wrap: balance !important;
    }

    @container (max-width: 420px) {
      .product-information--main-product .product-details--main-product .product-form-trust-badges__items {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 0.55rem 1rem !important;
      }

      .product-information--main-product .product-details--main-product .product-form-trust-badge {
        justify-content: flex-start !important;
        padding-inline: 0 !important;
      }

      .product-information--main-product .product-details--main-product .product-form-trust-badge::after {
        display: none !important;
      }
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__note {
      display: flex !important;
      position: static !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 0.5rem !important;
      width: 100% !important;
      min-height: 2.6rem !important;
      padding: 0.68rem 1rem !important;
      text-align: center !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__note-icon {
      position: static !important;
      width: 0.9rem !important;
      height: 0.9rem !important;
      flex: 0 0 auto !important;
      transform: none !important;
    }

    .product-information--main-product .product-details--main-product .product-form-trust-badges__note > span:not(.product-form-trust-badges__note-icon) {
      display: inline !important;
      flex: 0 1 auto !important;
      max-width: 100% !important;
      margin-inline: 0 !important;
      text-wrap: balance !important;
    }
  </style>
{% endif %}
<div
  class="section-background product-information__background{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>
<div
  class="product-information section section--{{ content_width }} spacing-style{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %} relative{% if is_main_product_page %} product-information--main-product{% endif %}"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if settings.desktop_media_position == 'left' and product_has_media and request.page_type == 'product' %}
    {% assign product_href = '#ProductInformation-' | append: section_id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div class="product-information__shell">
    <product-component
      class="{{ product_grid_class }}"
      data-product-grid-content
      {% # theme-check-disable UnknownFilter %}
      view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
      {% # theme-check-enable UnknownFilter %}
    >
      {% assign render_order_array = render_order | split: ',' %}
      {% capture media %}
        <div
          class="product-information__media"
          data-testid="product-information-media"
        >
          {{ media_gallery }}
        </div>
      {% endcapture %}

      {% for block in render_order_array %}
        {% if block == 'media' and product_has_media %}
          {{ media }}
        {% elsif block == 'product-details' %}
          {{ product_details }}
        {% endif %}
      {% endfor %}
    </product-component>
  </div>

  {% liquid
    assign has_support_accordions = false
    assign show_details_below = false
    if settings.shipping_heading != blank or settings.personalization_heading != blank
      assign has_support_accordions = true
    endif

    if is_main_product_page
      if product.description != blank or has_support_accordions
        assign show_details_below = true
      endif
    endif
  %}

  {% if show_details_below %}
    <div class="product-information__details-below" data-product-details-below>
      {% if product.description != blank %}
        <details class="product-description-collapsible">
          <summary class="product-description-collapsible__summary">
            <span class="product-description-collapsible__summary-copy">
              <span class="product-description-collapsible__icon-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 10v6"></path>
                  <path d="M12 7.5h.01"></path>
                </svg>
              </span>
              <span class="product-description-collapsible__title">Product Details</span>
            </span>
            <span class="product-description-collapsible__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m7 4 6 6-6 6"></path>
              </svg>
            </span>
          </summary>
          <div class="product-description-collapsible__content">
            <rte-formatter
              class="product-description-rich"
              style="--width: 100%; --max-width: 100%;"
            >
              {{ product.description }}
            </rte-formatter>
          </div>
        </details>
      {% endif %}

      {% if has_support_accordions %}
        {% render 'product-support-accordions', settings: settings %}
      {% endif %}
    </div>
  {% endif %}

  {{ additional_blocks }}
</div>

<style>
  .product-information {
    gap: var(--gap) 0;
  }

  .product-information--main-product {
    --product-surface: #fffaf4;
    --product-surface-alt: #fff9f2;
    --product-border: rgba(92, 61, 42, 0.12);
    --product-shadow: 0 22px 44px rgba(47, 36, 29, 0.08);
    --product-accent-strong: #FC5732;
    max-width: min(1440px, calc(100vw - clamp(24px, 4vw, 48px)));
    margin-inline: auto;
  }

  .product-information--main-product product-price .price,
  .product-information--main-product product-price .price-item--sale.price,
  .product-information--main-product .sticky-add-to-cart__price .price,
  .product-information--main-product .sticky-add-to-cart__price .price-item--sale.price {
    color: var(--product-accent-strong);
  }

  .product-information--main-product,
  .product-information--main-product .product-information__shell,
  .product-information--main-product .product-information__grid,
  .product-information--main-product .product-information__media,
  .product-information--main-product .product-details,
  .product-information--main-product .product-details--main-product,
  .product-information--main-product .product-information__details-below,
  .product-information--main-product .product-information__details-below > * {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
  }

  .product-information--main-product .product-information__media {
    width: 100%;
    min-width: 0;
  }

  .product-information__shell {
    width: 100%;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  .product-information__details-below[hidden] {
    display: none;
  }

  .product-information--main-product .product-information__details-below {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin-top: clamp(36px, 4vw, 48px) !important;
    padding-inline: clamp(36px, 6vw, 92px);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(120, 84, 58, 0.16);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 252, 247, 0.97) 0%, rgba(255, 248, 240, 0.95) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.62),
      0 14px 32px rgba(74, 45, 28, 0.08);
  }

  .product-information--main-product .product-information__details-below::before {
    display: none;
  }

  .product-information--main-product .product-information__details-below::after {
    display: none;
  }

  .product-information--main-product .product-information__details-below > :only-child {
    grid-column: 1 / -1;
  }

  .product-information--main-product .product-information__details-below > :last-child {
    border-bottom: 0;
  }

  .product-information--main-product .product-information__details-below > .product-description-collapsible,
  .product-information--main-product .product-information__details-below > rte-formatter,
  .product-information--main-product .product-information__details-below > .accordion,
  .product-information--main-product .product-information__details-below > .product-support-collapsible,
  .product-information--main-product .product-information__details-below > .shopify-app-block {
    --width: 100%;
    --max-width: 100%;
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(120, 84, 58, 0.14);
    border-radius: 0;
    padding: 0;
    box-shadow: none;
  }

  .product-information--main-product .product-description-collapsible {
    padding: 0;
    overflow: visible;
  }

  .product-information--main-product .product-description-collapsible__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: clamp(82px, 7vw, 94px);
    padding: 0.95rem 0.35rem 0.95rem 0;
    cursor: pointer;
    color: #4f5053;
    font-family: var(--font-body--family);
    font-size: clamp(1.08rem, 1.7vw, 1.22rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: normal;
    list-style: none;
  }

  .product-information--main-product .product-description-collapsible__summary-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .product-information--main-product .product-description-collapsible__icon-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: #54504d;
    flex: 0 0 auto;
  }

  .product-information--main-product .product-description-collapsible__icon-mark svg {
    width: 100%;
    height: 100%;
  }

  .product-information--main-product .product-description-collapsible__title {
    display: block;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    color: inherit;
  }

  .product-information--main-product .product-description-collapsible__summary::-webkit-details-marker {
    display: none;
  }

  .product-information--main-product .product-description-collapsible__icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    color: #54504d;
    line-height: 1;
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .product-information--main-product .product-description-collapsible__icon svg {
    width: 100%;
    height: 100%;
  }

  .product-information--main-product .product-description-collapsible[open] .product-description-collapsible__icon {
    transform: rotate(90deg);
  }

  .product-information--main-product .product-support-collapsible[open] .product-support-collapsible__icon {
    transform: rotate(90deg);
  }

  .product-information--main-product .product-description-collapsible__content,
  .product-information--main-product .product-support-collapsible__content {
    max-height: clamp(320px, 50vh, 440px);
    overflow-y: auto;
    overscroll-behavior-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.2rem 2.1rem 1.5rem 2.85rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(196, 111, 65, 0.35) transparent;
  }

  .product-information--main-product .product-description-collapsible__content::-webkit-scrollbar,
  .product-information--main-product .product-support-collapsible__content::-webkit-scrollbar {
    width: 5px;
  }

  .product-information--main-product .product-description-collapsible__content::-webkit-scrollbar-track,
  .product-information--main-product .product-support-collapsible__content::-webkit-scrollbar-track {
    background: transparent;
  }

  .product-information--main-product .product-description-collapsible__content::-webkit-scrollbar-thumb,
  .product-information--main-product .product-support-collapsible__content::-webkit-scrollbar-thumb {
    background: rgba(196, 111, 65, 0.3);
    border-radius: 999px;
  }

  .product-information--main-product .product-description-collapsible__content::-webkit-scrollbar-thumb:hover,
  .product-information--main-product .product-support-collapsible__content::-webkit-scrollbar-thumb:hover {
    background: rgba(196, 111, 65, 0.55);
  }

  .product-information--main-product .product-description-collapsible__content > rte-formatter {
    --width: 100%;
    --max-width: 100%;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .product-information--main-product .product-information__details-below > .accordion {
    display: none;
  }

  .product-information--main-product .product-description-rich {
    display: block;
    width: 100%;
    color: #4f4a46;
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.7;
  }

