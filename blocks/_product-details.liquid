{%- assign block_settings = block.settings -%}
{%- liquid
  assign amazon_customizer_metafield = closest.product.metafields.custom.amazon_customizer
  assign has_amazon_customizer = false

  if amazon_customizer_metafield != blank and amazon_customizer_metafield.value != blank
    assign amazon_customizer_json = amazon_customizer_metafield.value | json

    unless amazon_customizer_json == '{}' or amazon_customizer_json == '[]' or amazon_customizer_json == 'null' or amazon_customizer_json == '""'
      assign has_amazon_customizer = true
    endunless
  endif
-%}
{%- capture product_display_title -%}{% render 'product-display-title', product: closest.product %}{%- endcapture -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if request.page_type == 'product' %} product-details--main-product{% endif %}
    {% if has_amazon_customizer %} product-details--has-amazon-customizer{% endif %}
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  data-has-amazon-customizer="{{ has_amazon_customizer }}"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
      >
        {{- product_display_title | strip -}}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group',
    children: children,
    settings: block_settings,
    shopify_attributes: block.shopify_attributes,
    background_color: block_settings.background_color,
    block_id: block.id
  %}
</div>

<script>
  (() => {
    const desktopDetailsQuery = window.matchMedia('(min-width: 750px)');

    const syncProductDescriptionAccordions = () => {
      document.querySelectorAll('.product-description-collapsible').forEach((accordion) => {
        accordion.open = desktopDetailsQuery.matches;
      });
    };

    const enhanceProductDescriptions = () => {
      document.querySelectorAll('[data-product-details-below] rte-formatter').forEach((description) => {
        if (description.dataset.enhanced === 'true') return;

        const children = Array.from(description.children);
        if (!children.length) return;

        const getHeadingIndex = (matcher) =>
          children.findIndex(
            (node) => /^H[1-6]$/.test(node.tagName) && matcher((node.textContent || '').trim().toLowerCase())
          );

        const featuresIndex = getHeadingIndex((text) => text.includes('key features'));
        const specsIndex = getHeadingIndex((text) => text.includes('product specifications'));

        const introNodes =
          featuresIndex > -1
            ? children.slice(0, featuresIndex)
            : specsIndex > -1
            ? children.slice(0, specsIndex)
            : children;
        const featureNodes =
          featuresIndex > -1 ? children.slice(featuresIndex, specsIndex > -1 ? specsIndex : children.length) : [];
        const specNodes = specsIndex > -1 ? children.slice(specsIndex) : [];

        const layout = document.createElement('div');
        layout.className = 'product-description-rich__layout';

        const createSection = (name, nodes) => {
          if (!nodes.length) return null;
          const section = document.createElement('section');
          section.className = `product-description-rich__section product-description-rich__section--${name}`;
          nodes.forEach((node) => section.appendChild(node));
          return section;
        };

        const introSection = createSection('intro', introNodes);
        const featureSection = createSection('features', featureNodes);
        const specsSection = createSection('specs', specNodes);

        if (introSection) layout.appendChild(introSection);
        if (featureSection) layout.appendChild(featureSection);
        if (specsSection) layout.appendChild(specsSection);

        description.classList.add('product-description-rich');
        description.style.setProperty('--width', '100%');
        description.style.setProperty('--max-width', '9999px');
        description.innerHTML = '';
        description.appendChild(layout);

        if (!description.closest('.product-description-collapsible')) {
          const accordion = document.createElement('details');
          accordion.className = 'product-description-collapsible';
          accordion.open = desktopDetailsQuery.matches;

          const summary = document.createElement('summary');
          summary.className = 'product-description-collapsible__summary';
          summary.innerHTML = `
            <span>Product Details</span>
            <span class="product-description-collapsible__icon" aria-hidden="true">+</span>
          `;

          const content = document.createElement('div');
          content.className = 'product-description-collapsible__content';

          description.parentNode.insertBefore(accordion, description);
          accordion.appendChild(summary);
          accordion.appendChild(content);
          content.appendChild(description);
        }

        description.dataset.enhanced = 'true';
      });
    };

    const hydrateProductDetailsBelow = () => {
      enhanceProductDescriptions();
      syncProductDescriptionAccordions();
    };

    const initCustomizeTriggerProxy = () => {
      const triggerSelectors = [
        '.shopify-app-block .amzcustom-open',
        '[data-amzcustom-root] .amzcustom-open',
        '[id*="jeminise_customizer"] button',
        '[id*="jeminise_customizer"] a',
        '.shopify-app-block [id*="jeminise_customizer"] button',
        '.shopify-app-block [id*="jeminise_customizer"] a',
        '.shopify-app-block button[data-shopify-app-trigger]',
        '.shopify-app-block a[data-shopify-app-trigger]'
      ].join(', ');

      document.querySelectorAll('.product-details--main-product[data-has-amazon-customizer="true"]').forEach((detailsContainer) => {
        const proxyButton = detailsContainer.querySelector('[data-customize-trigger-proxy]');
        if (!proxyButton) return;

        const enableProxy = (originalTrigger) => {
          if (!originalTrigger) return false;

          const href = originalTrigger.getAttribute('href');
          const isUsableLink = originalTrigger.tagName === 'A' && href && href !== '#';
          const isUsableButton = originalTrigger.tagName === 'BUTTON' && !originalTrigger.disabled;

          if (!isUsableLink && !isUsableButton) return false;

          proxyButton.disabled = false;

          if (proxyButton.dataset.customizeProxyBound === 'true') return true;

          proxyButton.addEventListener('click', () => {
            if (isUsableLink) {
              if (originalTrigger.target === '_blank') {
                window.open(originalTrigger.href, '_blank', 'noopener');
                return;
              }

              window.location.href = originalTrigger.href;
              return;
            }

            originalTrigger.click();
          });

          proxyButton.dataset.customizeProxyBound = 'true';
          return true;
        };

        const bindProxy = () => enableProxy(detailsContainer.querySelector(triggerSelectors));

        if (bindProxy()) return;

        let attempts = 0;
        const interval = setInterval(() => {
          attempts++;
          if (bindProxy() || attempts > 75) {
            clearInterval(interval);
          }
        }, 200);

        const observer = new MutationObserver(() => {
          if (bindProxy()) {
            observer.disconnect();
            clearInterval(interval);
          }
        });

        observer.observe(detailsContainer, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['href', 'disabled']
        });

        window.setTimeout(() => observer.disconnect(), 20000);
      });
    };

    const enhanceProductDetailsLayout = () => {
      hydrateProductDetailsBelow();
      initCustomizeTriggerProxy();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceProductDetailsLayout, { once: true });
    } else {
      enhanceProductDetailsLayout();
    }

    document.addEventListener('shopify:section:load', enhanceProductDetailsLayout);
    desktopDetailsQuery.addEventListener('change', syncProductDescriptionAccordions);
  })();
</script>

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
    position: absolute;
  }

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: center;
  }

  .product-details--main-product {
    --product-info-surface: linear-gradient(180deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 250, 244, 0.2) 100%);
    --product-info-border: rgba(120, 84, 58, 0.11);
    --product-info-shadow: none;
    --product-info-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.58);
    --pdp-panel-gap: clamp(10px, 1.1vw, 14px);
    --pdp-inner-gap: 8px;
    --pdp-tight-gap: 6px;
    width: 100%;
  }

  .product-details--main-product > .group-block {
    width: 100%;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    gap: 0;
  }

  .product-details--main-product > .group-block.spacing-style {
    padding-block-start: 0 !important;
    padding-inline-start: 0 !important;
    padding-inline-end: 0 !important;
  }

  .product-details--main-product > .group-block > .group-block__media-wrapper {
    display: none;
  }

  .product-details--main-product > .group-block > .group-block-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    align-content: start;
    gap: var(--pdp-panel-gap);
    width: min(100%, 42rem);
    margin-inline: auto;
    margin-block-start: 0;
    padding-block-start: clamp(14px, 1.35vw, 20px);
    padding-inline: clamp(22px, 2vw, 30px);
    padding-block-end: clamp(20px, 2vw, 28px);
    border: 1px solid rgba(104, 79, 61, 0.12);
    border-radius: clamp(12px, 1.3vw, 16px);
    background: #fffdfb;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 1px 0 rgba(0, 0, 0, 0.02);
    box-sizing: border-box;
  }

  .product-details--main-product > .group-block > .group-block-content > .text-block.h2,
  .product-details--main-product > .group-block > .group-block-content > .rating-wrapper,
  .product-details--main-product > .group-block > .group-block-content > product-price,
  .product-details--main-product > .group-block > .group-block-content > variant-picker,
  .product-details--main-product > .group-block > .group-block-content > .buy-buttons-block {
    width: 100%;
    margin: 0;
    padding-inline: 0;
    background: transparent;
    border-inline: 0;
    box-shadow: none;
