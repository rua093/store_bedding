{% comment %}
  Renders a row of other products in the same collections as the current product.
{% endcomment %}

{% liquid
  assign current_product = closest.product
  if current_product == blank
    assign current_product = product
  endif
%}

{% if current_product != blank %}
  {% comment %} Find the first collection that contains other products {% endcomment %}
  {% assign target_collection = blank %}
  {% for collection in current_product.collections %}
    {% if collection.handle == 'all' or collection.handle == 'frontpage' or collection.handle == 'best-selling' or collection.handle == 'best-sellers' or collection.handle == 'new-arrivals' %}
      {% continue %}
    {% endif %}
    
    {% assign other_products_count = 0 %}
    {% for prod in collection.products %}
      {% if prod.id != current_product.id %}
        {% assign other_products_count = other_products_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    
    {% if other_products_count > 0 %}
      {% assign target_collection = collection %}
      {% break %}
    {% endif %}
  {% endfor %}
  
  {% if target_collection != blank %}
    <div class="choose-other-styles-block" style="padding-block-start: {{ block.settings.padding-block-start }}px; padding-block-end: {{ block.settings.padding-block-end }}px; padding-inline-start: {{ block.settings.padding-inline-start }}px; padding-inline-end: {{ block.settings.padding-inline-end }}px;">
      <span class="other-styles__heading">{{ block.settings.heading | default: 'Choose other styles' }}</span>
      
      <div class="other-styles__products-grid">
        {% assign displayed = 0 %}
        {% for prod in target_collection.products %}
          {% if prod.id == current_product.id %}
            {% continue %}
          {% endif %}
          
          {% if displayed >= 5 %}
            {% break %}
          {% endif %}
          
          {% assign displayed = displayed | plus: 1 %}
          {%- capture product_display_title -%}{% render 'product-display-title', product: prod %}{%- endcapture -%}
          
          <a href="{{ prod.url }}" class="other-styles__product-card" title="{{ product_display_title | strip }}">
            <div class="other-styles__image-wrapper">
              {% if prod.featured_image %}
                <img src="{{ prod.featured_image | image_url: width: 180, height: 180, crop: 'center' }}" 
                     alt="{{ product_display_title | strip }}" 
                     loading="lazy" 
                     width="90" 
                     height="90">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
          </a>
        {% endfor %}
        
        {% comment %} Load more / View all card {% endcomment %}
        {% assign total_other = target_collection.all_products_count | minus: 1 %}
        {% assign remaining = total_other | minus: displayed %}
        
        {% if remaining > 0 %}
          <a href="{{ target_collection.url }}" class="other-styles__load-more-card" title="View all {{ target_collection.title }}">
            <span>+{{ remaining }} more</span>
          </a>
        {% else %}
          <a href="{{ target_collection.url }}" class="other-styles__load-more-card other-styles__load-more-card--view-all" title="View all {{ target_collection.title }}">
            <span>View all</span>
          </a>
        {% endif %}
      </div>
    </div>
    
    <style>
      .choose-other-styles-block {
        display: flex;
        flex-direction: column;
        width: 100%;
        box-sizing: border-box;
      }
      
      .other-styles__heading {
        display: block !important;
        font-size: 0.98rem !important;
        font-weight: 700 !important;
        color: #000000 !important;
        margin: 0 0 8px 0 !important;
        line-height: 1.25 !important;
        letter-spacing: -0.01em !important;
      }
      
      .other-styles__products-grid {
        display: flex;
        gap: 10px;
        align-items: center;
        overflow-x: auto;
        overflow-y: visible;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        padding-inline: 4px;
        margin-top: -6px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
        box-sizing: border-box;
      }
      
      .other-styles__products-grid::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
      
      .other-styles__product-card {
        flex: 0 0 74px;
        width: 74px;
        height: 74px;
        aspect-ratio: 1;
        text-decoration: none;
        border-radius: 6px;
        overflow: hidden;
        border: 1.5px solid rgba(0, 0, 0, 0.12);
        background-color: #FFFFFF;
        transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease;
        box-sizing: border-box;
        will-change: transform;
      }
      
      .other-styles__product-card:hover {
        border-color: #000000;
        transform: translateY(-4px) scale(1.03);
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
        z-index: 2;
      }
      
      .other-styles__image-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .other-styles__image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      
      .other-styles__load-more-card {
        flex: 0 0 74px;
        width: 74px;
        height: 74px;
        aspect-ratio: 1;
        text-decoration: none;
        border-radius: 6px;
        background: linear-gradient(145deg, #FAF7F4 0%, #EFEBE5 100%);
        border: 1.5px solid rgba(0, 0, 0, 0.14);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6px;
        box-sizing: border-box;
        text-align: center;
        transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        will-change: transform;
      }
      
      .other-styles__load-more-card span {
        font-family: inherit !important;
        font-size: 0.82rem !important;
        font-weight: 600 !important;
        color: #000000 !important;
        line-height: 1.25;
        letter-spacing: -0.01em;
        text-transform: none !important;
      }
      
      .other-styles__load-more-card:hover {
        border-color: #000000;
        background: linear-gradient(145deg, #FFFFFF 0%, #F5F0EA 100%);
        transform: translateY(-4px) scale(1.03);
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
        z-index: 2;
      }
      
      @media screen and (max-width: 749px) {
        .other-styles__products-grid {
          gap: 8px;
        }
        .other-styles__product-card,
        .other-styles__load-more-card {
          flex: 0 0 66px;
          width: 66px;
          height: 66px;
          border-width: 1.5px;
        }
        .other-styles__load-more-card span {
          font-size: 0.78rem !important;
        }
      }
    </style>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Choose Other Styles",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose other styles"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Choose Other Styles"
    }
  ]
}
{% endschema %}
